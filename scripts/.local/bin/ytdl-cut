#!/usr/bin/env bash
# ==============================================================================
# YTDL-CUT — Professional CLI Video/Audio Trimming & Merging Tool
# ==============================================================================
# Powered by yt-dlp & ffmpeg | Wayland / Omarchy Optimized
# ==============================================================================

set -euo pipefail

VERSION="1.0.0"

# --- Colors & Styles ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

log_info()    { echo -e "${BLUE}[INFO]${NC}    $1"; }
log_ok()      { echo -e "${GREEN}[OK]${NC}      $1"; }
log_warn()    { echo -e "${YELLOW}[WARN]${NC}    $1"; }
log_error()   { echo -e "${RED}[ERROR]${NC}   $1" >&2; }
log_step()    { echo -e "\n${CYAN}${BOLD}▸ $1${NC}"; }
log_dim()     { echo -e "${DIM}  $1${NC}"; }

# --- Dependencies Check ---
_check_deps() {
  local missing=()
  command -v yt-dlp >/dev/null 2>&1 || missing+=("yt-dlp")
  command -v ffmpeg >/dev/null 2>&1 || missing+=("ffmpeg")

  if (( ${#missing[@]} > 0 )); then
    log_error "Thiếu các công cụ sau: ${missing[*]}"
    log_info "Cài đặt bằng: sudo pacman -S ${missing[*]}"
    exit 1
  fi
}

# --- Show Help ---
show_help() {
  echo -e "${BOLD}ytdl-cut${NC} v${VERSION} — Công cụ tải, cắt và tự động ghép Video/Audio từ URL

${BOLD}CÚ PHÁP:${NC}
  ytdl-cut [TÙY CHỌN] <URL> <ĐOẠN_1> [ĐOẠN_2] [ĐOẠN_3] ...

${BOLD}ĐỊNH DẠNG KHUNG GIỜ (Timecode):${NC}
  MM:SS-MM:SS         Ví dụ: 01:30-04:15
  HH:MM:SS-HH:MM:SS   Ví dụ: 01:05:00-01:10:00
  SS-SS               Ví dụ: 30-90 (từ giây thứ 30 đến giây 90)

${BOLD}TÙY CHỌN:${NC}
  -a, --audio         Chỉ trích xuất âm thanh (Lưu thành file MP3 vào ~/Music)
  -o, --output NAME   Đặt tên file đầu ra (mặc định theo tiêu đề video)
  -d, --dir PATH      Thư mục lưu file (mặc định: ~/Videos hoặc ~/Music)
  --sponsorblock      Tự động cắt bỏ các đoạn quảng cáo tài trợ trong video
  -h, --help          Hiển thị hướng dẫn này
  -v, --version       Hiển thị phiên bản

${BOLD}VÍ DỤ SỬ DỤNG:${NC}
  ${DIM}# 1. Cắt 1 đoạn video duy nhất (từ 01:30 đến 03:00):${NC}
  ytdl-cut \"https://youtube.com/watch?v=...\" 01:30-03:00

  ${DIM}# 2. Cắt nhiều đoạn và TỰ ĐỘNG GHÉP THÀNH 1 VIDEO DUY NHẤT:${NC}
  ytdl-cut \"https://youtube.com/watch?v=...\" 00:30-01:15 03:00-04:00 07:20-08:00

  ${DIM}# 3. Cắt nhiều đoạn nhạc và ghép thành 1 file MP3:${NC}
  ytdl-cut -a \"https://youtube.com/watch?v=...\" 01:00-02:30 05:00-06:15

  ${DIM}# 4. Đặt tên file xuất riêng:${NC}
  ytdl-cut -o \"highlights.mp4\" \"https://youtube.com/watch?v=...\" 02:00-03:00 08:00-09:00"
}

# ==============================================================================
# MAIN LOGIC
# ==============================================================================

AUDIO_MODE=false
CUSTOM_OUTPUT=""
CUSTOM_DIR=""
SPONSORBLOCK=false
URL=""
TIMECODES=()

# Parse Arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      show_help
      exit 0
      ;;
    -v|--version)
      echo "ytdl-cut v${VERSION}"
      exit 0
      ;;
    -a|--audio)
      AUDIO_MODE=true
      shift
      ;;
    -o|--output)
      CUSTOM_OUTPUT="$2"
      shift 2
      ;;
    -d|--dir)
      CUSTOM_DIR="$2"
      shift 2
      ;;
    --sponsorblock)
      SPONSORBLOCK=true
      shift
      ;;
    http*://*|git*://*)
      URL="$1"
      shift
      ;;
    *-*)
      TIMECODES+=("$1")
      shift
      ;;
    *)
      if [[ -z "$URL" ]]; then
        URL="$1"
      else
        TIMECODES+=("$1")
      fi
      shift
      ;;
  esac
done

_check_deps

if [[ -z "$URL" ]]; then
  log_error "Vui lòng cung cấp URL video cần tải/cắt."
  echo ""
  show_help
  exit 1
fi

# Set Output Directory
if [[ -n "$CUSTOM_DIR" ]]; then
  DEST_DIR="$CUSTOM_DIR"
elif [ "$AUDIO_MODE" = true ]; then
  DEST_DIR="${XDG_MUSIC_DIR:-$HOME/Music}"
else
  DEST_DIR="${XDG_VIDEOS_DIR:-$HOME/Videos}"
fi
mkdir -p "$DEST_DIR"

# Temporary Directory
TMP_DIR=$(mktemp -d /tmp/ytdl-cut_XXXXXX)
trap 'rm -rf "$TMP_DIR"' EXIT INT TERM

log_step "Đang lấy thông tin video..."
log_dim "URL: $URL"

# Get Clean Title
TITLE=$(yt-dlp --print "%(title)s" --no-warnings "$URL" 2>/dev/null || echo "video_$(date +%Y%m%d_%H%M%S)")
CLEAN_TITLE=$(echo "$TITLE" | tr -d '/\\:*?"<>|' | sed 's/  */ /g' | head -c 100)

log_ok "Tiêu đề: ${BOLD}$TITLE${NC}"

# ------------------------------------------------------------------------------
# CASE 1: Cắt nhiều đoạn và Tự Động Ghép (Merge)
# ------------------------------------------------------------------------------
if (( ${#TIMECODES[@]} > 1 )); then
  log_step "Chế độ: Cắt ${#TIMECODES[@]} đoạn và TỰ ĐỘNG GHÉP (Merge)..."

  MERGE_LIST="$TMP_DIR/concat_list.txt"
  PART_FILES=()

  idx=1
  for tc in "${TIMECODES[@]}"; do
    log_info "Đang tải đoạn [$idx/${#TIMECODES[@]}]: ${CYAN}$tc${NC}..."
    part_file="$TMP_DIR/part_$(printf '%03d' "$idx").mp4"

    yt_args=(
      --download-sections "*$tc"
      --force-keyframes-at-cuts
      -f "bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]/best"
      --merge-output-format mp4
      -o "$part_file"
      --no-playlist
      --no-warnings
    )

    if [ "$SPONSORBLOCK" = true ]; then
      yt_args+=(--sponsorblock-remove sponsor,selfpromo)
    fi

    yt-dlp "${yt_args[@]}" "$URL" >/dev/null 2>&1

    if [[ -f "$part_file" ]]; then
      echo "file '$part_file'" >> "$MERGE_LIST"
      PART_FILES+=("$part_file")
      log_ok "Đoạn $idx hoàn tất: $tc"
    else
      log_warn "Không thể tải đoạn $tc, bỏ qua."
    fi

    ((idx++))
  done

  if [[ ! -s "$MERGE_LIST" ]]; then
    log_error "Không tải được đoạn nào để ghép!"
    exit 1
  fi

  log_step "Đang ghép các đoạn thành 1 file duy nhất..."

  if [ "$AUDIO_MODE" = true ]; then
    EXT="mp3"
    FINAL_NAME="${CUSTOM_OUTPUT:-${CLEAN_TITLE}_merged.mp3}"
    FINAL_PATH="$DEST_DIR/$FINAL_NAME"

    # Merge and convert to MP3
    ffmpeg -y -f concat -safe 0 -i "$MERGE_LIST" -vn -c:a libmp3lame -q:a 0 "$FINAL_PATH" -loglevel error
  else
    EXT="mp4"
    FINAL_NAME="${CUSTOM_OUTPUT:-${CLEAN_TITLE}_merged.mp4}"
    FINAL_PATH="$DEST_DIR/$FINAL_NAME"

    # Fast stream-copy merge (0.1 second, lossless)
    if ! ffmpeg -y -f concat -safe 0 -i "$MERGE_LIST" -c copy "$FINAL_PATH" -loglevel error 2>/dev/null; then
      # Fallback re-encode if stream copy fails due to mismatched codecs
      log_warn "Stream-copy không tương thích, đang chuyển mã tự động..."
      ffmpeg -y -f concat -safe 0 -i "$MERGE_LIST" -c:v libx264 -c:a aac "$FINAL_PATH" -loglevel error
    fi
  fi

# ------------------------------------------------------------------------------
# CASE 2: Cắt 1 đoạn duy nhất
# ------------------------------------------------------------------------------
elif (( ${#TIMECODES[@]} == 1 )); then
  TC="${TIMECODES[0]}"
  log_step "Chế độ: Cắt 1 đoạn (${CYAN}$TC${NC})..."

  if [ "$AUDIO_MODE" = true ]; then
    EXT="mp3"
    FINAL_NAME="${CUSTOM_OUTPUT:-${CLEAN_TITLE}_[${TC//:/-}].mp3}"
    FINAL_PATH="$DEST_DIR/$FINAL_NAME"

    yt-dlp \
      --download-sections "*$TC" \
      --force-keyframes-at-cuts \
      -x --audio-format mp3 --audio-quality 0 \
      -o "$FINAL_PATH" \
      --embed-metadata \
      --no-playlist \
      "$URL"
  else
    EXT="mp4"
    FINAL_NAME="${CUSTOM_OUTPUT:-${CLEAN_TITLE}_[${TC//:/-}].mp4}"
    FINAL_PATH="$DEST_DIR/$FINAL_NAME"

    yt_args=(
      --download-sections "*$TC" \
      --force-keyframes-at-cuts \
      -f "bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]/best" \
      --merge-output-format mp4 \
      -o "$FINAL_PATH" \
      --embed-metadata \
      --no-playlist
    )

    if [ "$SPONSORBLOCK" = true ]; then
      yt_args+=(--sponsorblock-remove sponsor,selfpromo)
    fi

    yt-dlp "${yt_args[@]}" "$URL"
  fi

# ------------------------------------------------------------------------------
# CASE 3: Tải toàn bộ video (Có thể kèm SponsorBlock hoặc Audio)
# ------------------------------------------------------------------------------
else
  log_step "Chế độ: Tải toàn bộ nội dung..."

  if [ "$AUDIO_MODE" = true ]; then
    EXT="mp3"
    FINAL_NAME="${CUSTOM_OUTPUT:-${CLEAN_TITLE}.mp3}"
    FINAL_PATH="$DEST_DIR/$FINAL_NAME"

    yt-dlp -x --audio-format mp3 --audio-quality 0 -o "$FINAL_PATH" --embed-metadata "$URL"
  else
    EXT="mp4"
    FINAL_NAME="${CUSTOM_OUTPUT:-${CLEAN_TITLE}.mp4}"
    FINAL_PATH="$DEST_DIR/$FINAL_NAME"

    yt_args=(
      -f "bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]/best"
      --merge-output-format mp4
      -o "$FINAL_PATH"
      --embed-metadata
    )

    if [ "$SPONSORBLOCK" = true ]; then
      yt_args+=(--sponsorblock-remove sponsor,selfpromo)
    fi

    yt-dlp "${yt_args[@]}" "$URL"
  fi
fi

# ------------------------------------------------------------------------------
# HOÀN TẤT & THÔNG BÁO
# ------------------------------------------------------------------------------
if [[ -f "$FINAL_PATH" ]]; then
  SIZE=$(du -h "$FINAL_PATH" | cut -f1)
  echo ""
  log_ok "${BOLD}Hoàn thành xuất sắc!${NC}"
  log_dim "File:      $FINAL_NAME"
  log_dim "Đường dẫn: $FINAL_PATH"
  log_dim "Dung lượng: $SIZE"

  # Desktop Notification
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -i video-x-generic "ytdl-cut" "Đã tải và xử lý xong:\n$FINAL_NAME ($SIZE)"
  fi
else
  log_error "Đã xảy ra lỗi trong quá trình xử lý file!"
  exit 1
fi
