#!/usr/bin/env bash
# rofi-launcher — Mở Rofi với theme đang active
#
# Nguồn màu: ~/.config/theme/colors/current.conf (do theme-set quản lý)
# Fallback: đọc từ xrdb nếu chưa có theme nào được set
# colors.rasi được generate sẵn bởi theme-set → chỉ cần chạy rofi

THEME_CURRENT="${XDG_CONFIG_HOME:-$HOME/.config}/theme/colors/current.conf"
ROFI_COLORS="${XDG_CONFIG_HOME:-$HOME/.config}/rofi/colors.rasi"

# Nếu theme-set đã generate colors.rasi thì dùng thẳng (fast path)
# Nếu chưa có (lần đầu chạy / chưa cài theme) thì generate từ xrdb
if [ ! -f "$ROFI_COLORS" ]; then
    if [ -f "$THEME_CURRENT" ]; then
        # shellcheck disable=SC1090
        source "$THEME_CURRENT"
    else
        # Fallback từ xrdb
        _q() { xrdb -query 2>/dev/null | grep -m1 "^$1:" | awk '{print $2}'; }
        BG=$(_q '\*\.background'); BG=${BG:-#282828}; BG=${BG#\#}
        FG=$(_q '\*\.foreground'); FG=${FG:-#ebdbb2}; FG=${FG#\#}
        ACCENT=$(_q '\*\.color4');  ACCENT=${ACCENT:-#458588}; ACCENT=${ACCENT#\#}
    fi

    mkdir -p "$(dirname "$ROFI_COLORS")"
    cat > "$ROFI_COLORS" << EOF
/* Auto-generated by rofi-launcher (fallback) */
* {
    bg:       #${BG};
    fg:       #${FG};
    accent:   #${ACCENT};
    background-color: @bg;
    text-color:       @fg;
}
window   { border-color: @accent; }
element selected { background-color: @accent; text-color: #${BG}; }
EOF
fi

MODE="${1:-drun}"
exec rofi -show "$MODE" -theme "${XDG_CONFIG_HOME:-$HOME/.config}/rofi/launcher.rasi" 2>/dev/null
