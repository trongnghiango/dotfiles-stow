#!/usr/bin/env bash
# ka-update — Safe system update manager
# Wrapper around safe-pacman with staged updates, AUR handling, and rollback support
#
# Usage:
#   ka-update check           # Check for updates (no changes)
#   ka-update download        # Download packages only
#   ka-update apply           # Apply updates (default: safe-pacman -Syu)
#   ka-update aur             # Update AUR packages (yay/paru)
#   ka-update rollback [num]  # Rollback to snapper snapshot
#   ka-update status          # Show system update status
#   ka-update list-snapshots  # List available snapper snapshots

set -euo pipefail

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

log_info()    { echo -e "${BLUE}[INFO]${NC}    $*"; }
log_ok()      { echo -e "${GREEN}[OK]${NC}      $*"; }
log_warn()    { echo -e "${YELLOW}[WARN]${NC}    $*"; }
log_error()   { echo -e "${RED}[ERROR]${NC}   $*" >&2; }
log_step()    { echo -e "\n${CYAN}${BOLD}▸ $*${NC}"; }

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

cmd_check() {
  log_step "Checking for available updates..."

  # Official repos
  log_info "Official repositories:"
  if command -v checkupdates >/dev/null; then
    UPDATES=$(checkupdates 2>/dev/null)
    if [[ -n "$UPDATES" ]]; then
      echo "$UPDATES" | wc -l | xargs -I{} echo "  {} packages available"
      echo "$UPDATES" | head -20 | sed 's/^/  /'
      [[ $(echo "$UPDATES" | wc -l) -gt 20 ]] && echo "  ... and more"
    else
      log_ok "No official updates available"
    fi
  fi

  # AUR
  if command -v yay >/dev/null; then
    log_info "AUR (yay):"
    AUR_UPDATES=$(yay -Qu 2>/dev/null)
    if [[ -n "$AUR_UPDATES" ]]; then
      echo "$AUR_UPDATES" | wc -l | xargs -I{} echo "  {} packages available"
      echo "$AUR_UPDATES" | head -10 | sed 's/^/  /'
    else
      log_ok "No AUR updates available"
    fi
  elif command -v paru >/dev/null; then
    log_info "AUR (paru):"
    AUR_UPDATES=$(paru -Qu 2>/dev/null)
    if [[ -n "$AUR_UPDATES" ]]; then
      echo "$AUR_UPDATES" | wc -l | xargs -I{} echo "  {} packages available"
      echo "$AUR_UPDATES" | head -10 | sed 's/^/  /'
    else
      log_ok "No AUR updates available"
    fi
  fi

  # Flatpak
  if command -v flatpak >/dev/null; then
    log_info "Flatpak:"
    flatpak update --noninteractive 2>/dev/null | grep -c "update available" | xargs -I{} echo "  {} updates available" || log_ok "No Flatpak updates"
  fi
}

cmd_download() {
  log_step "Downloading packages only..."
  safe-pacman -Syuw
}

cmd_apply() {
  log_step "Applying system updates (official repos)..."

  # Sync databases first
  safe-pacman -Sy

  # Check if kernel will be updated
  KERNEL_UPDATE=0
  if checkupdates 2>/dev/null | grep -q "^linux\(-lts\)\? "; then
    KERNEL_UPDATE=1
    log_warn "Kernel update detected — will need reboot"
  fi

  # Check for glibc/systemd updates
  CRITICAL_UPDATE=0
  if checkupdates 2>/dev/null | grep -qE "^(glibc|systemd) "; then
    CRITICAL_UPDATE=1
    log_warn "Critical library update (glibc/systemd) — services will need restart"
  fi

  # Apply updates
  safe-pacman -Su "$@"

  # Post-update actions
  if [[ $KERNEL_UPDATE -eq 1 ]]; then
    log_info "Regenerating initramfs..."
    safe-pacman -S --noconfirm mkinitcpio
    sudo mkinitcpio -P
  fi

  if [[ $CRITICAL_UPDATE -eq 1 ]]; then
    log_info "Critical update applied — recommend: systemctl daemon-reexec && reboot"
  fi
}

cmd_aur() {
  log_step "Updating AUR packages..."

  if command -v yay >/dev/null; then
    yay -Syu --aur --noconfirm "$@"
  elif command -v paru >/dev/null; then
    paru -Syu --aur --noconfirm "$@"
  else
    log_error "No AUR helper found (yay or paru)"
    exit 1
  fi
}

cmd_flatpak() {
  log_step "Updating Flatpak packages..."
  flatpak update -y
}

cmd_rollback() {
  local target="${1:-}"

  log_step "Available snapper snapshots (root):"
  snapper -c root list

  if [[ -n "$target" ]]; then
    log_warn "Rolling back to snapshot #$target..."
    echo "This will:"
    echo "  1. Mount snapshot #$target"
    echo "  2. Create rollback snapshot"
    echo "  3. Set as default boot entry"
    echo ""
    read -rp "Continue? [y/N]: " confirm
    [[ "$confirm" =~ ^[Yy]$ ]] || { log_info "Aborted"; exit 0; }

    # Use snapper rollback
    sudo snapper -c root rollback "$target"
    log_ok "Rollback initiated. Reboot to activate."
  else
    log_info "Usage: ka-update rollback <snapshot-number>"
  fi
}

cmd_list_snapshots() {
  log_step "Snapper snapshots (root):"
  snapper -c root list

  if snapper -c home list >/dev/null 2>&1; then
    echo ""
    log_step "Snapper snapshots (home):"
    snapper -c home list
  fi
}

cmd_status() {
  log_step "System Update Status"

  # Last update
  if [[ -f /var/log/pacman.log ]]; then
    LAST_UPDATE=$(grep -E "\[PACMAN\].*(installed|upgraded)" /var/log/pacman.log | tail -1 | cut -d' ' -f1-2 | tr -d '[]')
    log_info "Last pacman operation: ${LAST_UPDATE:-unknown}"
  fi

  # Snapper snapshots count
  ROOT_SNAPS=$(snapper -c root list 2>/dev/null | grep -c "pre\|post\|single" || echo 0)
  log_info "Root snapshots: $ROOT_SNAPS"

  # Disk usage
  df -h / | awk 'NR==2 {print "  Root: " $3 " / " $2 " (" $5 " used)"}'

  # Pending updates
  cmd_check
}

show_help() {
  cat <<EOF
${BOLD}ka-update — Safe system update manager${NC}

${BOLD}USAGE:${NC}
  ka-update <command> [args...]

${BOLD}COMMANDS:${NC}
  ${GREEN}check${NC}           Check for available updates (official, AUR, Flatpak)
  ${GREEN}download${NC}        Download packages only (safe-pacman -Syuw)
  ${GREEN}apply${NC} [args]    Apply system updates (default: safe-pacman -Su)
  ${GREEN}aur${NC} [args]      Update AUR packages (yay/paru)
  ${GREEN}flatpak${NC}         Update Flatpak packages
  ${GREEN}rollback${NC} <num>  Rollback to snapper snapshot
  ${GREEN}list-snapshots${NC}  List all snapper snapshots
  ${GREEN}status${NC}          Show system update status

${BOLD}EXAMPLES:${NC}
  ka-update check              # See what's available
  ka-update apply              # Full system upgrade
  ka-update apply --noconfirm  # Non-interactive
  ka-update aur                # Update AUR packages
  ka-update rollback 42        # Rollback to snapshot #42
  ka-update status             # Full status dashboard

${BOLD}SAFETY FEATURES:${NC}
  • All operations via safe-pacman (PID 1 scope, sudo keepalive, logging)
  • Auto snapper pre/post snapshots via pacman hooks
  • Pre-flight checks (disk space, keyring, mirrors)
  • Post-update verification (GRUB, binaries, services, .pacnew)
  • Kernel update detection → auto mkinitcpio regeneration
EOF
}

main() {
  if [[ $# -eq 0 ]]; then
    show_help
    exit 0
  fi

  case "$1" in
    check)          cmd_check ;;
    download)       cmd_download ;;
    apply)          shift; cmd_apply "$@" ;;
    aur)            shift; cmd_aur "$@" ;;
    flatpak)        cmd_flatpak ;;
    rollback)       shift; cmd_rollback "$@" ;;
    list-snapshots) cmd_list_snapshots ;;
    status)         cmd_status ;;
    -h|--help|help) show_help ;;
    *)              log_error "Unknown command: $1"; show_help; exit 1 ;;
  esac
}

main "$@"