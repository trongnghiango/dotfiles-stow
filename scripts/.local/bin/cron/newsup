#!/bin/sh

# Set as a cron job to check for new RSS entries for newsboat.
# On Wayland/Omarchy: uses notify-send for feedback; newsboat refresh via pkill -USR1.

notify-send "📰 Updating RSS feeds..."

# If newsboat is running, send USR1 signal to trigger reload
if pgrep -f "newsboat$" > /dev/null 2>&1; then
	pkill -USR1 -f "newsboat$"
	notify-send "📰 RSS feed refresh triggered in running newsboat."
	exit 0
fi

newsboat -x reload
notify-send "📰 RSS feed update complete."
