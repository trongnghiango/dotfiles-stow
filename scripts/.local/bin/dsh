#!/usr/bin/env bash
# =============================================================================
# Omarchy DSH (DeepSeek Harness) Manager
# =============================================================================
# Triết lý: Quản lý minh bạch, hỗ trợ cả Local Git Repo lẫn NPM Pinned DLX.
# Cấu hình: ~/.config/dsh/ (version, mode)
# =============================================================================

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/dsh"
VERSION_FILE="$CONFIG_DIR/version"
MODE_FILE="$CONFIG_DIR/mode"
LOCAL_REPO="$HOME/Repos/github.com/trongnghiango/deepseek-harness"

DEFAULT_VERSION="0.1.2-rc.1"
DEFAULT_MODE="local"

mkdir -p "$CONFIG_DIR"

if [[ ! -f "$VERSION_FILE" ]]; then
    echo "$DEFAULT_VERSION" > "$VERSION_FILE"
fi

if [[ ! -f "$MODE_FILE" ]]; then
    if [[ -d "$LOCAL_REPO" ]]; then
        echo "local" > "$MODE_FILE"
    else
        echo "dlx" > "$MODE_FILE"
    fi
fi

CURRENT_VERSION=$(cat "$VERSION_FILE" | tr -d '[:space:]')
CURRENT_MODE=$(cat "$MODE_FILE" | tr -d '[:space:]')

show_help() {
    echo "Omarchy DSH (DeepSeek Harness) Manager"
    echo ""
    echo "Usage:"
    echo "  dsh [cmd] [args]           - Chạy DSH theo mode hiện tại ($CURRENT_MODE)"
    echo "  dsh mode [local|dlx]       - Xem hoặc chuyển đổi engine (local repo hoặc npm dlx)"
    echo "  dsh status                 - Xem tổng thể trạng thái mode, version, git repo"
    echo ""
    echo "Local Repo ($LOCAL_REPO):"
    echo "  dsh local [args]           - Ép buộc chạy trực tiếp từ local repo"
    echo "  dsh checkout <tag|branch>  - Chuyển đổi branch/tag trong local repo"
    echo "  dsh tags                   - Liệt kê các tags phiên bản trong local repo"
    echo "  dsh build                  - Cài đặt dependency và build local repo"
    echo ""
    echo "DLX Mode (NPM Package):"
    echo "  dsh dlx [args]             - Ép buộc chạy qua pnpm dlx"
    echo "  dsh update [version]       - Cập nhật version ghim (mặc định lấy latest)"
    echo "  dsh use <version>          - Chuyển đổi nhanh sang version npm cụ thể"
    echo "  dsh list / versions        - Hiển thị danh sách version có trên npm"
}

run_local() {
    local cmd="${1:-web}"
    shift || true
    if [[ ! -d "$LOCAL_REPO" ]]; then
        echo "[-] Lỗi: Không tìm thấy local repo tại $LOCAL_REPO"
        exit 1
    fi
    echo "[Omarchy DSH] Running '$cmd' via Local Repo: $LOCAL_REPO..."
    cd "$LOCAL_REPO"
    exec pnpm dsh "$cmd" "$@"
}

run_dlx() {
    local cmd="${1:-web}"
    shift || true
    echo "[Omarchy DSH] Running '$cmd' via pnpm dlx (@deepseek-ai/dsh@$CURRENT_VERSION)..."
    exec pnpm dlx \
        --allow-build @deepseek-ai/dsh-subprocess-local \
        --allow-build @google/genai \
        --allow-build koffi \
        --allow-build node-pty \
        --allow-build protobufjs \
        "@deepseek-ai/dsh@$CURRENT_VERSION" "$cmd" "$@"
}

case "$1" in
    mode)
        SET_MODE="$2"
        if [[ -z "$SET_MODE" ]]; then
            echo "DSH Current Engine Mode: $CURRENT_MODE"
            echo "Available modes: local, dlx"
            echo "  dsh mode local - Chạy trực tiếp từ local repo ($LOCAL_REPO)"
            echo "  dsh mode dlx   - Chạy qua pnpm dlx với version ghim ($CURRENT_VERSION)"
        elif [[ "$SET_MODE" == "local" || "$SET_MODE" == "dlx" ]]; then
            echo "$SET_MODE" > "$MODE_FILE"
            echo "[+] Đã chuyển engine mode sang: $SET_MODE"
        else
            echo "[-] Lỗi: Mode không hợp lệ. Chọn 'local' hoặc 'dlx'."
            exit 1
        fi
        ;;

    local)
        shift || true
        run_local "$@"
        ;;

    dlx)
        shift || true
        run_dlx "$@"
        ;;

    checkout)
        TARGET="$2"
        if [[ -z "$TARGET" ]]; then
            echo "[-] Lỗi: Cần chỉ định tag hoặc branch (vd: dsh checkout dsh-v0.1.5-rc.1)"
            exit 1
        fi
        if [[ ! -d "$LOCAL_REPO" ]]; then
            echo "[-] Lỗi: Không tìm thấy local repo tại $LOCAL_REPO"
            exit 1
        fi
        echo "[*] Đang chuyển đổi sang $TARGET trong $LOCAL_REPO..."
        git -C "$LOCAL_REPO" checkout "$TARGET"
        echo "[+] Đã chuyển sang: $(git -C "$LOCAL_REPO" branch --show-current 2>/dev/null || echo "$TARGET")"
        echo "[*] Lưu ý: Hãy chạy 'dsh build' nếu phiên bản mới yêu cầu re-build."
        ;;

    tags)
        if [[ -d "$LOCAL_REPO" ]]; then
            echo "[*] Các tags phiên bản trong local repo:"
            git -C "$LOCAL_REPO" tag -l --sort=-v:refname | head -n 15
        else
            echo "[-] Local repo chưa được clone tại $LOCAL_REPO"
        fi
        ;;

    build)
        if [[ ! -d "$LOCAL_REPO" ]]; then
            echo "[-] Lỗi: Không tìm thấy local repo tại $LOCAL_REPO"
            exit 1
        fi
        echo "[*] Đang build local repo tại $LOCAL_REPO..."
        cd "$LOCAL_REPO"
        pnpm install && pnpm run build
        ;;

    update)
        NEW_VERSION="$2"
        if [[ -z "$NEW_VERSION" ]]; then
            echo "[*] Đang kiểm tra version mới nhất bằng pnpm..."
            NEW_VERSION=$(pnpm view @deepseek-ai/dsh version 2>/dev/null)
            if [[ -z "$NEW_VERSION" ]]; then
                echo "[-] Không thể lấy version qua pnpm. Đang thử dùng curl..."
                NEW_VERSION=$(curl -s https://registry.npmjs.org/@deepseek-ai/dsh/latest | grep -oP '"version":"\K[^"]+')
                if [[ -z "$NEW_VERSION" ]]; then
                    echo "[-] Lỗi: Không thể lấy thông tin version mới nhất."
                    exit 1
                fi
            fi
        fi
        
        echo "$NEW_VERSION" > "$VERSION_FILE"
        echo "[+] Đã cập nhật (ghim) DSH lên version: $NEW_VERSION"
        ;;
    
    use)
        USE_VERSION="$2"
        if [[ -z "$USE_VERSION" ]]; then
            echo "[-] Lỗi: Bạn phải chỉ định version cụ thể."
            echo "    Ví dụ: dsh use 0.1.0"
            exit 1
        fi
        echo "$USE_VERSION" > "$VERSION_FILE"
        echo "[+] Đã chuyển (switch) DSH sang version: $USE_VERSION"
        ;;

    status)
        echo "DSH Engine Mode:               $CURRENT_MODE"
        echo "DSH Pinned Version (npm dlx):  $CURRENT_VERSION"
        if [[ -d "$LOCAL_REPO" ]]; then
            local_branch=$(git -C "$LOCAL_REPO" branch --show-current 2>/dev/null)
            local_tag=$(git -C "$LOCAL_REPO" describe --tags --exact-match 2>/dev/null || echo "none")
            echo "DSH Local Repo ($LOCAL_REPO):"
            echo "  Branch: ${local_branch:-detached}"
            echo "  Tag:    $local_tag"
            echo "  Commit: $(git -C "$LOCAL_REPO" rev-parse --short HEAD 2>/dev/null)"
        fi
        ;;

    list|versions)
        echo "[*] Fetching available versions from registry..."
        curl -s https://registry.npmjs.org/@deepseek-ai/dsh | jq -r '.versions | keys[]' | tail -n 15 | while read -r ver; do
            if [[ "$ver" == "$CURRENT_VERSION" ]]; then
                echo "  -> $ver (current)"
            else
                echo "     $ver"
            fi
        done
        ;;

    help|--help|-h)
        show_help
        ;;

    *)
        # Mặc định: Chạy theo mode được lưu trong ~/.config/dsh/mode
        if [[ "$CURRENT_MODE" == "local" && -d "$LOCAL_REPO" ]]; then
            run_local "$@"
        else
            run_dlx "$@"
        fi
        ;;
esac
