#!/usr/bin/env bash
# =============================================================================
# Omarchy DSH (DeepSeek Harness) Production CLI Manager
# =============================================================================
set -eo pipefail

# --- MÀU SẮC & GIAO DIỆN TERMINAL ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

info()    { echo -e "${CYAN}[INFO]${NC} $*"; }
success() { echo -e "${GREEN}[OK]${NC} $*"; }
warn()    { echo -e "${YELLOW}[WARN]${NC} $*"; }
error()   { echo -e "${RED}[ERROR]${NC} $*" >&2; }

# --- ĐƯỜNG DẪN & CẤU HÌNH ---
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/dsh"
VERSION_FILE="$CONFIG_DIR/version"
MODE_FILE="$CONFIG_DIR/mode"

REPO_URL="${DSH_REPO_URL:-https://github.com/deepseek-ai/deepseek-harness.git}"
LOCAL_REPO="${DSH_LOCAL_REPO:-$HOME/Repos/github.com/trongnghiango/deepseek-harness}"
DEFAULT_MODE="local"
DEFAULT_PORT=3080

mkdir -p "$CONFIG_DIR"
[[ ! -f "$MODE_FILE" ]] && echo "$DEFAULT_MODE" > "$MODE_FILE"
CURRENT_MODE=$(cat "$MODE_FILE" | tr -d '[:space:]')

# --- 1. PRE-FLIGHT CHECKS: KIỂM TRA MÔI TRƯỜNG ---
check_prerequisites() {
    local missing=()
    command -v git >/dev/null 2>&1 || missing+=("git")
    command -v node >/dev/null 2>&1 || missing+=("node")
    command -v pnpm >/dev/null 2>&1 || missing+=("pnpm")
    command -v curl >/dev/null 2>&1 || missing+=("curl")

    if [[ ${#missing[@]} -gt 0 ]]; then
        error "Thiếu các công cụ bắt buộc: ${missing[*]}"
        error "Vui lòng cài đặt trước khi tiếp tục."
        exit 1
    fi

    local node_ver
    node_ver=$(node -v | sed 's/v//' | cut -d. -f1)
    if [[ "$node_ver" -lt 20 ]]; then
        error "Node.js hiện tại là $(node -v). DSH yêu cầu Node.js >= v20.x"
        exit 1
    fi
}

# --- 2. SINGLE SOURCE OF TRUTH: LẤY VERSION HIỆN TẠI ---
get_active_version() {
    if [[ "$CURRENT_MODE" == "local" && -d "$LOCAL_REPO/.git" ]]; then
        local tag
        tag=$(git -C "$LOCAL_REPO" describe --tags --exact-match 2>/dev/null | sed -E 's/^(dsh-)?v?//' || true)
        if [[ -n "$tag" ]]; then
            echo "$tag"
            return
        fi
        if [[ -f "$LOCAL_REPO/apps/cli/package.json" ]]; then
            local p_ver
            p_ver=$(node -p "require('$LOCAL_REPO/apps/cli/package.json').version" 2>/dev/null || true)
            if [[ -n "$p_ver" ]]; then
                echo "$p_ver"
                return
            fi
        fi
    fi
    if [[ -f "$VERSION_FILE" ]]; then
        cat "$VERSION_FILE" | tr -d '[:space:]'
    else
        echo "0.2.1-rc.2"
    fi
}

# --- 3. ĐẢM BẢO REPO SẴN SÀNG (SELF-CLONE) ---
ensure_repo() {
    check_prerequisites
    if [[ ! -d "$LOCAL_REPO/.git" ]]; then
        info "Local repo chưa tồn tại tại: $LOCAL_REPO"
        info "Đang tự động clone từ GitHub: $REPO_URL..."
        mkdir -p "$(dirname "$LOCAL_REPO")"
        git clone "$REPO_URL" "$LOCAL_REPO"
        success "Clone repo thành công!"
    fi
}

# --- 4. BUILD PIPELINE ---
build_repo() {
    ensure_repo
    info "Đang cài đặt và cập nhật dependencies tại $LOCAL_REPO..."
    (
        cd "$LOCAL_REPO"
        if [[ -f "scripts/clean.ts" ]]; then
            info "Làm sạch cache cũ..."
            pnpm run clean || true
        fi
        pnpm install --frozen-lockfile || pnpm install
    )
    success "Cập nhật dependencies hoàn tất!"
    info "Bắt đầu kiểm tra biên dịch hệ thống (run-gates)..."
    if (cd "$LOCAL_REPO" && pnpm run build); then
        success "Biên dịch toàn bộ hệ thống thành công!"
    else
        warn "Biên dịch CI (run-gates) báo lỗi type-check từ các package thử nghiệm của upstream."
        info "Tuy nhiên Web UI & CLI vẫn sẵn sàng chạy bình thường qua TSX: 'dsh web'."
    fi
}

# --- 5. CHECKOUT AN TOÀN ---
checkout_version() {
    local target="$1"
    ensure_repo

    if [[ -n $(git -C "$LOCAL_REPO" status --porcelain) ]]; then
        warn "Phát hiện thay đổi chưa commit trong $LOCAL_REPO!"
        error "Để đảm bảo an toàn dữ liệu, hãy commit hoặc stash trước khi đổi version."
        exit 1
    fi

    info "Đang cập nhật tags mới nhất từ remote..."
    git -C "$LOCAL_REPO" fetch --all --tags --prune --quiet 2>/dev/null || true

    local clean_target
    clean_target=$(echo "$target" | sed -E 's/^(dsh-)?v?//')
    local candidate="dsh-v$clean_target"
    local resolved=""

    if git -C "$LOCAL_REPO" rev-parse --verify --quiet "$target" >/dev/null; then
        resolved="$target"
    elif git -C "$LOCAL_REPO" rev-parse --verify --quiet "$candidate" >/dev/null; then
        resolved="$candidate"
    elif git -C "$LOCAL_REPO" rev-parse --verify --quiet "v$clean_target" >/dev/null; then
        resolved="v$clean_target"
    fi

    if [[ -z "$resolved" ]]; then
        error "Không tìm thấy tag/branch '$target' trên remote Git."
        return 1
    fi

    info "Đang chuyển mã nguồn sang: $resolved..."
    git -C "$LOCAL_REPO" checkout "$resolved"
    success "Đã checkout mã nguồn sang: $resolved"
    return 0
}

# --- 6. KIỂM TRA XUNG ĐỘT PORT TRƯỚC KHI CHẠY WEB ---
check_port() {
    local port="${1:-$DEFAULT_PORT}"
    local pid
    pid=$(lsof -ti :"$port" 2>/dev/null || true)
    if [[ -n "$pid" ]]; then
        warn "Port $port đang được sử dụng bởi tiến trình (PID: $pid)!"
        warn "Nếu đó là DSH cũ, hãy tắt nó trước khi chạy phiên bản mới."
    fi
}

run_local() {
    ensure_repo
    if [[ ! -d "$LOCAL_REPO/node_modules" ]] || [[ ! -f "$LOCAL_REPO/apps/cli/lib/bin.js" ]]; then
        warn "Phát hiện repo chưa build hoặc thiếu lib/bin.js, tiến hành build tự động..."
        build_repo
    fi

    local args=("$@")
    if [[ ${#args[@]} -eq 0 ]]; then
        args=("web")
    fi

    if [[ "${args[0]}" == "web" ]]; then
        check_port "$DEFAULT_PORT"
    fi

    info "Khởi chạy dsh '${args[*]}' từ: $LOCAL_REPO..."
    if [[ -f "$LOCAL_REPO/apps/cli/lib/bin.js" ]]; then
        exec node "$LOCAL_REPO/apps/cli/lib/bin.js" "${args[@]}"
    else
        exec pnpm --dir "$LOCAL_REPO" run dsh "${args[@]}"
    fi
}

run_dlx() {
    check_prerequisites
    local ver
    ver=$(get_active_version)
    local args=("$@")
    if [[ ${#args[@]} -eq 0 ]]; then
        args=("web")
    fi

    if [[ "${args[0]}" == "web" ]]; then
        check_port "$DEFAULT_PORT"
    fi

    info "Khởi chạy qua pnpm dlx (@deepseek-ai/dsh@$ver)..."
    exec pnpm dlx \
        --allow-build @deepseek-ai/dsh-subprocess-local \
        --allow-build @google/genai \
        --allow-build koffi \
        --allow-build node-pty \
        --allow-build protobufjs \
        "@deepseek-ai/dsh@$ver" "${args[@]}"
}

# =============================================================================
# SEMVER & VERSION INTELLIGENCE HELPERS (NODE-POWERED)
# =============================================================================

# So sánh 2 phiên bản SemVer chuẩn. Trả về: 1 nếu v1 > v2, 0 nếu bằng nhau, -1 nếu v1 < v2
semver_cmp() {
    local v1="$1"
    local v2="$2"
    node -e '
        function parse(v) {
            if (!v) return { major: 0, minor: 0, patch: 0, prerelease: "" };
            const clean = v.replace(/^(dsh-)?v?/, "");
            const [core, prerelease = ""] = clean.split("-");
            const [major = 0, minor = 0, patch = 0] = core.split(".").map(Number);
            return { major, minor, patch, prerelease };
        }
        function compare(a, b) {
            const pa = parse(a), pb = parse(b);
            if (pa.major !== pb.major) return pa.major - pb.major;
            if (pa.minor !== pb.minor) return pa.minor - pb.minor;
            if (pa.patch !== pb.patch) return pa.patch - pb.patch;
            if (!pa.prerelease && pb.prerelease) return 1;
            if (pa.prerelease && !pb.prerelease) return -1;
            if (!pa.prerelease && !pb.prerelease) return 0;
            return pa.prerelease.localeCompare(pb.prerelease, undefined, { numeric: true });
        }
        const res = compare(process.argv[1], process.argv[2]);
        if (res > 0) console.log(1);
        else if (res < 0) console.log(-1);
        else console.log(0);
    ' "$v1" "$v2"
}

# Lấy phiên bản Git tag cao nhất hiện có trên local repo (đã fetch remote)
get_latest_git_version() {
    if [[ ! -d "$LOCAL_REPO/.git" ]]; then
        echo ""
        return
    fi
    local raw_tags
    raw_tags=$(git -C "$LOCAL_REPO" tag -l)
    if [[ -z "$raw_tags" ]]; then
        echo ""
        return
    fi
    node -e '
        function parse(v) {
            if (!v) return { major: 0, minor: 0, patch: 0, prerelease: "" };
            const clean = v.replace(/^(dsh-)?v?/, "");
            const [core, prerelease = ""] = clean.split("-");
            const [major = 0, minor = 0, patch = 0] = core.split(".").map(Number);
            return { major, minor, patch, prerelease };
        }
        function compare(a, b) {
            const pa = parse(a), pb = parse(b);
            if (pa.major !== pb.major) return pa.major - pb.major;
            if (pa.minor !== pb.minor) return pa.minor - pb.minor;
            if (pa.patch !== pb.patch) return pa.patch - pb.patch;
            if (!pa.prerelease && pb.prerelease) return 1;
            if (pa.prerelease && !pb.prerelease) return -1;
            if (!pa.prerelease && !pb.prerelease) return 0;
            return pa.prerelease.localeCompare(pb.prerelease, undefined, { numeric: true });
        }
        const tags = process.argv[1].split(/\s+/).filter(Boolean);
        const cleanTags = tags.map(t => t.replace(/^(dsh-)?v?/, ""));
        cleanTags.sort(compare);
        if (cleanTags.length > 0) {
            console.log(cleanTags[cleanTags.length - 1]);
        }
    ' "$raw_tags"
}

# Lấy phiên bản Registry cao nhất (không phụ thuộc vào dist-tags.latest vốn thường bị stale)
get_latest_npm_version() {
    node -e '
        function parse(v) {
            if (!v) return { major: 0, minor: 0, patch: 0, prerelease: "" };
            const clean = v.replace(/^(dsh-)?v?/, "");
            const [core, prerelease = ""] = clean.split("-");
            const [major = 0, minor = 0, patch = 0] = core.split(".").map(Number);
            return { major, minor, patch, prerelease };
        }
        function compare(a, b) {
            const pa = parse(a), pb = parse(b);
            if (pa.major !== pb.major) return pa.major - pb.major;
            if (pa.minor !== pb.minor) return pa.minor - pb.minor;
            if (pa.patch !== pb.patch) return pa.patch - pb.patch;
            if (!pa.prerelease && pb.prerelease) return 1;
            if (pa.prerelease && !pb.prerelease) return -1;
            if (!pa.prerelease && !pb.prerelease) return 0;
            return pa.prerelease.localeCompare(pb.prerelease, undefined, { numeric: true });
        }
        fetch("https://registry.npmjs.org/@deepseek-ai/dsh")
            .then(r => r.json())
            .then(data => {
                const versions = Object.keys(data.versions || {});
                versions.sort(compare);
                if (versions.length > 0) {
                    console.log(versions[versions.length - 1]);
                }
            })
            .catch(() => process.exit(1));
    ' 2>/dev/null || true
}

# Kiểm tra xem một phiên bản có tồn tại trên NPM registry không
check_npm_version_exists() {
    local target="$1"
    node -e '
        const target = process.argv[1];
        fetch("https://registry.npmjs.org/@deepseek-ai/dsh/" + encodeURIComponent(target))
            .then(r => {
                if (r.ok) console.log("yes");
                else console.log("no");
            })
            .catch(() => console.log("no"));
    ' "$target" 2>/dev/null || echo "no"
}

# =============================================================================
# ACTION HANDLERS
# =============================================================================

handle_use() {
    local target_ver="$1"
    if [[ -z "$target_ver" ]]; then
        error "Vui lòng nhập version. Ví dụ: dsh use 0.2.1-rc.3"
        exit 1
    fi

    local clean_target
    clean_target=$(echo "$target_ver" | sed -E 's/^(dsh-)?v?//')

    if [[ "$CURRENT_MODE" == "local" ]]; then
        ensure_repo
        if checkout_version "$clean_target"; then
            info "Đang đồng bộ thư viện (pnpm install) cho $clean_target..."
            (
                cd "$LOCAL_REPO"
                pnpm install --frozen-lockfile || pnpm install
            )
            echo "$clean_target" > "$VERSION_FILE"
            success "Đã chuyển và đồng bộ thành công DSH Local lên $clean_target!"
            info "Khởi chạy Web UI: dsh web"
        else
            # Nếu không tìm thấy tag trên Git, kiểm tra xem NPM Registry có không
            info "Đang kiểm tra xem '$clean_target' có trên NPM Registry hay không..."
            local npm_exists
            npm_exists=$(check_npm_version_exists "$clean_target")
            if [[ "$npm_exists" == "yes" ]]; then
                warn "Phiên bản '$clean_target' có sẵn trên NPM Registry nhưng CHƯA ĐƯỢC GẮN TAG trên Git repo GitHub."
                warn "Do đó, chế độ Local (mã nguồn Git) không thể checkout được bản này."
                echo ""
                if [[ -t 0 ]]; then
                    read -rp "Bạn có muốn tự động chuyển sang chế độ DLX để dùng phiên bản $clean_target không? [Y/n]: " answer
                    answer=${answer:-Y}
                    if [[ "$answer" =~ ^[Yy]$ ]]; then
                        echo "dlx" > "$MODE_FILE"
                        echo "$clean_target" > "$VERSION_FILE"
                        success "Đã chuyển sang chế độ DLX và ghim phiên bản $clean_target!"
                        info "Chạy 'dsh' để khởi động ngay."
                        exit 0
                    fi
                fi
                info "Để dùng phiên bản này, hãy chuyển sang chế độ DLX: dsh mode dlx && dsh use $clean_target"
                info "Gõ 'dsh versions' để xem bảng so sánh chi tiết giữa Git và NPM."
            else
                error "Không tìm thấy phiên bản '$clean_target' trên cả Git lẫn NPM Registry."
                info "Chạy 'dsh versions' để xem danh sách phiên bản có thể sử dụng."
            fi
            exit 1
        fi
    else
        # DLX Mode
        info "Đang xác thực phiên bản '$clean_target' trên Registry..."
        local npm_exists
        npm_exists=$(check_npm_version_exists "$clean_target")
        if [[ "$npm_exists" == "yes" ]]; then
            echo "$clean_target" > "$VERSION_FILE"
            success "Đã ghim version $clean_target cho chế độ DLX."
        else
            error "Phiên bản '$clean_target' không tồn tại trên NPM Registry."
            info "Chạy 'dsh versions' để xem các phiên bản khả dụng."
            exit 1
        fi
    fi
}

handle_update() {
    local cur_ver
    cur_ver=$(get_active_version)

    if [[ "$CURRENT_MODE" == "local" ]]; then
        ensure_repo
        info "Đang tìm kiếm phiên bản mới nhất từ Git Remote (Mode: Local)..."
        git -C "$LOCAL_REPO" fetch --all --tags --prune --quiet 2>/dev/null || true
        local latest_git
        latest_git=$(get_latest_git_version)

        if [[ -z "$latest_git" ]]; then
            error "Không thể xác định phiên bản trên Git Remote."
            exit 1
        fi

        local cmp
        cmp=$(semver_cmp "$latest_git" "$cur_ver")
        if [[ "$cmp" -le 0 ]]; then
            success "Mã nguồn Git đã ở phiên bản mới nhất khả dụng (${BOLD}$cur_ver${NC}). Không cần cập nhật."
        else
            info "Phát hiện phiên bản Git mới hơn: ${GREEN}$latest_git${NC} (Hiện tại: $cur_ver)"
            handle_use "$latest_git"
        fi

        # Kiểm tra thêm trạng thái NPM Registry để thông báo thông minh
        local latest_npm
        latest_npm=$(get_latest_npm_version)
        if [[ -n "$latest_npm" ]]; then
            local npm_cmp
            npm_cmp=$(semver_cmp "$latest_npm" "$latest_git")
            if [[ "$npm_cmp" -gt 0 ]]; then
                echo ""
                info "Lưu ý: Trên NPM Registry đã có bản ${BOLD}$latest_npm${NC} (DeepSeek chưa gắn Git tag)."
                info "Nếu muốn trải nghiệm bản này ngay, bạn có thể chạy: ${CYAN}dsh mode dlx && dsh update${NC}"
            fi
        fi

    else
        # DLX Mode
        info "Đang tìm kiếm phiên bản cao nhất từ NPM Registry (Mode: DLX)..."
        local latest_npm
        latest_npm=$(get_latest_npm_version)

        if [[ -z "$latest_npm" ]]; then
            error "Không thể nạp dữ liệu phiên bản từ NPM Registry."
            exit 1
        fi

        local cmp
        cmp=$(semver_cmp "$latest_npm" "$cur_ver")
        if [[ "$cmp" -le 0 ]]; then
            success "Chế độ DLX đã ở phiên bản mới nhất (${BOLD}$cur_ver${NC}). Không cần cập nhật."
        else
            info "Cập nhật DLX từ $cur_ver lên phiên bản mới nhất: ${GREEN}$latest_npm${NC}..."
            echo "$latest_npm" > "$VERSION_FILE"
            success "Đã cập nhật DLX lên $latest_npm thành công!"
        fi
    fi
}

# =============================================================================
# CLI ROUTING
# =============================================================================

case "$1" in
    version|-v|--version)
        cur_ver=$(get_active_version)
        echo -e "${GREEN}DSH Version:${NC} $cur_ver (Engine: $CURRENT_MODE)"
        if [[ "$CURRENT_MODE" == "local" && -d "$LOCAL_REPO/.git" ]]; then
            tag=$(git -C "$LOCAL_REPO" describe --tags --exact-match 2>/dev/null || echo "none")
            commit=$(git -C "$LOCAL_REPO" rev-parse --short HEAD 2>/dev/null || echo "unknown")
            echo -e "  Local Git: tag=$tag, commit=$commit"
        fi
        ;;

    mode)
        if [[ -z "$2" ]]; then
            echo "Current Engine Mode: $CURRENT_MODE (local | dlx)"
        elif [[ "$2" == "local" || "$2" == "dlx" ]]; then
            echo "$2" > "$MODE_FILE"
            success "Đã chuyển engine mode sang: $2"
        else
            error "Mode không hợp lệ. Chỉ chấp nhận 'local' hoặc 'dlx'."
            exit 1
        fi
        ;;

    build)
        build_repo
        ;;

    checkout)
        if [[ -z "$2" ]]; then
            error "Vui lòng chỉ định tag hoặc branch."
            exit 1
        fi
        checkout_version "$2"
        ;;

    fetch)
        ensure_repo
        info "Đang fetch cập nhật và tags từ remote trong $LOCAL_REPO..."
        git -C "$LOCAL_REPO" fetch --all --tags --prune
        success "Đã fetch xong."
        ;;

    pull)
        ensure_repo
        info "Đang pull cập nhật từ remote trong $LOCAL_REPO..."
        git -C "$LOCAL_REPO" pull --tags
        ;;

    tags)
        ensure_repo
        info "Các tags phiên bản trong local repo (mới nhất trước):"
        git -C "$LOCAL_REPO" tag -l --sort=-v:refname | head -n 15
        ;;

    use)
        handle_use "$2"
        ;;

    update)
        handle_update
        ;;

    versions|list)
        cur_ver=$(get_active_version)
        local_git_tags=""
        if [[ -d "$LOCAL_REPO/.git" ]]; then
            git -C "$LOCAL_REPO" fetch --all --tags --prune --quiet 2>/dev/null || true
            local_git_tags=$(git -C "$LOCAL_REPO" tag -l)
        fi

        node -e '
            const curMode = process.argv[1];
            const curVer = process.argv[2];
            const gitTagsRaw = process.argv[3] || "";

            function parse(v) {
                if (!v) return { major: 0, minor: 0, patch: 0, prerelease: "" };
                const clean = v.replace(/^(dsh-)?v?/, "");
                const [core, prerelease = ""] = clean.split("-");
                const [major = 0, minor = 0, patch = 0] = core.split(".").map(Number);
                return { major, minor, patch, prerelease };
            }
            function compare(a, b) {
                const pa = parse(a), pb = parse(b);
                if (pa.major !== pb.major) return pa.major - pb.major;
                if (pa.minor !== pb.minor) return pa.minor - pb.minor;
                if (pa.patch !== pb.patch) return pa.patch - pb.patch;
                if (!pa.prerelease && pb.prerelease) return 1;
                if (pa.prerelease && !pb.prerelease) return -1;
                if (!pa.prerelease && !pb.prerelease) return 0;
                return pa.prerelease.localeCompare(pb.prerelease, undefined, { numeric: true });
            }

            const gitTags = gitTagsRaw.split(/\s+/).filter(Boolean);
            const gitSet = new Set(gitTags.map(t => t.replace(/^(dsh-)?v?/, "")));

            fetch("https://registry.npmjs.org/@deepseek-ai/dsh")
                .then(r => r.json())
                .then(data => {
                    const npmVers = Object.keys(data.versions || {});
                    const npmSet = new Set(npmVers);

                    const allVers = Array.from(new Set([...gitSet, ...npmSet]))
                        .sort(compare)
                        .reverse()
                        .slice(0, 15);

                    const latestGit = Array.from(gitSet).sort(compare).reverse()[0];
                    const latestNpm = Array.from(npmSet).sort(compare).reverse()[0];

                    console.log("\x1b[36m[INFO]\x1b[0m Danh sách phiên bản gần nhất (Mode: \x1b[34m" + curMode + "\x1b[0m | Đang dùng: \x1b[32m" + curVer + "\x1b[0m):");
                    console.log("");
                    console.log("   " + "PHIÊN BẢN".padEnd(16) + "GIT (LOCAL)".padEnd(24) + "NPM (DLX)");
                    console.log("   " + "-".repeat(56));

                    allVers.forEach(v => {
                        const isCur = (v === curVer);
                        const prefix = isCur ? "\x1b[32m->\x1b[0m " : "   ";
                        
                        let gitText = "-";
                        if (v === latestGit) gitText = "\x1b[33mKhả dụng (mới nhất)\x1b[0m";
                        else if (gitSet.has(v)) gitText = "Khả dụng";
                        else gitText = "\x1b[90mChưa có tag\x1b[0m";

                        let npmText = "-";
                        if (v === latestNpm) npmText = "\x1b[35mKhả dụng (mới nhất)\x1b[0m";
                        else if (npmSet.has(v)) npmText = "Khả dụng";
                        else npmText = "\x1b[90mKhông có\x1b[0m";

                        const vDisplay = isCur ? `\x1b[32m\x1b[1m${v}\x1b[0m` : v;
                        const vCol = isCur ? (vDisplay + " ".repeat(Math.max(0, 16 - v.length))) : v.padEnd(16);
                        
                        const gitPad = gitText.includes("\x1b") ? 33 : 24;
                        console.log(`${prefix}${vCol}${gitText.padEnd(gitPad)}${npmText}`);
                    });

                    if (latestNpm && latestGit && compare(latestNpm, latestGit) > 0) {
                        console.log("");
                        console.log("\x1b[33m[!]\x1b[0m \x1b[1m" + latestNpm + "\x1b[0m đã publish trên NPM nhưng DeepSeek chưa gắn tag lên Git.");
                        console.log("    Để dùng bản này, chuyển sang DLX: \x1b[36mdsh mode dlx && dsh use " + latestNpm + "\x1b[0m");
                    }
                })
                .catch(err => {
                    console.error("\x1b[31m[ERROR]\x1b[0m Lỗi nạp dữ liệu Registry:", err.message);
                    process.exit(1);
                });
        ' "$CURRENT_MODE" "$cur_ver" "$local_git_tags"
        ;;

    status)
        cur_ver=$(get_active_version)
        echo "=================================================="
        echo -e " DSH Engine Mode:   ${BLUE}$CURRENT_MODE${NC}"
        echo -e " Active Version:    ${GREEN}$cur_ver${NC}"
        echo -e " Local Repo Path:   $LOCAL_REPO"
        if [[ -d "$LOCAL_REPO/.git" ]]; then
            tag=$(git -C "$LOCAL_REPO" describe --tags --exact-match 2>/dev/null || echo "none")
            commit=$(git -C "$LOCAL_REPO" rev-parse --short HEAD 2>/dev/null || echo "unknown")
            echo -e " Git State:         Cloned (Tag: $tag, Commit: $commit)"
        else
            echo -e " Git State:         ${YELLOW}Chưa clone (tự động clone khi chạy)${NC}"
        fi
        echo "=================================================="
        ;;

    local)
        shift || true
        run_local "$@"
        ;;

    dlx)
        shift || true
        run_dlx "$@"
        ;;

    help|--help|-h)
        cat << 'EOF'
Omarchy DSH Production CLI Manager
Sử dụng:
  dsh [command] [options]

Các lệnh phổ biến:
  dsh                     Chạy Web GUI (tự clone & build nếu chưa có)
  dsh use <version>       Tự fetch, checkout, clean và build phiên bản chỉ định
  dsh update              Tự kiểm tra và nâng cấp lên phiên bản mới nhất mà không bị hạ cấp
  dsh build               Dọn cache cũ và build lại local repository
  dsh versions            Hiển thị bảng so sánh phiên bản giữa Git và NPM Registry
  dsh mode [local|dlx]    Xem hoặc chuyển đổi engine (mã nguồn local hoặc npm dlx)
  dsh status              Xem tổng quan trạng thái, mode, commit và version
  dsh version             In ra phiên bản hiện tại
EOF
        ;;

    *)
        if [[ "$CURRENT_MODE" == "local" ]]; then
            run_local "$@"
        else
            run_dlx "$@"
        fi
        ;;
esac
