#!/usr/bin/env bash
# ==============================================================================
# shortcuts — Generate alias/bookmark files from bm-dirs and bm-files safely
# ==============================================================================
set -eo pipefail

bmdirs="${XDG_CONFIG_HOME:-$HOME/.config}/shell/bm-dirs"
bmfiles="${XDG_CONFIG_HOME:-$HOME/.config}/shell/bm-files"

shell_shortcuts="${XDG_CONFIG_HOME:-$HOME/.config}/shell/shortcutrc"
shell_env_shortcuts="${XDG_CONFIG_HOME:-$HOME/.config}/shell/shortcutenvrc"
zsh_named_dirs="${XDG_CONFIG_HOME:-$HOME/.config}/shell/zshnameddirrc"
lf_shortcuts="${XDG_CONFIG_HOME:-$HOME/.config}/lf/shortcutrc"
vim_shortcuts="${XDG_CONFIG_HOME:-$HOME/.config}/nvim/shortcuts.vim"

mkdir -p "$(dirname "$shell_shortcuts")" "$(dirname "$lf_shortcuts")" "$(dirname "$vim_shortcuts")"

# Remove existing generated files safely (never touch /dev/null)
rm -f "$lf_shortcuts" "$zsh_named_dirs" "$vim_shortcuts" 2>/dev/null || true
printf "# vim: filetype=sh\nalias " > "$shell_shortcuts"
printf "# vim: filetype=sh\n" > "$shell_env_shortcuts"

resolve_path() {
    local raw="$1"
    raw="${raw//\$\{XDG_CONFIG_HOME:-\$HOME\/.config\}/${XDG_CONFIG_HOME:-$HOME/.config}}"
    raw="${raw//\$\{XDG_CACHE_HOME:-\$HOME\/.cache\}/${XDG_CACHE_HOME:-$HOME/.cache}}"
    raw="${raw//\$\{XDG_DATA_HOME:-\$HOME\/.local\/share\}/${XDG_DATA_HOME:-$HOME/.local/share}}"
    raw="${raw//\$\{XDG_DOWNLOAD_DIR:-\$HOME\/Downloads\}/${XDG_DOWNLOAD_DIR:-$HOME/Downloads}}"
    raw="${raw//\$\{XDG_DOCUMENTS_DIR:-\$HOME\/Documents\}/${XDG_DOCUMENTS_DIR:-$HOME/Documents}}"
    raw="${raw//\$\{XDG_MUSIC_DIR:-\$HOME\/Music\}/${XDG_MUSIC_DIR:-$HOME/Music}}"
    raw="${raw//\$\{XDG_PICTURES_DIR:-\$HOME\/Pictures\}/${XDG_PICTURES_DIR:-$HOME/Pictures}}"
    raw="${raw//\$\{XDG_VIDEOS_DIR:-\$HOME\/Videos\}/${XDG_VIDEOS_DIR:-$HOME/Videos}}"
    raw="${raw//\$XDG_CONFIG_HOME/${XDG_CONFIG_HOME:-$HOME/.config}}"
    raw="${raw//\$XDG_CACHE_HOME/${XDG_CACHE_HOME:-$HOME/.cache}}"
    raw="${raw//\$XDG_DATA_HOME/${XDG_DATA_HOME:-$HOME/.local/share}}"
    raw="${raw//\$ZDOTDIR/${ZDOTDIR:-$HOME/.config/zsh}}"
    raw="${raw//\$HOME/$HOME}"
    raw="${raw/#\~/$HOME}"
    echo "$raw"
}

# 1. Process directories
if [ -f "$bmdirs" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
        line="${line%%#*}"
        [ -z "$(echo "$line" | tr -d '[:space:]')" ] && continue
        key=$(echo "$line" | awk '{print $1}')
        val=$(echo "$line" | awk '{$1=""; print $0}' | sed 's/^[[:space:]]*//')
        [ -z "$key" ] || [ -z "$val" ] && continue
        expanded=$(resolve_path "$val")

        printf '%s="cd %s && ls -A" \
' "$key" "$expanded" >> "$shell_shortcuts"
        printf '[ -n "%s" ] && export %s="%s"
' "$key" "$key" "$expanded" >> "$shell_env_shortcuts"
        printf 'hash -d %s="%s"
' "$key" "$expanded" >> "$zsh_named_dirs"
        printf 'map C%s cd "%s"
' "$key" "$expanded" >> "$lf_shortcuts"
        printf 'cmap ;%s %s
' "$key" "$expanded" >> "$vim_shortcuts"
    done < "$bmdirs"
fi

# 2. Process files
if [ -f "$bmfiles" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
        line="${line%%#*}"
        [ -z "$(echo "$line" | tr -d '[:space:]')" ] && continue
        key=$(echo "$line" | awk '{print $1}')
        val=$(echo "$line" | awk '{$1=""; print $0}' | sed 's/^[[:space:]]*//')
        [ -z "$key" ] || [ -z "$val" ] && continue
        expanded=$(resolve_path "$val")

        printf '%s="$EDITOR %s" \
' "$key" "$expanded" >> "$shell_shortcuts"
        printf '[ -n "%s" ] && export %s="%s"
' "$key" "$key" "$expanded" >> "$shell_env_shortcuts"
        printf 'hash -d %s="%s"
' "$key" "$expanded" >> "$zsh_named_dirs"
        printf 'map E%s $EDITOR "%s"
' "$key" "$expanded" >> "$lf_shortcuts"
        printf 'cmap ;%s %s
' "$key" "$expanded" >> "$vim_shortcuts"
    done < "$bmfiles"
fi
