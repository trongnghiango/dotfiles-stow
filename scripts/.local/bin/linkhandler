#!/bin/sh

# Feed script a url or file location.
# If a video/gif, view in mpv.
# If an image, view in imv (Wayland-native) or swayimg.
# If a pdf/cbz, download and open in zathura.
# If a music file, download via qndl.
# Otherwise, open in $BROWSER.

if [ -z "$1" ]; then
	# Wayland: wl-paste; fallback to xclip for X11 compatibility
	url="$(wl-paste 2>/dev/null || xclip -o 2>/dev/null)"
else
	url="$1"
fi

case "$url" in
	*mkv|*webm|*mp4|*youtube.com/watch*|*youtube.com/playlist*|*youtube.com/shorts*|*youtu.be*|*hooktube.com*|*bitchute.com*|*odysee.com*)
		setsid -f mpv --quiet "$url" >/dev/null 2>&1 ;;
	*png|*jpg|*jpe|*jpeg|*gif|*webp)
		tmp="/tmp/$(echo "$url" | sed "s/.*\///;s/%20/ /g")"
		curl -sL "$url" > "$tmp" && \
			setsid -f imv "$tmp" >/dev/null 2>&1 & ;;
	*pdf|*cbz|*cbr)
		tmp="/tmp/$(echo "$url" | sed "s/.*\///;s/%20/ /g")"
		curl -sL "$url" > "$tmp" && \
			setsid -f zathura "$tmp" >/dev/null 2>&1 & ;;
	*mp3|*flac|*opus|*mp3?source*)
		qndl "$url" 'curl -LO' >/dev/null 2>&1 ;;
	*)
		[ -f "$url" ] && setsid -f "$TERMINAL" -e "$EDITOR" "$url" >/dev/null 2>&1 \
			|| setsid -f "$BROWSER" "$url" >/dev/null 2>&1
esac
