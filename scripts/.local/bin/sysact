#!/usr/bin/env sh
# ==============================================================================
# sysact — Trình quản lý nguồn và phiên làm việc (Power & Session Actions)
# Tương thích: Rofi / Dmenu qua ka-menu, Systemd / Loginctl / Runit
# ==============================================================================

# Xác định công cụ điều khiển nguồn của hệ thống
if command -v systemctl >/dev/null 2>&1; then
  ctl="systemctl"
elif command -v loginctl >/dev/null 2>&1; then
  ctl="loginctl"
else
  ctl=""
fi

wmpid() {
  pidof -s dwm 2>/dev/null || pgrep -x dwm 2>/dev/null || echo "$$"
}

mute_audio() {
  if [ "${AUDIO_BACKEND:-pipewire}" = "alsa" ] || ! command -v wpctl >/dev/null 2>&1; then
    amixer sset Master mute >/dev/null 2>&1 || true
  else
    wpctl set-mute @DEFAULT_AUDIO_SINK@ 1 >/dev/null 2>&1 || true
  fi
}

lock_screen() {
  mpc pause >/dev/null 2>&1 || true
  pauseallmpv >/dev/null 2>&1 || true
  mute_audio
  pkill -RTMIN+11 -x dwmblocks 2>/dev/null || true
  if command -v slock >/dev/null 2>&1; then
    slock
  elif command -v xset >/dev/null 2>&1; then
    xset dpms force off
  fi
}

options="🔒 Khóa màn hình (Lock)
🚪 Đăng xuất (Logout)
♻ Nạp lại DWM (Restart)
💤 Tạm dừng (Sleep)
🐻 Ngủ đông (Hibernate)
🔃 Khởi động lại (Reboot)
🖥 Tắt máy (Shutdown)
📺 Tắt màn hình (Display Off)"

choice=$(printf "%s" "$options" | ka-menu -p "Hệ thống:")

case "$choice" in
  *"Khóa"*)     lock_screen ;;
  *"Đăng xuất"*) kill -TERM "$(wmpid)" ;;
  *"Nạp lại"*)   kill -HUP "$(wmpid)" ;;
  *"Tạm dừng"*)
    lock_screen &
    if [ "$ctl" = "systemctl" ]; then
      systemctl suspend
    elif command -v zzz >/dev/null 2>&1; then
      sudo zzz
    elif [ -n "$ctl" ]; then
      $ctl suspend
    fi
    ;;
  *"Ngủ đông"*)
    lock_screen &
    [ -n "$ctl" ] && $ctl hibernate
    ;;
  *"Khởi động lại"*) [ -n "$ctl" ] && $ctl reboot ;;
  *"Tắt máy"*)        [ -n "$ctl" ] && $ctl poweroff ;;
  *"Tắt màn hình"*)  xset dpms force off ;;
  *) exit 0 ;;
esac
