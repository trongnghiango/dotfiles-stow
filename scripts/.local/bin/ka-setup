#!/usr/bin/env bash

# ==============================================================================
# KA SYSTEM SETUP & AUTO-CONFIG (ka-setup)
# Description: Post-install autoconfig helper for Arch Linux + Omarchy (Wayland)
# ==============================================================================

# COLORS
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

log_info() { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[OK]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }
log_step() { echo -e "${CYAN}➜ $1${NC}"; }

show_help() {
  echo -e "${BOLD}Hệ thống tự động cấu hình (ka-setup)${NC}"
  echo "=========================================================="
  echo "Cấu hình nhanh môi trường sau khi cài đặt Arch Linux / Omarchy & Dotfiles."
  echo ""
  echo -e "${BOLD}SỬ DỤNG:${NC}"
  echo "  ka-setup <command>"
  echo ""
  echo -e "${BOLD}COMMANDS:${NC}"
  echo -e "  ${GREEN}all${NC}       Chạy toàn bộ các bước cấu hình (bao gồm cài dependencies)."
  echo -e "  ${GREEN}pkgs${NC}      Kiểm tra và cài đặt toàn bộ gói phụ thuộc (stow, fuse2, git-delta, lf, etc.)."
  echo -e "  ${GREEN}shell${NC}     Đặt Zsh làm login shell mặc định (chsh)."
  echo -e "  ${GREEN}stow${NC}      Deploy dotfiles an toàn qua stow-safe."
  echo -e "  ${GREEN}pam${NC}       Cấu hình tự động mở khóa gnome-keyring tại TTY."
  echo -e "  ${GREEN}docker${NC}    Cấu hình quyền Docker (non-root) & socket activation."
  echo -e "  ${GREEN}ime${NC}       Cài đặt fcitx5-bamboo cho bộ gõ Tiếng Việt."
  echo -e "  ${GREEN}battery${NC}   Cấu hình ngưỡng sạc pin ThinkPad (50-60%)."
  echo -e "  ${GREEN}gpu-fix${NC}   Sửa lỗi boot kernel của đồ họa lai (i915/nvidia)."
  echo ""
}

# ------------------------------------------------------------------------------
# 0. Cài đặt các gói phụ thuộc thiết yếu (Essential Dependencies)
# ------------------------------------------------------------------------------
setup_pkgs() {
  log_step "Kiểm tra và cài đặt các gói phụ thuộc thiết yếu..."

  if ! command -v pacman &>/dev/null; then
    log_warn "Hệ thống không sử dụng pacman, bỏ qua bước cài đặt tự động."
    return 0
  fi

  local core_pkgs=(
    stow              # Quản lý symlinks dotfiles
    git               # Quản lý mã nguồn
    git-delta         # Syntax highlighter cho git diff
    zsh               # Shell chính
    fuse2             # Hỗ trợ chạy các ứng dụng AppImage (Zalo, v.v.)
    wl-clipboard      # wl-copy, wl-paste cho Wayland
    fzf               # Fuzzy finder
    bat               # Syntax highlighting cat
    eza               # Modern ls thay thế
    chafa             # Image to terminal text/sixel converter cho lf previewer
    imv               # Image viewer cho Wayland
    tmux              # Terminal multiplexer
    neovim            # Text editor chính
    lf                # Terminal file manager
    fcitx5            # Bộ gõ framework
    fcitx5-bamboo     # Bộ gõ tiếng Việt Bamboo
    fcitx5-gtk        # Fcitx5 GTK module
    fcitx5-qt         # Fcitx5 Qt module
    fcitx5-configtool # GUI config cho Fcitx5
    poppler           # pdftoppm preview PDF trong lf
    ffmpegthumbnailer # Video previewer trong lf
    p7zip             # Giải nén 7z preview
    unzip             # Giải nén zip preview
    noise-suppression-for-voice # Bộ lọc khử ồn AI RNNoise LADSPA cho PipeWire
  )

  local missing_pkgs=()
  for pkg in "${core_pkgs[@]}"; do
    if ! pacman -Qi "$pkg" &>/dev/null; then
      missing_pkgs+=("$pkg")
    fi
  done

  if [ ${#missing_pkgs[@]} -eq 0 ]; then
    log_success "Toàn bộ các gói phụ thuộc thiết yếu đã được cài đặt đầy đủ."
    return 0
  fi

  log_info "Tìm thấy ${#missing_pkgs[@]} gói chưa được cài đặt: ${missing_pkgs[*]}"
  log_info "Đang tiến hành cài đặt qua pacman..."
  if sudo pacman -S --needed --noconfirm "${missing_pkgs[@]}"; then
    log_success "Đã cài đặt thành công tất cả các gói phụ thuộc."
  else
    log_warn "Một số gói có thể chưa cài được. Vui lòng kiểm tra lại kết nối mạng hoặc kho lưu trữ."
  fi
}

# ------------------------------------------------------------------------------
# 1. Cấu hình PAM Gnome-Keyring
# ------------------------------------------------------------------------------
setup_pam() {
  log_step "Bắt đầu cấu hình PAM cho gnome-keyring..."
  local pam_file="/etc/pam.d/login"

  if [ ! -f "$pam_file" ]; then
    log_error "Không tìm thấy file $pam_file."
    return 1
  fi

  # 1.1 Kiểm tra cài đặt gnome-keyring
  if ! command -v gnome-keyring-daemon &>/dev/null; then
    log_warn "gnome-keyring chưa được cài đặt."
    read -p "Bạn có muốn cài đặt gnome-keyring qua pacman không? [y/N]: " -n 1 -r
    echo ""
    if [[ $REPLY =~ ^[Yy]$ ]]; then
      sudo pacman -S --noconfirm gnome-keyring
    else
      log_info "Bỏ qua cấu hình PAM."
      return 0
    fi
  fi

  # 1.2 Kiểm tra nếu đã được cấu hình trước đó
  if grep -q "pam_gnome_keyring.so" "$pam_file"; then
    log_success "PAM gnome-keyring đã được cấu hình trước đó trong $pam_file (Bỏ qua)."
    return 0
  fi

  log_info "Cần quyền root để ghi vào $pam_file..."
  
  # Tạo bản sao lưu dự phòng
  sudo cp "$pam_file" "${pam_file}.bak"
  log_info "Đã sao lưu $pam_file thành ${pam_file}.bak"

  # Chèn dòng cấu hình
  sudo sed -i '/auth\s\+include\s\+system-local-login/a auth       optional     pam_gnome_keyring.so' "$pam_file"
  sudo sed -i '/session\s\+include\s\+system-local-login/a session    optional     pam_gnome_keyring.so auto_start' "$pam_file"

  # Cấu hình cho SDDM (Display Manager)
  local sddm_file="/etc/pam.d/sddm"
  if [ -f "$sddm_file" ] && ! grep -q "^-auth\s\+optional\s\+pam_gnome_keyring.so" "$sddm_file"; then
    log_info "Bổ sung cấu hình tự động mở khóa keyring cho SDDM..."
    sudo cp "$sddm_file" "${sddm_file}.bak"
    sudo sed -i '/auth\s\+include\s\+system-login/a -auth       optional    pam_gnome_keyring.so' "$sddm_file"
  fi

  # Kiểm tra lại
  if grep -q "pam_gnome_keyring.so" "$pam_file"; then
    log_success "Đã cấu hình PAM gnome-keyring thành công."
    log_warn "LƯU Ý: Hãy đảm bảo mật khẩu Keyring 'login' trùng khớp với mật khẩu user để tự động mở khóa."
  else
    log_error "Cấu hình PAM thất bại. Vui lòng kiểm tra lại file $pam_file."
    return 1
  fi
}

# ------------------------------------------------------------------------------
# 2. Cấu hình Docker
# ------------------------------------------------------------------------------
setup_docker() {
  log_step "Bắt đầu cấu hình Docker..."

  # 2.1 Kiểm tra cài đặt Docker
  if ! command -v docker &>/dev/null; then
    log_warn "Docker chưa được cài đặt trên hệ thống."
    read -p "Bạn có muốn cài đặt docker qua pacman không? [y/N]: " -n 1 -r
    echo ""
    if [[ $REPLY =~ ^[Yy]$ ]]; then
      sudo pacman -S --noconfirm docker
    else
      log_info "Bỏ qua cấu hình Docker."
      return 0
    fi
  fi

  local REAL_USER="${SUDO_USER:-$USER}"
  if [ "$REAL_USER" = "root" ]; then
    REAL_USER=$(logname 2>/dev/null || whoami)
  fi

  # 2.2. Tạo nhóm docker và thêm user
  local group_changed=false
  if ! getent group docker &>/dev/null; then
    log_info "Tạo nhóm 'docker'..."
    sudo groupadd docker
    log_success "Đã tạo nhóm 'docker'."
  fi

  if groups "$REAL_USER" | grep -q "\bdocker\b"; then
    log_success "User '$REAL_USER' đã nằm trong nhóm 'docker' từ trước (Bỏ qua)."
  else
    log_info "Thêm user '$REAL_USER' vào nhóm 'docker'..."
    sudo usermod -aG docker "$REAL_USER"
    log_success "Đã thêm user '$REAL_USER' vào nhóm 'docker'."
    group_changed=true
  fi

  # 2.3. Thiết lập socket activation cho Docker (không khởi động cùng hệ thống)
  local service_enabled=$(systemctl is-enabled docker.service 2>/dev/null)
  local socket_enabled=$(systemctl is-enabled docker.socket 2>/dev/null)
  local socket_active=$(systemctl is-active docker.socket 2>/dev/null)

  if [ "$service_enabled" != "enabled" ] && [ "$socket_enabled" = "enabled" ] && [ "$socket_active" = "active" ]; then
    log_success "Docker Socket Activation đã được thiết lập trước đó (Bỏ qua)."
  else
    log_info "Đang cấu hình Socket Activation (Chỉ khởi động Docker khi có lệnh gọi)..."
    # Dừng và tắt service thông thường
    sudo systemctl disable --now docker.service &>/dev/null
    # Bật và khởi động socket
    sudo systemctl enable --now docker.socket

    if systemctl is-active --quiet docker.socket; then
      log_success "Docker Socket đã được kích hoạt thành công."
    else
      log_error "Không thể kích hoạt docker.socket. Vui lòng kiểm tra bằng 'systemctl status docker.socket'."
    fi
  fi

  # Nhắc nhở nếu có thay đổi group
  if [ "$group_changed" = true ]; then
    echo ""
    log_warn "QUAN TRỌNG: Hãy chạy lệnh 'newgrp docker' hoặc đăng nhập lại để áp dụng quyền truy cập Docker không cần sudo!"
  fi
}

# ------------------------------------------------------------------------------
# 3. Cài đặt IME Tiếng Việt (Fcitx5 Bamboo)
# ------------------------------------------------------------------------------
setup_ime() {
  log_step "Kiểm tra và cài đặt bộ gõ tiếng Việt Fcitx5 Bamboo..."
  local ime_pkgs=(fcitx5 fcitx5-bamboo fcitx5-gtk fcitx5-qt fcitx5-configtool)
  local missing_ime=()
  for pkg in "${ime_pkgs[@]}"; do
    if ! pacman -Qi "$pkg" &>/dev/null; then
      missing_ime+=("$pkg")
    fi
  done

  if [ ${#missing_ime[@]} -gt 0 ]; then
    log_info "Đang cài đặt các gói fcitx5 còn thiếu: ${missing_ime[*]}..."
    sudo pacman -S --needed --noconfirm "${missing_ime[@]}"
    log_success "Đã cài đặt hoàn tất các gói fcitx5."
  else
    log_success "Các gói Fcitx5 và fcitx5-bamboo đã được cài đặt."
  fi
}

# ------------------------------------------------------------------------------
# 4. Cấu hình Pin ThinkPad
# ------------------------------------------------------------------------------
setup_battery() {
  log_step "Kiểm tra và cấu hình ngưỡng sạc pin ThinkPad..."
  if command -v battery-threshold &>/dev/null; then
    battery-threshold
  else
    log_warn "Chưa tìm thấy lệnh battery-threshold trong PATH."
  fi
}

# ------------------------------------------------------------------------------
# ------------------------------------------------------------------------------
# 5. Fix lỗi Kernel đồ họa lai (Hybrid Graphics) & NVIDIA Wayland Modeset
# ------------------------------------------------------------------------------
setup_gpu_fix() {
  log_step "Sửa lỗi Kernel boot đồ họa lai (i915 dpcd, ucsi_ccg & nvidia_drm modeset/fbdev)..."
  local cmdline_file="/etc/kernel/cmdline"
  
  if [ ! -f "$cmdline_file" ]; then
    log_warn "Không tìm thấy $cmdline_file. Hệ thống không sử dụng UKI chuẩn, bỏ qua..."
    return 1
  fi
  
  # i915.enable_dpcd_backlight=0 fix lỗi lspcon port D probe
  # ucsi_ccg.disable=1 fix lỗi nvidia i2c timeout khi nvidia GPU ngủ
  # nvidia_drm.modeset=1 và nvidia_drm.fbdev=1 fix màn hình nháy/loạn khung hình khi login Wayland sau khi update NVIDIA
  local params_to_add=()
  local current_cmdline=$(cat "$cmdline_file")

  for param in "i915.enable_dpcd_backlight=0" "ucsi_ccg.disable=1" "nvidia_drm.modeset=1" "nvidia_drm.fbdev=1"; do
    if ! echo "$current_cmdline" | grep -q "$param"; then
      params_to_add+=("$param")
    fi
  done
  
  if [ ${#params_to_add[@]} -eq 0 ]; then
    log_success "Toàn bộ tham số fix đồ họa lai và NVIDIA DRM đã được cấu hình đầy đủ (Bỏ qua)."
  else
    log_info "Thêm các tham số kernel còn thiếu: ${params_to_add[*]}..."
    sudo cp "$cmdline_file" "${cmdline_file}.bak"
    echo "$current_cmdline ${params_to_add[*]}" | sudo tee "$cmdline_file" >/dev/null
    
    log_info "Đang build lại Kernel Image... Quá trình này sẽ mất một lúc."
    if command -v limine-mkinitcpio &>/dev/null; then
      if sudo limine-mkinitcpio; then
        log_success "Đã build lại Kernel Image (Limine UKI) thành công. Vui lòng KHỞI ĐỘNG LẠI (Reboot) để áp dụng."
      else
        log_error "Lỗi khi chạy limine-mkinitcpio. Hãy kiểm tra lại cấu hình hệ thống."
      fi
    else
      if sudo mkinitcpio -P; then
        log_success "Đã build lại Kernel Image thành công. Vui lòng KHỞI ĐỘNG LẠI (Reboot) để áp dụng."
      else
        log_error "Lỗi khi chạy mkinitcpio. Hãy kiểm tra lại cấu hình hệ thống."
      fi
    fi
  fi
}

# ------------------------------------------------------------------------------
# 5. Đặt Zsh làm login shell
# ------------------------------------------------------------------------------
setup_shell() {
  log_step "Kiểm tra và cấu hình login shell..."

  local zsh_path
  zsh_path="$(command -v zsh 2>/dev/null || echo "")"

  if [ -z "$zsh_path" ]; then
    log_warn "Zsh chưa được cài đặt."
    read -p "Bạn có muốn cài đặt zsh qua pacman không? [y/N]: " -n 1 -r
    echo ""
    if [[ $REPLY =~ ^[Yy]$ ]]; then
      sudo pacman -S --noconfirm zsh
      zsh_path="$(command -v zsh)"
    else
      log_info "Bỏ qua cấu hình shell."
      return 0
    fi
  fi

  local current_shell
  current_shell="$(getent passwd "$USER" | cut -d: -f7)"

  if [ "$current_shell" = "$zsh_path" ]; then
    log_success "Login shell đã là Zsh ($zsh_path). Không cần thay đổi."
    return 0
  fi

  # Đảm bảo zsh nằm trong /etc/shells
  if ! grep -qx "$zsh_path" /etc/shells; then
    log_info "Thêm $zsh_path vào /etc/shells..."
    echo "$zsh_path" | sudo tee -a /etc/shells >/dev/null
  fi

  log_info "Đang chuyển login shell sang Zsh ($zsh_path)..."
  chsh -s "$zsh_path"

  if [ "$(getent passwd "$USER" | cut -d: -f7)" = "$zsh_path" ]; then
    log_success "Login shell đã được đặt thành Zsh."
    log_warn "QUAN TRỌNG: Đăng xuất và đăng nhập lại để áp dụng."
  else
    log_error "Không thể đổi login shell. Thử: chsh -s $zsh_path"
    return 1
  fi
}

# ------------------------------------------------------------------------------
# 6. Deploy dotfiles qua stow-safe
# ------------------------------------------------------------------------------
setup_stow() {
  log_step "Deploy dotfiles qua stow-safe..."

  # Kiểm tra và cài đặt GNU Stow nếu chưa có
  if ! command -v stow &>/dev/null; then
    log_info "GNU Stow chưa được cài đặt trên hệ thống."
    if ! sudo pacman -S --needed --noconfirm stow; then
      log_error "Không thể cài đặt 'stow'. Vui lòng chạy thủ công: sudo pacman -S stow"
      return 1
    fi
    log_success "Đã cài đặt GNU Stow."
  fi

  # Auto-resolve stow-safe if not yet in PATH (e.g. on fresh clone)
  if ! command -v stow-safe &>/dev/null; then
    local script_dir
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [ -f "$script_dir/stow-safe" ]; then
      export PATH="$script_dir:$PATH"
    else
      log_warn "Lệnh stow-safe chưa có trong PATH."
      return 1
    fi
  fi

  # Danh sách packages cần stow theo thứ tự ưu tiên
  local packages=(
    shell     # profile, zshenv, aliasrc (phải stow trước zsh)
    zsh       # .zshrc, .zprofile, env.zsh (cần ZDOTDIR từ shell)
    git       # ~/.config/git/config, ignore (aliases, delta diff, rebase)
    tmux
    nvim
    lf
    hypr      # bindings.lua (DWM hybrid), looknfeel.lua (fullscreen retention)
    brave     # ~/.config/brave-flags.conf (GPU acceleration, Wayland native, zero-copy)
    fcitx5
    opencode
    pipewire  # ~/.config/pipewire/pipewire.conf.d/99-input-denoising.conf (RNNoise AI denoiser)
    media     # mpv (auto cover art & MPRIS), ncmpcpp, mpd
    scripts   # phải stow sau shell để PATH có stow-safe
  )

  local success=0 failed=0

  for pkg in "${packages[@]}"; do
    echo ""
    log_info "→ stow-safe $pkg"
    if stow-safe "$pkg"; then
      ((success++))
    else
      log_error "Lỗi khi stow package: $pkg"
      ((failed++))
    fi
  done

  # Cấu hình Omarchy Topbar (MPRIS Media Widget) & Reload Hyprland
  if command -v omarchy &>/dev/null; then
    omarchy bar put omarchy.media --before omarchy.clock &>/dev/null || true
  fi

  if command -v hyprctl &>/dev/null; then
    hyprctl reload &>/dev/null || true
  fi

  if command -v fcitx5-remote &>/dev/null && fcitx5-remote --check &>/dev/null; then
    fcitx5-remote -r &>/dev/null || true
  fi

  # Khởi động lại PipeWire nếu có cấu hình mới để nạp RNNoise
  if command -v systemctl &>/dev/null; then
    systemctl --user restart pipewire wireplumber &>/dev/null || true
  fi

  echo ""
  log_success "Kết quả: $success thành công, $failed thất bại."
  if (( failed > 0 )); then
    log_info "Khôi phục package lỗi: stow-safe --restore <package>"
  fi
}

# ------------------------------------------------------------------------------
# MAIN
# ------------------------------------------------------------------------------
if [ $# -eq 0 ]; then
  show_help
  exit 1
fi

CMD=$1

case "$CMD" in
  pkgs|deps)
    setup_pkgs
    ;;
  shell)
    setup_shell
    ;;
  ime)
    setup_ime
    ;;
  stow)
    setup_stow
    ;;
  pam)
    setup_pam
    ;;
  docker)
    setup_docker
    ;;
  battery)
    setup_battery
    ;;
  gpu-fix)
    setup_gpu_fix
    ;;
  all)
    setup_pkgs
    echo ""
    setup_shell
    echo ""
    setup_ime
    echo ""
    setup_stow
    echo ""
    setup_pam
    echo ""
    setup_docker
    echo ""
    setup_battery
    echo ""
    setup_gpu_fix
    ;;
  *)
    show_help
    exit 1
    ;;
esac
