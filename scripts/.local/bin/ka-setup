#!/usr/bin/env bash
# ==============================================================================
# KA SYSTEM SETUP (ka-setup)
# Mô tả: Post-install autoconfig cho Arch Linux + DWM/X11 (ThinkPad X230)
# Sử dụng: ka-setup <command>
# Lệnh "ka-setup all" chạy toàn bộ quá trình cấu hình một lần.
# ==============================================================================

set -eEo pipefail

# --- Colors ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

# --- Root Check ---
if [ "$EUID" -eq 0 ]; then
  echo -e "${RED}[ERROR]${NC}   Vui lòng KHÔNG chạy ka-setup bằng quyền root/sudo." >&2
  echo "Chạy bình thường dưới user của bạn: ./scripts/.local/bin/ka-setup all" >&2
  echo "Script sẽ tự động yêu cầu sudo khi thực sự cần thiết." >&2
  exit 1
fi

log_info()    { echo -e "${BLUE}[INFO]${NC}    $1"; }
log_success() { echo -e "${GREEN}[OK]${NC}      $1"; }
log_warn()    { echo -e "${YELLOW}[WARN]${NC}    $1"; }
log_error()   { echo -e "${RED}[ERROR]${NC}   $1" >&2; }
log_step()    { echo -e "\n${CYAN}${BOLD}▸ $1${NC}"; }
log_dim()     { echo -e "${DIM}  $1${NC}"; }

# --- Detect dotfiles root (script sống tại <dotfiles>/scripts/.local/bin/ka-setup) ---
_SCRIPT_REAL="$(readlink -f "${BASH_SOURCE[0]}")"
_SCRIPT_DIR="$(cd "$(dirname "$_SCRIPT_REAL")" && pwd)"
DOTFILES_DIR="$(cd "$_SCRIPT_DIR/../../.." && pwd)"

show_help() {
  echo -e "${BOLD}ka-setup — DWM/X11 System Autoconfig (ThinkPad X230)${NC}"
  echo "================================================================="
  echo ""
  echo -e "${BOLD}SỬ DỤNG:${NC}"
  echo "  ka-setup <command> [options]"
  echo ""
  echo -e "${BOLD}COMMANDS:${NC}"
  echo -e "  ${GREEN}all [profile]${NC}   Chạy toàn bộ quy trình cấu hình (mặc định: core)"
  echo -e "  ${GREEN}pkgs [profile]${NC}  Cài đặt gói từ progs.csv theo profile hoặc tier"
  echo -e "                    Profiles:"
  echo -e "                      core    (Nền tảng DWM/X11, Fonts, Shell, Audio, Trình duyệt) [Mặc định]"
  echo -e "                      dev     (Neovim, VSCode, Rust, Clang, Node, LazyGit...)"
  echo -e "                      media   (MPD, ncmpcpp, OBS Studio, yt-dlp...)"
  echo -e "                      tools   (Pandoc, Calibre, Telegram, Anki...)"
  echo -e "                      virt    (Docker, Libvirt, QEMU, Lazydocker...)"
  echo -e "                      sys     (Tiện ích hệ thống, Bluetooth, Máy in...)"
  echo -e "                      all     (Toàn bộ 200+ gói trong progs.csv)"
  echo -e "                    Hoặc theo số Tier: 1, 2, 1,2,3... hoặc deps: dwm, lf, zsh..."
  echo -e "  ${GREEN}shell${NC}          Đặt Zsh làm login shell mặc định"
  echo -e "  ${GREEN}stow${NC}           Deploy tất cả dotfiles qua stow-safe"
  echo -e "  ${GREEN}suckless${NC}       Biên dịch (make install) DWM, ST, Dmenu, Dwmblocks"
  echo -e "  ${GREEN}pam${NC}            Cấu hình gnome-keyring tự động mở khóa tại TTY"
  echo -e "  ${GREEN}brave${NC}          Tạo/kiểm tra brave-flags.conf tối ưu cho X11 + HD4000"
  echo -e "  ${GREEN}battery${NC}        Cấu hình ngưỡng sạc pin ThinkPad (50-60%)"
  echo -e "  ${GREEN}docker${NC}         Cấu hình Docker non-root + socket activation"
  echo ""
  echo -e "${BOLD}DOTFILES:${NC}  ${DIM}$DOTFILES_DIR${NC}"
  echo -e "${BOLD}PROGS CSV:${NC} ${DIM}$DOTFILES_DIR/progs.csv${NC}"
}

# --- Helper: Tìm hoặc bootstrap AUR helper (yay-bin) ---
get_aur_helper() {
  if command -v yay &>/dev/null; then
    echo "yay"
    return 0
  fi
  if command -v paru &>/dev/null; then
    echo "paru"
    return 0
  fi

  log_info "Chưa tìm thấy yay/paru. Tự động biên dịch yay-bin từ AUR..."
  local build_dir
  build_dir="$(mktemp -d)"
  if git clone https://aur.archlinux.org/yay-bin.git "$build_dir/yay-bin"; then
    (
      cd "$build_dir/yay-bin"
      makepkg -si --noconfirm
    )
    rm -rf "$build_dir"
    if command -v yay &>/dev/null; then
      log_success "Đã cài đặt yay-bin thành công."
      echo "yay"
      return 0
    fi
  fi
  rm -rf "$build_dir"
  log_warn "Không thể tự động cài đặt yay-bin. Cần cài thủ công."
  return 1
}

# ==============================================================================
# 0. CÀI ĐẶT GÓI PHỤ THUỘC (Đọc từ progs.csv)
# ==============================================================================
setup_pkgs() {
  local target="${1:-}"
  local progs_file="$DOTFILES_DIR/progs.csv"

  if [ ! -f "$progs_file" ]; then
    log_error "Không tìm thấy file danh sách gói: $progs_file"
    return 1
  fi

  if ! command -v pacman &>/dev/null; then
    log_warn "Hệ thống không dùng pacman — bỏ qua bước cài đặt tự động."
    return 0
  fi

  # Interactive prompt nếu người dùng chạy "ka-setup pkgs" không tham số tại terminal
  if [ -z "$target" ]; then
    if [ -t 0 ]; then
      echo -e "${BOLD}Chọn profile gói cài đặt từ progs.csv:${NC}"
      echo -e "  ${GREEN}1) core${NC}   Nền tảng DWM/X11, Fonts, Shell, Audio, Trình duyệt [Mặc định]"
      echo -e "  ${GREEN}2) dev${NC}    Công cụ lập trình (Neovim, VSCode, Rust, Clang, Node, LazyGit...)"
      echo -e "  ${GREEN}3) media${NC}  Nghe nhạc, xem phim, quay màn hình (MPD, ncmpcpp, OBS, yt-dlp...)"
      echo -e "  ${GREEN}4) tools${NC}  Văn phòng, đọc sách, ghi chú (Pandoc, Calibre, Telegram, Anki...)"
      echo -e "  ${GREEN}5) virt${NC}   Máy ảo & Containers (Docker, QEMU, Libvirt, Lazydocker...)"
      echo -e "  ${GREEN}6) sys${NC}    Tiện ích hệ thống mở rộng, Bluetooth, Máy in..."
      echo -e "  ${GREEN}7) all${NC}    Toàn bộ 200+ gói trong progs.csv"
      printf "${YELLOW}Lựa chọn [1-7] (mặc định 1): ${NC}"
      read -r choice
      case "$choice" in
        2|dev)   target="dev" ;;
        3|media) target="media" ;;
        4|tools) target="tools" ;;
        5|virt)  target="virt" ;;
        6|sys)   target="sys" ;;
        7|all)   target="all" ;;
        *)       target="core" ;;
      esac
    else
      target="core"
    fi
  fi

  log_step "Lọc danh sách gói theo profile [$target] từ progs.csv..."

  local pacman_pkgs=()
  local aur_pkgs=()

  local old_ifs="$IFS"
  while IFS=, read -r tag name tier deps purpose || [ -n "$name" ]; do
    [[ -z "$name" || "$tag" =~ ^# ]] && continue
    tag="${tag// /}"
    name="${name// /}"
    tier="${tier// /}"
    deps="${deps// /}"

    local match=false
    if [ "$target" = "all" ]; then
      match=true
    elif [ "$target" = "core" ]; then
      case "$deps" in
        core|dwm|st|dmenu|dwmblocks|lf|zsh|fcitx5|pipewire|zathura|intel|"dwm,st"|"lf,zathura")
          match=true
          ;;
      esac
    elif [ "$target" = "dev" ]; then
      [ "$tier" = "4" ] || [ "$deps" = "dev" ] && match=true
    elif [ "$target" = "media" ]; then
      [ "$tier" = "6" ] || [ "$deps" = "media" ] || [ "$name" = "yt-dlp" ] && match=true
    elif [ "$target" = "tools" ]; then
      [ "$tier" = "8" ] && match=true
    elif [ "$target" = "virt" ]; then
      [ "$tier" = "9" ] || [ "$deps" = "virt" ] && match=true
    elif [ "$target" = "sys" ]; then
      [ "$tier" = "11" ] || [ "$tier" = "1" ] || [ "$deps" = "sys" ] && match=true
    elif [[ "$target" =~ ^[0-9,]+$ ]]; then
      local t_arr=()
      IFS="," read -ra t_arr <<< "$target"
      IFS="$old_ifs"
      for t in "${t_arr[@]}"; do
        [ "$tier" = "$t" ] && match=true && break
      done
    else
      if [[ "$deps" == *"$target"* ]]; then
        match=true
      fi
    fi

    [ "$match" = false ] && continue

    case "$tag" in
      ""|"M") pacman_pkgs+=("$name") ;;
      "A")    aur_pkgs+=("$name") ;;
      "G")    ;;
    esac
  done < "$progs_file"
  IFS="$old_ifs"

  # --- 1. Kiểm tra và cài đặt gói từ kho chính thức Arch (pacman) ---
  local missing=()
  for pkg in "${pacman_pkgs[@]}"; do
    if ! pacman -Qi "$pkg" &>/dev/null 2>&1; then
      missing+=("$pkg")
    fi
  done

  if [ ${#missing[@]} -gt 0 ]; then
    log_info "Profile '$target': Thiếu ${#missing[@]}/${#pacman_pkgs[@]} gói pacman."
    log_dim "Gói thiếu: ${missing[*]}"
    printf "${YELLOW}Cài đặt? [Y/n]: ${NC}"
    read -r ans
    if [[ ! "$ans" =~ ^[Nn] ]]; then
      if sudo pacman -S --needed --noconfirm "${missing[@]}"; then
        log_success "Đã cài đặt xong các gói pacman."
      else
        log_warn "Một số gói pacman không thể cài. Kiểm tra lại kết nối mạng hoặc mirrorlist."
      fi
    else
      log_warn "Bỏ qua cài đặt gói pacman."
    fi
  else
    log_success "Profile '$target': Toàn bộ ${#pacman_pkgs[@]} gói pacman đã có sẵn."
  fi

  # --- 2. Kiểm tra và cài đặt gói AUR ---
  local missing_aur=()
  for pkg in "${aur_pkgs[@]}"; do
    pacman -Qi "$pkg" &>/dev/null || missing_aur+=("$pkg")
  done

  if [ ${#missing_aur[@]} -gt 0 ]; then
    log_info "Profile '$target': Thiếu ${#missing_aur[@]}/${#aur_pkgs[@]} gói AUR."
    log_dim "AUR thiếu: ${missing_aur[*]}"
    local aur_helper=""
    aur_helper="$(get_aur_helper || true)"
    if [ -n "$aur_helper" ]; then
      log_info "Cài AUR packages qua $aur_helper..."
      if ! $aur_helper -S --needed --noconfirm "${missing_aur[@]}"; then
        log_warn "Cài đặt hàng loạt AUR gặp lỗi. Đang thử cài đặt từng gói riêng lẻ..."
        for apkg in "${missing_aur[@]}"; do
          if ! pacman -Qi "$apkg" &>/dev/null; then
            $aur_helper -S --needed --noconfirm "$apkg" || log_warn "Không thể cài gói AUR: $apkg"
          fi
        done
      fi
      log_success "Hoàn tất xử lý gói AUR."
    else
      log_warn "Thiếu AUR helper. Cài thủ công: yay -S ${missing_aur[*]}"
    fi
  else
    if [ ${#aur_pkgs[@]} -gt 0 ]; then
      log_success "Profile '$target': Toàn bộ ${#aur_pkgs[@]} gói AUR đã có sẵn."
    fi
  fi
}

# ==============================================================================
# 1. ĐẶT ZSH LÀM LOGIN SHELL
# ==============================================================================
setup_shell() {
  log_step "Cấu hình login shell..."

  local zsh_path
  zsh_path="$(command -v zsh 2>/dev/null || echo "")"

  if [ -z "$zsh_path" ]; then
    log_warn "Zsh chưa cài. Cài qua pacman trước (ka-setup pkgs)."
    return 1
  fi

  local current_shell
  current_shell="$(getent passwd "$USER" | cut -d: -f7)"

  if [ "$current_shell" = "$zsh_path" ]; then
    log_success "Login shell đã là Zsh ($zsh_path)."
    return 0
  fi

  # Đảm bảo zsh có trong /etc/shells
  if ! grep -qx "$zsh_path" /etc/shells; then
    log_info "Thêm $zsh_path vào /etc/shells..."
    echo "$zsh_path" | sudo tee -a /etc/shells >/dev/null
  fi

  log_info "Chuyển login shell → Zsh ($zsh_path)..."
  chsh -s "$zsh_path"
  log_success "Login shell đã đặt thành Zsh. Đăng xuất & đăng nhập lại để áp dụng."
}

# ==============================================================================
# 2. DEPLOY DOTFILES QUA STOW-SAFE
# ==============================================================================
setup_stow() {
  log_step "Deploy dotfiles qua stow-safe..."
  log_dim "Dotfiles dir: $DOTFILES_DIR"

  # --- Cài GNU Stow nếu chưa có ---
  if ! command -v stow &>/dev/null; then
    log_info "GNU Stow chưa có — đang cài..."
    sudo pacman -S --needed --noconfirm stow || {
      log_error "Không thể cài stow. Chạy thủ công: sudo pacman -S stow"
      return 1
    }
  fi

  # --- Bootstrap stow-safe vào PATH nếu chưa có ---
  # (Trường hợp clone mới, scripts/ chưa được stow, stow-safe chưa trong PATH)
  if ! command -v stow-safe &>/dev/null; then
    local stow_safe_bin="$_SCRIPT_DIR/stow-safe"
    if [ -f "$stow_safe_bin" ]; then
      export PATH="$_SCRIPT_DIR:$PATH"
      log_info "Bootstrap stow-safe từ: $stow_safe_bin"
    else
      log_error "Không tìm thấy stow-safe tại $stow_safe_bin"
      return 1
    fi
  fi

  # --- Đảm bảo các thư mục cơ sở tồn tại tránh GNU Stow gập cây (tree folding) ---
  mkdir -p "$HOME/.config" "$HOME/.local/bin" "$HOME/.local/share" "$HOME/.local/src"

  # --- Danh sách packages DWM/X11 theo thứ tự ưu tiên ---
  local packages=(
    shell         # profile, aliasrc, shortcutrc — phải đầu tiên (set PATH, ZDOTDIR)
    zsh           # .zshrc, .zprofile, env.zsh
    git           # ~/.config/git/config, ignore
    yay           # ~/.config/yay/config.json
    tmux          # tmux.conf
    nvim          # init.lua, lua/
    lf            # lfrc, scope, icons, cleaner
    brave         # ~/.config/brave-flags.conf (X11 + HD4000)
    input-method  # Fcitx5 + Bamboo: hotkeys, profile, classicui
    opencode      # 9Router AI gateway (nếu dùng)
    pipewire      # RNNoise mic denoising
    media         # mpv, ncmpcpp, mpd
    x11           # xinitrc, xprofile, xresources (với #include colors)
    picom         # compositor config
    rofi          # app launcher (alternative to dmenu)
    dunst         # notification daemon
    gtk           # GTK2/3 theme
    fontconfig    # font rendering
    nsxiv         # image viewer keybinds
    theme         # theme-set: 1 file màu → generate toàn bộ desktop
    desktop       # XDG mimeapps.list, user-dirs, custom .desktop handlers
    suckless      # suckless source code
    scripts       # ~/.local/bin/* — phải CUỐI CÙNG (stow-safe cần có trong PATH)
  )

  local success=0 failed=0 skipped=0

  for pkg in "${packages[@]}"; do
    local pkg_dir="$DOTFILES_DIR/$pkg"
    # Bỏ qua package không tồn tại trong dotfiles
    if [ ! -d "$pkg_dir" ]; then
      log_dim "Bỏ qua $pkg (không tìm thấy thư mục)"
      skipped=$((skipped + 1))
      continue
    fi

    echo ""
    log_info "→ stow-safe $pkg"
    if stow-safe "$pkg" 2>&1; then
      success=$((success + 1))
    else
      log_error "Lỗi khi stow: $pkg"
      failed=$((failed + 1))
    fi
  done

  # --- Post-stow: Reload DWM-related services ---
  echo ""
  log_step "Post-stow: Reload các dịch vụ..."

  # Reload xresources nếu có X session
  if command -v xrdb &>/dev/null && [ -f "$HOME/.config/x11/xresources" ]; then
    xrdb -merge "$HOME/.config/x11/xresources" 2>/dev/null && log_dim "xrdb merged"
  fi

  # Reload fcitx5 nếu đang chạy
  if command -v fcitx5-remote &>/dev/null; then
    fcitx5-remote -r 2>/dev/null && log_dim "fcitx5 reloaded" || true
  fi

  # Restart PipeWire nếu có RNNoise config mới
  if command -v systemctl &>/dev/null; then
    systemctl --user restart pipewire wireplumber 2>/dev/null && log_dim "pipewire restarted" || true
  fi

  # Áp dụng cấu hình GTK File Chooser (mới nhất lên đầu, thư mục gom nhóm)
  if command -v gsettings &>/dev/null; then
    for schema in org.gtk.Settings.FileChooser org.gtk.gtk4.Settings.FileChooser; do
      gsettings set "$schema" sort-column 'modified' 2>/dev/null || true
      gsettings set "$schema" sort-order 'descending' 2>/dev/null || true
      gsettings set "$schema" sort-directories-first true 2>/dev/null || true
    done
    log_dim "gtk filechooser settings applied (sort by modified descending)"
  fi

  echo ""
  log_success "Kết quả stow: ${success} thành công, ${failed} thất bại, ${skipped} bỏ qua."
  if (( failed > 0 )); then
    log_info "Khôi phục: stow-safe --restore <package>"
  fi
}

# ==============================================================================
# 2.5. BIÊN DỊCH SUCKLESS TOOLS (DWM, ST, DMENU, DWMBLOCKS)
# ==============================================================================
setup_suckless() {
  log_step "Biên dịch mã nguồn Suckless (DWM, ST, Dmenu, Dwmblocks)..."
  local src_dir="$HOME/.local/src"
  if [ ! -d "$src_dir" ]; then
    log_warn "Không tìm thấy thư mục $src_dir. Chắc chắn rằng package suckless đã được stow."
    return 1
  fi

  for tool in dwm st dmenu dwmblocks; do
    if [ -d "$src_dir/$tool" ]; then
      log_info "Đang biên dịch $tool..."
      (
        cd "$src_dir/$tool"
        local make_log="/tmp/make-${tool}.log"
        if sudo make clean install >"$make_log" 2>&1; then
          log_dim "Đã biên dịch $tool thành công"
        else
          log_error "Lỗi khi biên dịch $tool. Xem chi tiết tại $make_log:"
          cat "$make_log" >&2
        fi
      )
    else
      log_warn "Không tìm thấy source code cho $tool trong $src_dir"
    fi
  done
  log_success "Hoàn tất biên dịch Suckless tools."
}

# ==============================================================================
# 3. PAM GNOME-KEYRING (TTY auto-unlock, không SDDM)
# ==============================================================================
setup_pam() {
  log_step "Cấu hình PAM gnome-keyring cho TTY login..."

  local pam_file="/etc/pam.d/login"
  if [ ! -f "$pam_file" ]; then
    log_error "Không tìm thấy $pam_file."
    return 1
  fi

  if ! command -v gnome-keyring-daemon &>/dev/null; then
    log_warn "gnome-keyring chưa cài. Chạy: sudo pacman -S gnome-keyring"
    return 1
  fi

  if grep -q "pam_gnome_keyring.so" "$pam_file"; then
    log_success "PAM gnome-keyring đã được cấu hình sẵn — bỏ qua."
    return 0
  fi

  log_info "Cần quyền root để ghi vào $pam_file..."
  sudo cp "$pam_file" "${pam_file}.bak"
  sudo sed -i '/auth\s\+include\s\+system-local-login/a auth       optional     pam_gnome_keyring.so' "$pam_file"
  sudo sed -i '/session\s\+include\s\+system-local-login/a session    optional     pam_gnome_keyring.so auto_start' "$pam_file"

  if grep -q "pam_gnome_keyring.so" "$pam_file"; then
    log_success "Đã cấu hình PAM gnome-keyring thành công."
    log_warn "Đảm bảo password Keyring 'login' = password user để tự động mở khóa."
  else
    log_error "Cấu hình PAM thất bại. Kiểm tra: $pam_file"
    return 1
  fi
}

# ==============================================================================
# 4. BRAVE FLAGS TỐI ƯU X11 + INTEL HD 4000 (ThinkPad X230)
# ==============================================================================
setup_brave() {
  log_step "Cấu hình Brave Browser tối ưu X11 + Intel HD 4000..."

  local flags_file="$HOME/.config/brave-flags.conf"

  # Tạo thư mục nếu chưa có
  mkdir -p "$(dirname "$flags_file")"

  # Kiểm tra nếu đã được quản lý bởi stow (symlink)
  if [ -L "$flags_file" ]; then
    log_success "brave-flags.conf đã được quản lý bởi stow (symlink)."
    log_dim "Source: $(readlink -f "$flags_file")"
    return 0
  fi

  if [ -f "$flags_file" ]; then
    log_warn "File $flags_file đã tồn tại (không phải symlink)."
    log_info "Backup → ${flags_file}.bak"
    cp "$flags_file" "${flags_file}.bak"
  fi

  # Nếu package brave/ chưa được stow, tạo trực tiếp
  cat > "$flags_file" << 'EOF'
# ==============================================================================
# Brave Browser Flags — ThinkPad X230 (Intel HD 4000) + X11
# ==============================================================================

# --- GPU Rendering (X11 + HD4000 Ivy Bridge) ---
# Dùng OpenGL desktop thay vì EGL — ổn định hơn trên HD4000/Mesa
--use-gl=desktop

# GPU rasterization: Kéo rasterization sang GPU giảm tải CPU
--enable-gpu-rasterization

# Zero-copy: Tránh copy buffer giữa GPU↔CPU (tiết kiệm RAM bandwidth)
--enable-zero-copy

# Raster threads: X230 có 2 cores (4 HT) — 2 threads là optimal
--num-raster-threads=2

# --- Hardware Video Decode (VA-API, Intel HD4000 hỗ trợ H264/VP8) ---
# Bật để decode video bằng hardware → tiết kiệm CPU đáng kể
--enable-features=VaapiVideoDecoder
--enable-accelerated-video-decode

# --- Network Performance ---
# QUIC (HTTP/3) — giảm latency cho các site hỗ trợ
--enable-quic

# --- X11 Specific ---
# Tắt Ozone/Wayland (dùng X11 backend)
--ozone-platform=x11

# --- Fcitx5 IME (X11 mode cho tiếng Việt) ---
--gtk-version=4

# --- Memory / Performance cho máy cũ ---
# Chạy Network Service trong process chính — tiết kiệm RAM
--enable-features=NetworkServiceInProcess2

# Tắt GPU compositing log spam
--disable-logging

# Tắt ChromeOS video decoder (không dùng trên Linux thường)
--disable-features=UseChromeOSDirectVideoDecoder
EOF

  log_success "Đã tạo brave-flags.conf tối ưu cho X11 + HD4000."
  log_dim "File: $flags_file"
  log_warn "Khởi động lại Brave để áp dụng."
}

# ==============================================================================
# 5. THINKPAD BATTERY THRESHOLD
# ==============================================================================
setup_battery() {
  log_step "Cấu hình ngưỡng sạc pin ThinkPad..."

  # Tìm battery-threshold trong PATH hoặc trực tiếp trong dotfiles
  local bt_cmd=""
  command -v battery-threshold &>/dev/null && bt_cmd="battery-threshold"
  [ -z "$bt_cmd" ] && [ -f "$_SCRIPT_DIR/battery-threshold" ] && bt_cmd="$_SCRIPT_DIR/battery-threshold"
  [ -z "$bt_cmd" ] && [ -f "$DOTFILES_DIR/scripts/.local/bin/ka-battery" ] && bt_cmd="$DOTFILES_DIR/scripts/.local/bin/ka-battery"

  if [ -n "$bt_cmd" ]; then
    "$bt_cmd"
  else
    log_warn "Không tìm thấy battery-threshold. Chạy sau khi stow scripts/."
    log_dim "Hoặc chạy thủ công: stow-safe scripts && battery-threshold"
  fi
}

# ==============================================================================
# 6. DOCKER (non-root + socket activation)
# ==============================================================================
setup_docker() {
  log_step "Cấu hình Docker..."

  if ! command -v docker &>/dev/null; then
    log_warn "Docker chưa cài. Bỏ qua."
    return 0
  fi

  local REAL_USER="${SUDO_USER:-$USER}"
  [ "$REAL_USER" = "root" ] && REAL_USER=$(logname 2>/dev/null || echo "ka")

  # Tạo group docker nếu chưa có
  if ! getent group docker &>/dev/null; then
    sudo groupadd docker
    log_success "Đã tạo nhóm 'docker'."
  fi

  local group_changed=false
  if groups "$REAL_USER" | grep -q '\bdocker\b'; then
    log_success "User '$REAL_USER' đã trong nhóm docker."
  else
    sudo usermod -aG docker "$REAL_USER"
    log_success "Đã thêm '$REAL_USER' vào nhóm docker."
    group_changed=true
  fi

  # Socket activation (không auto-start docker daemon)
  local svc_enabled socket_enabled socket_active
  svc_enabled=$(systemctl is-enabled docker.service 2>/dev/null || echo "disabled")
  socket_enabled=$(systemctl is-enabled docker.socket 2>/dev/null || echo "disabled")
  socket_active=$(systemctl is-active docker.socket 2>/dev/null || echo "inactive")

  if [ "$svc_enabled" != "enabled" ] && [ "$socket_enabled" = "enabled" ] && [ "$socket_active" = "active" ]; then
    log_success "Docker socket activation đã được cấu hình."
  else
    log_info "Cấu hình socket activation (Docker chỉ khởi động khi cần)..."
    sudo systemctl disable --now docker.service &>/dev/null || true
    sudo systemctl enable --now docker.socket
    systemctl is-active --quiet docker.socket && \
      log_success "Docker socket đã kích hoạt." || \
      log_error "Không thể kích hoạt docker.socket."
  fi

  if [ "$group_changed" = true ]; then
    echo ""
    log_warn "Chạy 'newgrp docker' hoặc đăng nhập lại để dùng docker không cần sudo."
  fi
}

# ==============================================================================
# MAIN
# ==============================================================================
if [ $# -eq 0 ]; then
  show_help
  exit 0
fi

case "$1" in
  pkgs|deps)
    setup_pkgs "$2"
    ;;
  shell)
    setup_shell
    ;;
  stow)
    setup_stow
    ;;
  suckless)
    setup_suckless
    ;;
  pam)
    setup_pam
    ;;
  brave)
    setup_brave
    ;;
  battery)
    setup_battery
    ;;
  docker)
    setup_docker
    ;;
  all)
    _prof="${2:-core}"
    setup_pkgs "$_prof"
    echo ""
    setup_shell
    echo ""
    setup_stow
    echo ""
    setup_suckless
    echo ""
    setup_pam
    echo ""
    setup_brave
    echo ""
    setup_battery
    echo ""
    setup_docker
    echo ""
    log_success "=== ka-setup all HOÀN THÀNH (Profile: $_prof) ===="
    log_warn "Nếu đây là lần cài đầu tiên: hãy REBOOT để áp dụng PAM + shell changes."
    ;;
  --help|-h|help)
    show_help
    ;;
  *)
    log_error "Lệnh không hợp lệ: $1"
    echo ""
    show_help
    exit 1
    ;;
esac
