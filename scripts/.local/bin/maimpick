#!/usr/bin/env sh
# ==============================================================================
# maimpick — Menu chụp ảnh màn hình và trích xuất chữ (Screenshot & OCR Picker)
# Tương thích Rofi / dmenu qua ka-menu, ủy quyền cho shot và ka-ocr
# ==============================================================================

options="📐 Chụp vùng chọn (Area)
🪟 Chụp cửa sổ hiện tại (Window)
🖥 Chụp toàn màn hình (Full Screen)
📝 Trích xuất chữ từ vùng chọn (OCR)"

choice=$(printf "%s" "$options" | ka-menu -p "Chụp màn hình:")

case "$choice" in
  *"vùng chọn"*)      shot area ;;
  *"cửa sổ"*)        shot window ;;
  *"toàn màn hình"*) shot screen ;;
  *"Trích xuất chữ"*) ka-ocr ;;
  *) exit 0 ;;
esac
