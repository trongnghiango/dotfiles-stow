#!/bin/sh
# ==============================================================================
# clipboard-tray — Khay hệ thống cho Ka Clipboard Manager
# Tự động đồng bộ màu từ theme hiện tại và mở Rofi 2 cột khi click
# ==============================================================================

# Đảm bảo daemon ka-clip đang chạy ngầm
pgrep -f "ka-clip.*daemon" >/dev/null 2>&1 || ka-clip daemon &

# Màu sắc icon khay hệ thống (tự động nhận từ theme hiện tại nếu có)
ICON_COLOR="#458588"
THEME_CURRENT="${XDG_CONFIG_HOME:-$HOME/.config}/theme/colors/current.conf"
if [ -f "$THEME_CURRENT" ]; then
    RAW_ACCENT=$(grep -m1 '^ACCENT=' "$THEME_CURRENT" 2>/dev/null | cut -d= -f2 | cut -d# -f1 | tr -d '"'\'' ')
    [ -n "$RAW_ACCENT" ] && ICON_COLOR="#${RAW_ACCENT#\#}"
fi

SVG_FILE="/tmp/clipboard-icon.svg"
PNG_FILE="/tmp/clipboard-icon.png"

cat <<EOF >"$SVG_FILE"
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
<path fill-rule="evenodd" clip-rule="evenodd" d="M9 3C9 1.89543 9.89543 1 11 1H13C14.1046 1 15 1.89543 15 3V4H19C20.1046 4 21 4.89543 21 6V20C21 21.1046 20.1046 22 19 22H5C3.89543 22 3 21.1046 3 20V6C3 4.89543 3.89543 4 5 4H9V3ZM11 3H13V4H11V3ZM5 6H19V20H5V6Z" fill="$ICON_COLOR"/>
<path d="M7 9H17V11H7V9Z" fill="$ICON_COLOR"/>
<path d="M7 13H17V15H7V13Z" fill="$ICON_COLOR"/>
</svg>
EOF

# Render file PNG 22x22 để đảm bảo hiển thị sắc nét trên mọi khay hệ thống X11
if command -v magick >/dev/null 2>&1; then
    magick -background none "$SVG_FILE" "$PNG_FILE" 2>/dev/null || true
elif command -v convert >/dev/null 2>&1; then
    convert -background none "$SVG_FILE" "$PNG_FILE" 2>/dev/null || true
fi

TRAY_IMG="$PNG_FILE"
[ ! -f "$TRAY_IMG" ] && TRAY_IMG="$SVG_FILE"
[ ! -f "$TRAY_IMG" ] && TRAY_IMG="edit-paste"

# Khi click vào khay hệ thống: Gọi Rofi Clipboard Manager 2 cột
CMD="ka clip"

if command -v yad >/dev/null 2>&1; then
    exec yad --notification \
      --image="$TRAY_IMG" \
      --text="Clipboard History (Text & Images - Click to open)" \
      --command="$CMD"
fi
