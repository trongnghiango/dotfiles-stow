#!/usr/bin/env bash
# ==============================================================================
# DSH AGENT WRAPPER CHO OMARCHY & WAYLAND
# ==============================================================================
set -e

DSH_BIN="${HOME}/.local/bin/dsh"
if [[ ! -x "$DSH_BIN" ]]; then
  DSH_BIN="dsh"
fi

find_active_port() {
  # Ưu tiên port do người dùng chỉ định qua biến môi trường
  if [[ -n "${DSH_PORT:-}" ]] && ss -tuln | grep -q ":$DSH_PORT "; then
    echo "$DSH_PORT"
    return 0
  fi
  # Tự động nhận diện port 3080 hoặc 3081 đang hoạt động
  if ss -tuln | grep -q ":3080 "; then
    echo "3080"
    return 0
  fi
  if ss -tuln | grep -q ":3081 "; then
    echo "3081"
    return 0
  fi
  echo "${DSH_PORT:-3080}"
}

ensure_server() {
  local target_port="$1"
  if ! ss -tuln | grep -q ":$target_port "; then
    notify-send -a "Omarchy AI" -i "dialog-information" "DeepSeek Harness" "Đang khởi động DSH Daemon (: $target_port)..."
    nohup "$DSH_BIN" web --port "$target_port" >/dev/null 2>&1 &
    # Chờ tối đa 3 giây để server lắng nghe trên cổng
    for _ in {1..15}; do
      if ss -tuln | grep -q ":$target_port "; then break; fi
      sleep 0.2
    done
  fi
}

PORT=$(find_active_port)
URL="http://127.0.0.1:$PORT"

case "${1:-}" in
  --web)
    ensure_server "$PORT"
    exec omarchy-launch-or-focus-webapp "DeepSeek" "$URL"
    ;;
  --inline)
    shift || true
    exec "$DSH_BIN" "$@"
    ;;
  --tui)
    shift || true
    exec omarchy-launch-tui --app-id=org.omarchy.dsh "$DSH_BIN" "$@"
    ;;
  --float|*)
    # Mặc định khi gọi từ phím tắt: Focus hoặc mở Web GUI của DSH
    ensure_server "$PORT"
    exec omarchy-launch-or-focus-webapp "DeepSeek" "$URL"
    ;;
esac
