#!/usr/bin/env bash
# snapper-pacman-wrapper — Better pre/post snapshot pairing for pacman
# Install: place in /usr/local/bin/ and add hook to call this instead

set -euo pipefail

SNAPPER_CONFIG="${SNAPPER_CONFIG:-root}"
PRE_NUM_FILE="/var/log/snapper-pre-num"

case "${1:-}" in
  pre)
    # Create pre snapshot and save its number
    NUM=$(snapper -c "$SNAPPER_CONFIG" create --type pre --number-cleanup=number --description "pacman update" --print-number)
    echo "$NUM" > "$PRE_NUM_FILE"
    echo "Created pre-snapshot #$NUM"
    ;;
  post)
    # Create post snapshot linked to pre
    PRE_NUM=$(cat "$PRE_NUM_FILE" 2>/dev/null || echo 0)
    if [[ "$PRE_NUM" -gt 0 ]]; then
      snapper -c "$SNAPPER_CONFIG" create --type post --pre-number="$PRE_NUM" --number-cleanup=number --description "pacman update"
      echo "Created post-snapshot linked to pre #$PRE_NUM"
    else
      snapper -c "$SNAPPER_CONFIG" create --type single --number-cleanup=number --description "pacman update (no pre)"
      echo "Created standalone post-snapshot (no pre found)"
    fi
    rm -f "$PRE_NUM_FILE"
    ;;
  *)
    echo "Usage: $0 {pre|post}"
    exit 1
    ;;
esac