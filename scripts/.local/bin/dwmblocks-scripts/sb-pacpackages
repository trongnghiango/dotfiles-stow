#!/bin/sh

# Displays number of upgradeable packages (supports Arch & Debian).

if command -v pacman >/dev/null 2>&1; then
	pkg_mgr="pacman"
elif command -v apt-get >/dev/null 2>&1; then
	pkg_mgr="apt"
else
	exit 0
fi

case $BLOCK_BUTTON in
	1) setsid -f "$TERMINAL" -e sb-popupgrade ;;
	2)
		if [ "$pkg_mgr" = "pacman" ]; then
			notify-send "$(/usr/bin/pacman -Qu)"
		else
			notify-send "$(apt list --upgradable 2>/dev/null | tail -n +2)"
		fi
		;;
	3) notify-send "🎁 Upgrade module" "📦: number of upgradable packages
- Left click to upgrade packages
- Middle click to show upgradable packages" ;;
	6) setsid -f "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

if [ "$pkg_mgr" = "pacman" ]; then
	pacman -Qu 2>/dev/null | grep -Fcv "[ignored]" | sed "s/^/📦/;s/^📦0$//g"
else
	count=$(apt list --upgradable 2>/dev/null | tail -n +2 | wc -l)
	[ "$count" -gt 0 ] && echo "📦$count"
fi
