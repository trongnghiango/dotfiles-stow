#!/bin/sh

# ==========================================
# 1. XỬ LÝ SỰ KIỆN
# ==========================================
case ${BLOCK_BUTTON:-${BUTTON:-0}} in
1) setsid -f dwm-dropdown battery >/dev/null 2>&1 ;;
3) notify-send "Battery" "Left click: Popover\nScroll: Brightness" ;;
4) ifinstalled brightnessctl && brightnessctl -q set +1% >/dev/null 2>&1 ;;
5) ifinstalled brightnessctl && brightnessctl -q set 1%- >/dev/null 2>&1 ;;
6) setsid -f "$TERMINAL" -e "$EDITOR" "$0" >/dev/null 2>&1 ;;
esac

BAT="/sys/class/power_supply/BAT0"
[ ! -d "$BAT" ] && BAT="/sys/class/power_supply/BAT1"

STAT=$(cat "$BAT/status" 2>/dev/null)
CAP=$(cat "$BAT/capacity" 2>/dev/null)
CAP=${CAP:-100}

# ==========================================
# 2. XỬ LÝ ICON ĐƠN SẮC (OMARCHY STYLE)
# ==========================================
case "$STAT" in
"Charging")
  echo "󰂄"
  ;;
"Full")
  echo "󰁹"
  ;;
"Discharging")
  if [ "$CAP" -ge 90 ]; then
    echo "󰁹"
  elif [ "$CAP" -ge 70 ]; then
    echo "󰂁"
  elif [ "$CAP" -ge 50 ]; then
    echo "󰁿"
  elif [ "$CAP" -ge 30 ]; then
    echo "󰁽"
  elif [ "$CAP" -ge 15 ]; then
    echo "󰁻"
  else
    # Pin yếu dưới 15%: Cảnh báo đỏ
    echo "^C1^󰁺^d^"
  fi
  ;;
*)
  echo "󰂃"
  ;;
esac
