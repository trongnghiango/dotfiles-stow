#!/usr/bin/env python3
"""
dwm-dropdown: Unified Omarchy-style GUI Popover Cards for DWM / dwmblocks.
Pure Native GTK3 popover cards with 0px border-radius, 2px accent border,
and auto-theming from ~/.config/theme/colors/current.conf.

Modules:
  - volume   : Master volume slider, mute toggle, sink output selector
  - clock    : Current time, full date, interactive calendar, uptime
  - battery  : Battery gauge, charging status, display brightness slider
  - cpu      : Overall CPU load, thermal sensors, fan speed, top CPU processes
  - memory   : RAM & Swap gauges, cache info, top memory-hog processes
  - network  : Active Wi-Fi/Ethernet status, signal bar, local IP, live traffic
  - forecast : Weather condition card, temp, feels like, humidity, wind, pressure
"""

import os
import sys
import re
import time
import json
import signal
import socket
import atexit
import subprocess

# ==============================================================================
# FAST PATH: UNIX DOMAIN SOCKET CLIENT (< 2ms response)
# ==============================================================================
_xdg_runtime = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
_daemon_sock = os.path.join(_xdg_runtime, f"ka-daemon-{os.getuid()}.sock")
_legacy_sock = os.path.join(_xdg_runtime, f"dwm-dropdown-{os.getuid()}.sock")
SOCKET_PATH = _daemon_sock if os.path.exists(_daemon_sock) else _legacy_sock

is_daemon = len(sys.argv) > 1 and sys.argv[1].lower() in ("--daemon", "-d", "daemon")

if not is_daemon and len(sys.argv) > 1:
    _target = sys.argv[1].lower()
    try:
        _sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        _sock.settimeout(0.06)
        _sock.connect(SOCKET_PATH)
        _payload = json.dumps({"action": "toggle", "target": _target}) + "\n"
        _sock.sendall(_payload.encode("utf-8"))
        _resp = _sock.recv(64)
        _sock.close()
        sys.exit(0)
    except Exception:
        # Daemon is not active -> fallback to standalone GTK below
        pass

