# 2. CLOCK & CALENDAR MODULE
# ==============================================================================
class ClockDropdown(BaseDropdown):
    def __init__(self):
        super().__init__("clock", min_width=320)

        # Uptime badge
        uptime_str = self.get_uptime()
        uptime_badge = Gtk.Label(label=f"up {uptime_str}")
        uptime_badge.get_style_context().add_class("badge")

        now_time = time.strftime("%I:%M %p")
        now_date = time.strftime("%A, %d %B %Y")
        self.build_header(now_time, now_date, uptime_badge)

        # Interactive Calendar
        self.calendar = Gtk.Calendar()
        self.calendar.set_display_options(
            Gtk.CalendarDisplayOptions.SHOW_HEADING
            | Gtk.CalendarDisplayOptions.SHOW_DAY_NAMES
        )
        self.main_box.pack_start(self.calendar, True, True, 0)

        # Quick Timezone / Local details
        tz_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        tz_box.get_style_context().add_class("card-tile")

        tz_lbl = Gtk.Label(label="Timezone", xalign=0)
        tz_lbl.get_style_context().add_class("stat-label")
        tz_box.pack_start(tz_lbl, True, True, 0)

        tz_name = time.tzname[0] if time.tzname else "Local"
        tz_val = Gtk.Label(label=f"{tz_name} (UTC{time.strftime('%z')})", xalign=1)
        tz_val.get_style_context().add_class("stat-val")
        tz_box.pack_end(tz_val, False, False, 0)

        self.main_box.pack_start(tz_box, False, False, 0)
        self.build_footer("Esc to close")

    def get_uptime(self):
        try:
            with open("/proc/uptime", "r") as f:
                secs = float(f.readline().split()[0])
            hrs = int(secs // 3600)
            mins = int((secs % 3600) // 60)
            return f"{hrs}h {mins}m"
        except Exception:
            return "unknown"


