    def query_network_status(self):
        sig = 0
        if os.path.exists("/proc/net/wireless"):
            try:
                with open("/proc/net/wireless") as f:
                    for line in f:
                        if line.strip().startswith("w"):
                            parts = line.split()
                            if len(parts) >= 3:
                                sig = int(float(parts[2].replace(".", "")) * 100 / 70)
                                sig = min(100, max(0, sig))
                            break
            except Exception:
                pass

        dev = "wlp3s0"
        if os.path.exists("/proc/net/route"):
            try:
                with open("/proc/net/route") as f:
                    for line in f:
                        fields = line.split()
                        if len(fields) >= 2 and fields[1] == "00000000":
                            dev = fields[0]
                            break
            except Exception:
                pass

        ssid = "Disconnected"
        ip_addr = "Not connected"
        dns_list = []
        try:
            out = subprocess.check_output(
                ["nmcli", "-t", "-f", "GENERAL.CONNECTION,IP4.ADDRESS,IP4.DNS", "dev", "show", dev],
                text=True, stderr=subprocess.DEVNULL
            )
            for line in out.splitlines():
                if line.startswith("GENERAL.CONNECTION:"):
                    ssid = line.split(":", 1)[1].strip()
                elif line.startswith("IP4.ADDRESS"):
                    ip_addr = line.split(":", 1)[1].split("/")[0].strip()
                elif line.startswith("IP4.DNS"):
                    dns_list.append(line.split(":", 1)[1].strip())
        except Exception:
            pass

        return ssid, sig, dev, ip_addr, dns_list

    def get_dns_info(self, dev):
        dns_list = []
        try:
            out = subprocess.check_output(["nmcli", "dev", "show", dev], text=True, stderr=subprocess.DEVNULL)
            for line in out.splitlines():
                if "IP4.DNS" in line:
                    dns_list.append(line.split(":", 1)[1].strip())
        except Exception:
            pass

        current_dns_str = ", ".join(dns_list) if dns_list else "Automatic (DHCP)"
        provider = "dhcp"
        if "1.1.1.1" in current_dns_str:
            provider = "cloudflare"
        elif "8.8.8.8" in current_dns_str:
            provider = "google"
        elif dns_list:
            provider = "custom"

        return current_dns_str, provider

    def update_dns_display(self, preloaded_dns=None):
        if preloaded_dns is not None:
            dns_list = preloaded_dns
            current_dns_str = ", ".join(dns_list) if dns_list else "Automatic (DHCP)"
            provider = "dhcp"
            if "1.1.1.1" in current_dns_str:
                provider = "cloudflare"
            elif "8.8.8.8" in current_dns_str:
                provider = "google"
            elif dns_list:
                provider = "custom"
        else:
            current_dns_str, provider = self.get_dns_info(self.dev)

        prov_title = provider.upper()
        self.dns_status_lbl.set_markup(f"Active: <b>{current_dns_str}</b> ({prov_title})")

        for p_id, btn in self.dns_btns.items():
            ctx = btn.get_style_context()
            if p_id == provider:
                ctx.add_class("selected")
            else:
                ctx.remove_class("selected")

        if provider == "custom":
            self.custom_box.set_visible(True)
            if not self.custom_entry.get_text():
                self.custom_entry.set_text(current_dns_str.split(",")[0].strip())
        else:
            self.custom_box.set_visible(False)

    def on_dns_select(self, btn, p_id):
        if p_id == "custom":
            self.custom_box.set_visible(True)
            self.custom_entry.grab_focus()
            for k, b in self.dns_btns.items():
                ctx = b.get_style_context()
                if k == "custom":
                    ctx.add_class("selected")
                else:
                    ctx.remove_class("selected")
            return

        subprocess.run(["set-dns", p_id], stderr=subprocess.DEVNULL)
        self.update_dns_display()

    def on_apply_custom_dns(self, widget):
        val = self.custom_entry.get_text().strip()
        if val:
            subprocess.run(["set-dns", "custom", val], stderr=subprocess.DEVNULL)
            self.update_dns_display()

    def get_traffic(self):
        def format_bytes(n):
            if n < 1024:
                return f"{n} B"
            elif n < 1024 * 1024:
                return f"{n/1024:.1f} KB"
            else:
                return f"{n/(1024*1024):.1f} MB"
        try:
            rx_total = sum(int(open(p).read()) for p in [f"/sys/class/net/{d}/statistics/rx_bytes" for d in os.listdir("/sys/class/net") if d.startswith(("e", "w")) and os.path.exists(f"/sys/class/net/{d}/statistics/rx_bytes")])
            tx_total = sum(int(open(p).read()) for p in [f"/sys/class/net/{d}/statistics/tx_bytes" for d in os.listdir("/sys/class/net") if d.startswith(("e", "w")) and os.path.exists(f"/sys/class/net/{d}/statistics/tx_bytes")])
            return format_bytes(rx_total), format_bytes(tx_total)
        except Exception:
            return "0 B", "0 B"


