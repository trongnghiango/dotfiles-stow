class BatteryDropdown(BaseDropdown):
    def __init__(self):
        super().__init__("battery", min_width=340)

        bat_path = "/sys/class/power_supply/BAT0"
        if not os.path.exists(bat_path):
            bat_path = "/sys/class/power_supply/BAT1"

        status = "Unknown"
        capacity = 100
        power_now = 0
        if os.path.exists(bat_path):
            try:
                with open(f"{bat_path}/status") as f:
                    status = f.read().strip()
                with open(f"{bat_path}/capacity") as f:
                    capacity = int(f.read().strip())
                if os.path.exists(f"{bat_path}/power_now"):
                    with open(f"{bat_path}/power_now") as f:
                        power_now = int(f.read().strip()) / 1_000_000.0  # Watts
            except Exception:
                pass

        # Status badge
        badge = Gtk.Label(label=status)
        badge.get_style_context().add_class("badge")
        if status == "Charging":
            badge.get_style_context().add_class("success")
        elif capacity <= 20:
            badge.get_style_context().add_class("danger")

        self.build_header("Power & Battery", f"Battery Level: {capacity}%", badge)

        # Battery Progress Bar
        bar = Gtk.ProgressBar()
