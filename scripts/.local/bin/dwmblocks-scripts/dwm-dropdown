        temp_vbox.pack_start(self.desc_lbl, False, False, 0)
        tile.pack_start(temp_vbox, True, True, 0)
        self.main_box.pack_start(tile, False, False, 0)

        # Metrics Grid
        m_lbl = Gtk.Label(label="ATMOSPHERIC CONDITIONS", xalign=0)
        m_lbl.get_style_context().add_class("section-header")
        self.main_box.pack_start(m_lbl, False, False, 0)

        grid = Gtk.Grid()
        grid.set_column_spacing(12)
        grid.set_row_spacing(8)
        grid.set_column_homogeneous(True)
        grid.get_style_context().add_class("card-tile")

        self.metrics = {}
        def add_metric(row, col, key, lbl):
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            l = Gtk.Label(label=lbl, xalign=0)
            l.get_style_context().add_class("stat-label")
            v = Gtk.Label(label="--", xalign=0)
            v.get_style_context().add_class("stat-val")
            box.pack_start(l, False, False, 0)
            box.pack_start(v, False, False, 0)
            grid.attach(box, col, row, 1, 1)
            self.metrics[key] = v

        add_metric(0, 0, "humidity", "Humidity")
        add_metric(0, 1, "wind", "Wind Speed")
        add_metric(1, 0, "pressure", "Atm. Pressure")
        add_metric(1, 1, "visibility", "Visibility")

        self.main_box.pack_start(grid, False, False, 0)
        self.build_footer("Esc to close")

        self.load_weather()

    def load_weather(self):
        cache_file = os.path.expanduser("~/.cache/weatherreport")
        data = {}
        if os.path.exists(cache_file):
            try:
                with open(cache_file) as f:
                    data = json.load(f)
            except Exception:
                pass

        city = data.get("name", "Ho Chi Minh City")
        desc = "Partly Cloudy"
        if data.get("weather"):
            desc = data["weather"][0].get("description", "Clear").title()

        temp = data.get("main", {}).get("temp", 26.0)
        feels = data.get("main", {}).get("feels_like", temp)
        humidity = data.get("main", {}).get("humidity", 80)
        pressure = data.get("main", {}).get("pressure", 1010)
        wind = data.get("wind", {}).get("speed", 3.0)
        vis = data.get("visibility", 10000) // 1000

        self.sub_lbl.set_text(f"Govap, {city}")
        self.temp_lbl.set_text(f"{temp:.0f}°C")
        self.desc_lbl.set_text(f"{desc} (Feels like {feels:.0f}°C)")
        self.metrics["humidity"].set_text(f"{humidity}%")
        self.metrics["wind"].set_text(f"{wind} m/s")
        self.metrics["pressure"].set_text(f"{pressure} hPa")
        self.metrics["visibility"].set_text(f"{vis} km")

    def on_refresh(self, widget):
        widget.set_sensitive(False)
        widget.set_label("Updating...")
        subprocess.Popen(["ka-forecast"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        GLib.timeout_add(1500, self._finish_refresh)

    def _finish_refresh(self):
        self.load_weather()
        self.ref_btn.set_sensitive(True)
        self.ref_btn.set_label("󰖐 Refresh")
        subprocess.run(["pkill", "-RTMIN+14", "dwmblocks"], stderr=subprocess.DEVNULL)
        return False



