        self.main_box.pack_start(tile, False, False, 0)

        # Brightness Slider
        cur_bright, max_bright = self.get_brightness()
        if max_bright > 0:
            bright_lbl = Gtk.Label(label="DISPLAY BRIGHTNESS", xalign=0)
            bright_lbl.get_style_context().add_class("section-header")
            self.main_box.pack_start(bright_lbl, False, False, 0)

            bright_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            b_icon = Gtk.Label(label="󰃠")
            bright_row.pack_start(b_icon, False, False, 0)

            self.bright_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 5, 100, 1)
            self.bright_scale.set_draw_value(False)
            pct = round((cur_bright / max_bright) * 100)
            self.bright_scale.set_value(pct)
            self.bright_scale.connect("value-changed", self.on_brightness_changed)
            bright_row.pack_start(self.bright_scale, True, True, 0)

            self.b_pct_lbl = Gtk.Label(label=f"{pct}%", xalign=1)
            self.b_pct_lbl.get_style_context().add_class("stat-val")
            self.b_pct_lbl.set_size_request(44, -1)
            bright_row.pack_end(self.b_pct_lbl, False, False, 0)
            self.main_box.pack_start(bright_row, False, False, 0)

        self.build_footer("Scroll to adjust brightness • Esc to close")
        self.connect("scroll-event", self.on_scroll)

    def get_brightness(self):
        try:
            cur = int(subprocess.check_output(["brightnessctl", "get"], text=True).strip())
            m = int(subprocess.check_output(["brightnessctl", "max"], text=True).strip())
            return cur, m
        except Exception:
            return 0, 0

    def on_brightness_changed(self, scale):
        pct = int(scale.get_value())
        self.b_pct_lbl.set_text(f"{pct}%")
        subprocess.run(
            ["brightnessctl", "-q", "set", f"{pct}%"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )

    def on_scroll(self, widget, event):
        delta = 0
        if event.direction == Gdk.ScrollDirection.UP:
            delta = 3
        elif event.direction == Gdk.ScrollDirection.DOWN:
            delta = -3
        elif event.direction == Gdk.ScrollDirection.SMOOTH:
            _, _, dy = event.get_scroll_deltas()
            if dy < 0:
                delta = 3
            elif dy > 0:
                delta = -3
        if delta != 0 and hasattr(self, "bright_scale"):
            cur = self.bright_scale.get_value()
            self.bright_scale.set_value(max(5, min(100, cur + delta)))
        return True


