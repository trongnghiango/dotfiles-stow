        temp_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        self.temp_lbl = Gtk.Label(label="--°C", xalign=0)
        self.temp_lbl.get_style_context().add_class("metric-big")
        self.desc_lbl = Gtk.Label(label="Loading...", xalign=0)
        self.desc_lbl.get_style_context().add_class("stat-label")
