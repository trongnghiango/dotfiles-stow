    def load_data(self):
        self.update_stats()
        if not self.timer_id:
            self.timer_id = GLib.timeout_add(1500, self.update_stats)
        return False

    def update_stats(self):
        try:
            cpu_pct = self.calc_cpu_usage()
            temp_str, fan_str = self.get_sensors()
            procs = self.get_top_procs()

            if hasattr(self, "sub_lbl"):
                self.sub_lbl.set_text(f"Utilization: {cpu_pct:.1f}% • {temp_str}")
            self.bar.set_fraction(min(1.0, max(0.0, cpu_pct / 100.0)))
            ctx = self.bar.get_style_context()
            ctx.remove_class("danger")
            ctx.remove_class("warning")
            if cpu_pct >= 85:
                ctx.add_class("danger")
            elif cpu_pct >= 60:
                ctx.add_class("warning")

            self.temp_lbl.set_text(temp_str)
            self.fan_lbl.set_text(fan_str if fan_str else "N/A")

            for child in self.proc_tile.get_children():
                self.proc_tile.remove(child)

            if not procs:
                lbl = Gtk.Label(label="No processes found", xalign=0)
                lbl.get_style_context().add_class("stat-label")
                self.proc_tile.pack_start(lbl, False, False, 0)
            else:
                for p in procs:
                    row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
                    cmd_lbl = Gtk.Label(label=f"{p['pid']:>5}  {p['name']:<18}", xalign=0)
                    cmd_lbl.get_style_context().add_class("stat-label")
                    val_lbl = Gtk.Label(label=f"{p['cpu']}%", xalign=1)
                    val_lbl.get_style_context().add_class("stat-val")
                    row.pack_start(cmd_lbl, True, True, 0)
                    row.pack_end(val_lbl, False, False, 0)
                    self.proc_tile.pack_start(row, False, False, 0)

            self.proc_tile.show_all()
        except Exception:
            pass
        return True

    def calc_cpu_usage(self):
        stat_file = "/tmp/ka-cpu.stat"
        try:
            with open("/proc/stat") as f:
                flds = [float(x) for x in f.readline().split()[1:8]]
            cur_idle = flds[3] + flds[4]
            cur_total = sum(flds)

            if os.path.exists(stat_file):
                with open(stat_file) as f:
                    parts = f.read().split()
                if len(parts) >= 2:
                    prev_total, prev_idle = float(parts[0]), float(parts[1])
                    dt = cur_total - prev_total
                    di = cur_idle - prev_idle
                    if dt > 0:
                        try:
                            with open(stat_file, "w") as f:
                                f.write(f"{int(cur_total)} {int(cur_idle)}")
                        except Exception:
                            pass
                        return max(0.0, min(100.0, 100.0 * (dt - di) / dt))
        except Exception:
            pass
        return 0.0

    def get_sensors(self):
        temp, fan = "N/A", ""
        try:
            for d in os.listdir("/sys/class/hwmon"):
                name_file = f"/sys/class/hwmon/{d}/name"
                if os.path.exists(name_file):
                    name = open(name_file).read().strip()
                    if name == "coretemp":
                        t_file = f"/sys/class/hwmon/{d}/temp1_input"
                        if os.path.exists(t_file):
                            temp = f"+{int(open(t_file).read().strip())/1000.0:.1f}°C"
                    elif name == "thinkpad":
                        f_file = f"/sys/class/hwmon/{d}/fan1_input"
                        if os.path.exists(f_file):
                            fan = f"{open(f_file).read().strip()} RPM"
            if temp != "N/A":
                return temp, fan
        except Exception:
            pass
        try:
            out = subprocess.check_output(["sensors"], text=True, stderr=subprocess.DEVNULL)
            for line in out.splitlines():
                if "Package id 0:" in line:
                    temp = line.split(":")[1].split("(")[0].strip()
                elif "fan1:" in line:
                    fan = line.split(":")[1].strip()
        except Exception:
            pass
        return temp, fan

    def get_top_procs(self):
        procs = []
        try:
            out = subprocess.check_output(
                ["ps", "-eo", "pid,comm,%cpu", "--sort=-%cpu"],
                text=True, stderr=subprocess.DEVNULL
            )
            lines = out.strip().splitlines()[1:5]
            for l in lines:
                parts = l.split(None, 2)
                if len(parts) >= 3:
                    procs.append({"pid": parts[0], "name": parts[1][:16], "cpu": parts[2]})
        except Exception:
            pass
        return procs


