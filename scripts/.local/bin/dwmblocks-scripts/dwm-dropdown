        self.main_box.pack_start(p_lbl, False, False, 0)

        proc_tile = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        proc_tile.get_style_context().add_class("card-tile")

        procs = self.get_top_procs()
        for p in procs:
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
            cmd_lbl = Gtk.Label(label=f"{p['pid']:>5}  {p['name']:<18}", xalign=0)
            cmd_lbl.get_style_context().add_class("stat-label")
            val_lbl = Gtk.Label(label=f"{p['cpu']}%", xalign=1)
            val_lbl.get_style_context().add_class("stat-val")
            row.pack_start(cmd_lbl, True, True, 0)
            row.pack_end(val_lbl, False, False, 0)
            proc_tile.pack_start(row, False, False, 0)

        self.main_box.pack_start(proc_tile, False, False, 0)
        self.build_footer("Esc to close")

    def calc_cpu_usage(self):
        def sample():
            with open("/proc/stat") as f:
                l = f.readline()
            flds = [float(x) for x in l.split()[1:8]]
            return flds[3] + flds[4], sum(flds)
        try:
            i1, t1 = sample()
            time.sleep(0.08)
            i2, t2 = sample()
            dt, di = t2 - t1, i2 - i1
            return 100.0 * (dt - di) / dt if dt else 0.0
        except Exception:
            return 0.0

    def get_sensors(self):
        temp, fan = "N/A", ""
        try:
            out = subprocess.check_output(["sensors"], text=True, stderr=subprocess.DEVNULL)
            for line in out.splitlines():
                if "Package id 0:" in line:
                    temp = line.split(":")[1].split("(")[0].strip()
                elif "fan1:" in line:
                    fan = line.split(":")[1].strip()
        except Exception:
            pass
        return temp, fan

    def get_top_procs(self):
        procs = []
        try:
            out = subprocess.check_output(
                ["ps", "-eo", "pid,comm,%cpu", "--sort=-%cpu"],
                text=True, stderr=subprocess.DEVNULL
            )
            lines = out.strip().splitlines()[1:5]
            for l in lines:
                parts = l.split(None, 2)
                if len(parts) >= 3:
                    procs.append({"pid": parts[0], "name": parts[1][:16], "cpu": parts[2]})
        except Exception:
            pass
        return procs


