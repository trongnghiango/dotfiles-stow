            proc_tile.pack_start(row, False, False, 0)

        self.main_box.pack_start(proc_tile, False, False, 0)
        self.build_footer("Esc to close")

    def get_mem_stats(self):
        info = {}
        try:
            with open("/proc/meminfo") as f:
                for l in f:
                    pts = l.split(":")
                    if len(pts) == 2:
                        info[pts[0].strip()] = int(pts[1].strip().split()[0])
            total = info.get("MemTotal", 1) / 1024 / 1024
            avail = info.get("MemAvailable", info.get("MemFree", 0)) / 1024 / 1024
            used = total - avail
            st = info.get("SwapTotal", 0) / 1024 / 1024
            sf = info.get("SwapFree", 0) / 1024 / 1024
            su = st - sf
            return used, total, su, st
        except Exception:
            return 0, 1, 0, 1

    def get_top_procs(self):
        procs = []
        try:
            out = subprocess.check_output(
                ["ps", "-eo", "pid,comm,%mem,rss", "--sort=-%mem"],
                text=True, stderr=subprocess.DEVNULL
            )
            lines = out.strip().splitlines()[1:5]
            for l in lines:
                parts = l.split(None, 3)
                if len(parts) >= 4:
                    rss_mb = int(parts[3]) // 1024
                    procs.append({"pid": parts[0], "name": parts[1][:16], "mem": parts[2], "rss": rss_mb})
        except Exception:
            pass
        return procs


