def main():
    # Detach stdout and stderr from any inherited pipe (e.g. dwmblocks popen)
    try:
        devnull_fd = os.open(os.devnull, os.O_WRONLY)
        os.dup2(devnull_fd, 1)
        os.dup2(devnull_fd, 2)
        os.close(devnull_fd)
    except Exception:
        pass

    # Enforce strictly 1 dwm-dropdown instance at any given time
    my_pid = os.getpid()
    pid_file = "/tmp/dwm-dropdown.pid"
    if os.path.exists(pid_file):
        try:
            with open(pid_file, "r") as f:
                old_pid = int(f.read().strip())
            if old_pid != my_pid:
                cmd_file = f"/proc/{old_pid}/cmdline"
                if os.path.exists(cmd_file):
                    with open(cmd_file, "rb") as f:
                        cmd = f.read().decode(errors="ignore")
                    if "dwm-dropdown" in cmd:
                        try:
                            os.kill(old_pid, signal.SIGTERM)
                        except ProcessLookupError:
                            pass
        except Exception:
            pass

    try:
        with open(pid_file, "w") as f:
            f.write(str(my_pid))
    except Exception:
        pass

    def cleanup():
        try:
            if os.path.exists(pid_file):
                with open(pid_file) as f:
                    if int(f.read().strip()) == os.getpid():
                        os.remove(pid_file)
        except Exception:
            pass

    atexit.register(cleanup)

    if is_daemon:
        run_daemon()
        return

    target = sys.argv[1].lower() if len(sys.argv) > 1 else "volume"
    win = create_dropdown(target)
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


def create_dropdown(target):
    target = target.lower() if target else "volume"
    if target in ("volume", "audio", "vol", "sound"):
        return VolumeDropdown()
    elif target in ("clock", "calendar", "time", "date"):
        return ClockDropdown()
    elif target in ("battery", "power", "bat"):
        return BatteryDropdown()
    elif target in ("cpu", "proc", "load"):
        return CpuDropdown()
    elif target in ("memory", "mem", "ram"):
        return MemoryDropdown()
    elif target in ("network", "net", "internet", "traffic", "nettraf", "wifi"):
        return NetworkDropdown()
    elif target in ("forecast", "weather", "weath"):
        return ForecastDropdown()
    elif target in ("notify", "notification", "notifications", "nc"):
        return NotifyDropdown()
    else:
        return VolumeDropdown()


def run_daemon():
    server_sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server_sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    if os.path.exists(SOCKET_PATH):
        try:
            os.remove(SOCKET_PATH)
        except OSError:
            pass
    server_sock.bind(SOCKET_PATH)
    server_sock.listen(5)
    server_sock.setblocking(False)

    active_state = {"win": None, "target": None}

    def on_win_destroy(win):
        if active_state["win"] == win:
            active_state["win"] = None
            active_state["target"] = None

    def on_socket_readable(source, condition):
        try:
            conn, _ = server_sock.accept()
            conn.settimeout(0.2)
            data = conn.recv(1024).decode("utf-8").strip()
            if not data:
                conn.close()
                return True
            req = json.loads(data)
            target = req.get("target", "volume")

            # Toggle behavior
            if active_state["win"] and active_state["target"] == target:
                active_state["win"].destroy()
                active_state["win"] = None
                active_state["target"] = None
                conn.sendall(b"OK_TOGGLED\n")
                conn.close()
                return True

            if active_state["win"]:
                active_state["win"].destroy()
                active_state["win"] = None
                active_state["target"] = None

            win = create_dropdown(target)
            if win:
                active_state["win"] = win
                active_state["target"] = target
                win.connect("destroy", on_win_destroy)
                win.show_all()
                win.present()
                conn.sendall(b"OK_SHOWN\n")
            else:
                conn.sendall(b"ERR_UNKNOWN\n")
            conn.close()
        except Exception:
            try:
                conn.close()
            except Exception:
                pass
        return True

    GLib.io_add_watch(server_sock.fileno(), GLib.IO_IN, on_socket_readable)

    def cleanup():
        try:
            if os.path.exists(SOCKET_PATH):
                os.remove(SOCKET_PATH)
        except Exception:
            pass
    atexit.register(cleanup)

    Gtk.main()


if __name__ == "__main__":
    main()
