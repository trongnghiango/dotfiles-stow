        try:
            with open(pid_file, "r") as f:
                old_pid = int(f.read().strip())
            if old_pid != my_pid:
                try:
                    os.kill(old_pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
        except Exception:
            pass

    try:
        out = subprocess.check_output(["pgrep", "-f", "dwm-dropdown"], text=True)
        for p_str in out.split():
            p = int(p_str)
            if p != my_pid:
                try:
                    os.kill(p, signal.SIGKILL)
                except Exception:
                    pass
    except Exception:
        pass

    try:
        os.makedirs(os.path.dirname(pid_file), exist_ok=True)
        with open(pid_file, "w") as f:
            f.write(str(my_pid))
    except Exception:
        pass

    def cleanup():
        try:
            if os.path.exists(pid_file):
                with open(pid_file) as f:
                    if int(f.read().strip()) == os.getpid():
                        os.remove(pid_file)
        except Exception:
            pass

    atexit.register(cleanup)

    target = sys.argv[1].lower() if len(sys.argv) > 1 else "volume"

    if target in ("volume", "audio", "vol", "sound"):
        win = VolumeDropdown()
    elif target in ("clock", "calendar", "time", "date"):
        win = ClockDropdown()
    elif target in ("battery", "power", "bat"):
        win = BatteryDropdown()
    elif target in ("cpu", "proc", "load"):
        win = CpuDropdown()
    elif target in ("memory", "mem", "ram"):
        win = MemoryDropdown()
    elif target in ("network", "net", "internet", "traffic", "nettraf", "wifi"):
        win = NetworkDropdown()
    elif target in ("forecast", "weather", "weath"):
        win = ForecastDropdown()
    else:
        win = VolumeDropdown()

    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
