    def update_stats(self):
        try:
            ram_used, ram_total, swap_used, swap_total = self.get_mem_stats()
            ram_pct = (ram_used / ram_total * 100) if ram_total else 0
            swap_pct = (swap_used / swap_total * 100) if swap_total else 0

            if hasattr(self, "sub_lbl"):
                self.sub_lbl.set_text(f"RAM: {ram_used:.1f} GB / {ram_total:.1f} GB ({ram_pct:.0f}%)")

            self.ram_bar.set_fraction(min(1.0, ram_pct / 100.0))
            ctx = self.ram_bar.get_style_context()
            ctx.remove_class("danger")
            ctx.remove_class("warning")
            if ram_pct >= 85:
                ctx.add_class("danger")
            elif ram_pct >= 65:
                ctx.add_class("warning")

            self.swap_lbl.set_text(f"SWAP: {swap_used:.1f} GB / {swap_total:.1f} GB ({swap_pct:.0f}%)")
            self.swap_bar.set_fraction(min(1.0, swap_pct / 100.0))

            procs = self.get_top_procs()
            for child in self.proc_tile.get_children():
                self.proc_tile.remove(child)

            if not procs:
                lbl = Gtk.Label(label="No processes found", xalign=0)
                lbl.get_style_context().add_class("stat-label")
                self.proc_tile.pack_start(lbl, False, False, 0)
            else:
                for p in procs:
                    row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
                    cmd_lbl = Gtk.Label(label=f"{p['pid']:>5}  {p['name']:<18}", xalign=0)
                    cmd_lbl.get_style_context().add_class("stat-label")
                    val_lbl = Gtk.Label(label=f"{p['rss']} MB ({p['mem']}%)", xalign=1)
                    val_lbl.get_style_context().add_class("stat-val")
                    row.pack_start(cmd_lbl, True, True, 0)
                    row.pack_end(val_lbl, False, False, 0)
                    self.proc_tile.pack_start(row, False, False, 0)

            self.proc_tile.show_all()
        except Exception:
            pass
        return True

    def get_mem_stats(self):
        info = {}
        try:
            with open("/proc/meminfo") as f:
                for l in f:
                    pts = l.split(":")
                    if len(pts) == 2:
                        info[pts[0].strip()] = int(pts[1].strip().split()[0])
            total = info.get("MemTotal", 1) / 1024 / 1024
            avail = info.get("MemAvailable", info.get("MemFree", 0)) / 1024 / 1024
            used = total - avail
            st = info.get("SwapTotal", 0) / 1024 / 1024
            sf = info.get("SwapFree", 0) / 1024 / 1024
            su = st - sf
            return used, total, su, st
        except Exception:
            return 0, 1, 0, 1

    def get_top_procs(self):
        procs = []
        try:
            out = subprocess.check_output(
                ["ps", "-eo", "pid,comm,%mem,rss", "--sort=-%mem"],
                text=True, stderr=subprocess.DEVNULL
            )
            lines = out.strip().splitlines()[1:5]
            for l in lines:
                parts = l.split(None, 3)
                if len(parts) >= 4:
                    rss_mb = int(parts[3]) // 1024
                    procs.append({"pid": parts[0], "name": parts[1][:16], "mem": parts[2], "rss": rss_mb})
        except Exception:
            pass
        return procs


