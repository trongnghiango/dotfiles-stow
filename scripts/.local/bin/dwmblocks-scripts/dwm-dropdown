class BaseDropdown(Gtk.Window):
    def __init__(self, name, min_width=340):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_wmclass("dwm-dropdown", "dwm-dropdown")
        self.set_title(f"dwm-dropdown-{name}")
        self.set_decorated(False)
        self.set_resizable(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_type_hint(Gdk.WindowTypeHint.DIALOG)

        self.colors = load_theme_colors()
        self.min_width = min_width

        self.setup_css()

        self.main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.main_box.get_style_context().add_class("popover-box")
        self.main_box.set_size_request(self.min_width, -1)
        self.add(self.main_box)

        self.connect("key-press-event", self.on_key_press)

    def setup_css(self):
        css_data = get_common_css(self.colors)
        provider = Gtk.CssProvider()
        provider.load_from_data(css_data.encode("utf-8"))
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

    def build_header(self, title, subtitle="", action_widget=None):
        header_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        title_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)

        title_lbl = Gtk.Label(label=title, xalign=0)
        title_lbl.get_style_context().add_class("title-label")
        title_vbox.pack_start(title_lbl, False, False, 0)

        if subtitle:
            self.sub_lbl = Gtk.Label(label=subtitle, xalign=0)
            self.sub_lbl.get_style_context().add_class("subtitle-label")
            title_vbox.pack_start(self.sub_lbl, False, False, 0)

        header_box.pack_start(title_vbox, True, True, 0)
        if action_widget:
            header_box.pack_end(action_widget, False, False, 0)

        self.main_box.pack_start(header_box, False, False, 0)
        return header_box

    def build_footer(self, hint="Esc to close"):
        footer_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        hint_lbl = Gtk.Label(label=hint, xalign=0)
        hint_lbl.get_style_context().add_class("footer-label")
        footer_box.pack_start(hint_lbl, True, True, 0)
        self.main_box.pack_start(footer_box, False, False, 0)

    def on_key_press(self, widget, event):
        if event.keyval in (Gdk.KEY_Escape, Gdk.KEY_q):
            self.close()
            return True
        return False


