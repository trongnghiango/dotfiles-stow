#!/usr/bin/env python3
"""
dwm-dropdown: Unified Omarchy-style GUI Popover Cards for DWM / dwmblocks.
Pure Native GTK3 popover cards with 0px border-radius, 2px accent border,
and auto-theming from ~/.config/theme/colors/current.conf.

Modules:
  - volume   : Master volume slider, mute toggle, sink output selector
  - clock    : Current time, full date, interactive calendar, uptime
  - battery  : Battery gauge, charging status, display brightness slider
  - cpu      : Overall CPU load, thermal sensors, fan speed, top CPU processes
  - memory   : RAM & Swap gauges, cache info, top memory-hog processes
  - network  : Active Wi-Fi/Ethernet status, signal bar, local IP, live traffic
  - forecast : Weather condition card, temp, feels like, humidity, wind, pressure
"""

import os
import sys
import re
import time
import json
import signal
import atexit
import subprocess
import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gtk, Gdk, GLib

GLib.set_prgname("dwm-dropdown")


def load_theme_colors():
    conf_path = os.path.expanduser("~/.config/theme/colors/current.conf")
    colors = {
        "BG": "2e3440",
        "FG": "d8dee9",
        "COLOR0": "3b4252",
        "COLOR1": "bf616a",
        "COLOR2": "a3be8c",
        "COLOR3": "ebcb8b",
        "COLOR4": "81a1c1",
        "COLOR8": "4c566a",
        "COLOR14": "8fbcbb",
        "COLOR15": "eceff4",
        "ACCENT": "88c0d0",
        "MODE": "dark",
    }
    if os.path.exists(conf_path):
        try:
            with open(conf_path, "r", encoding="utf-8") as f:
                for line in f:
                    line = line.strip()
                    if not line or line.startswith("#") or "=" not in line:
                        continue
                    k, v = line.split("=", 1)
                    k = k.strip()
                    v = v.split("#")[0].strip().strip('"').strip("'")
                    colors[k] = v
        except Exception:
            pass
    return colors


