#!/bin/sh

# --- 1. XỬ LÝ CLICK ---
case ${BLOCK_BUTTON:-${BUTTON:-0}} in
1) setsid -f dwm-dropdown cpu >/dev/null 2>&1 ;; # Click trái: Mở popover CPU
3)
  # Click phải: Lấy nhiệt độ từ sensors, làm đẹp và notify
  # Lọc lấy: Fan Speed, CPU Temp, Core Temp, Pin (nếu cần)
  INFO=$(sensors | awk '
            # Bắt dòng Fan
            /^fan1:/ { printf "🌪️ Fan: %s RPM\n", $2 }
            # Bắt dòng CPU (của thinkpad-isa)
            /^CPU:/ { printf "🔥 CPU Package: %s\n", $2 }
            # Bắt các Core (của coretemp-isa)
            /^Core 0:/ { printf "1️⃣ Core 0: %s\n", $3 }
            /^Core 1:/ { printf "2️⃣ Core 1: %s\n", $3 }
        ')
  notify-send "🌡️ Sensors Info (ThinkPad X230)" "$INFO"
  ;;
esac

# --- 2. TÍNH TOÁN CPU LOAD (Zero-Sleep Delta, phản hồi tức thì 0.001s) ---
STAT_FILE="/tmp/ka-cpu.stat"
read -r cpu a b c idle rest </proc/stat
total=$((a + b + c + idle))
cpu_usage=0

if [ -f "$STAT_FILE" ]; then
  read -r prevtotal previdle <"$STAT_FILE" 2>/dev/null || true
  if [ -n "$prevtotal" ] && [ -n "$previdle" ]; then
    diff_total=$((total - prevtotal))
    diff_idle=$((idle - previdle))
    if [ "$diff_total" -gt 0 ]; then
      cpu_usage=$((100 * (diff_total - diff_idle) / diff_total))
    fi
  fi
fi
echo "$total $idle" >"$STAT_FILE"

# --- 3. HIỂN THỊ ICON ĐƠN SẮC (OMARCHY STYLE) ---
ICON="󰍛"
if [ "$cpu_usage" -ge 80 ]; then
  echo "^C1^$ICON^d^"
else
  echo "$ICON"
fi
