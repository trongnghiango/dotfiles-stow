#!/bin/sh

case ${BLOCK_BUTTON:-${BUTTON:-0}} in
    1) setsid -f ka-pop clock >/dev/null 2>&1 ;;
    2) ifinstalled calcurse && setsid -f "$TERMINAL" -e calcurse >/dev/null 2>&1 ;;
    3) notify-send "📅 Time" "Left: Month view\nMiddle: Calcurse" ;;
    6) setsid -f "$TERMINAL" -e "$EDITOR" "$0" >/dev/null 2>&1 ;;
esac

echo "$(date '+%a · %H:%M')"
