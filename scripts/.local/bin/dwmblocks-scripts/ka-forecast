#!/usr/bin/env bash

LOCATION="Govap"
CACHE_FILE="$HOME/.cache/weatherreport"
[ ! -f "$CACHE_FILE" ] && touch "$CACHE_FILE"

# Hàm tải thời tiết (Chạy thật nhanh)
getforecast() {
  # Chạy curl trong subshell ngầm, không làm treo script chính
  (
    data=$(timeout 10s curl -s "https://api.openweathermap.org/data/2.5/weather?lat=10.847&lon=106.670&units=metric&appid=c817622e5f134df0ef6bb60d0b4864c0")
    if echo "$data" | jq -e . >/dev/null 2>&1; then
      echo "$data" >"$CACHE_FILE"
      # Tải xong thì gửi tín hiệu refresh cho dwmblocks (Signal 14)
      pkill -RTMIN+14 dwmblocks
    fi
  ) &
}

# Logic Update:
# Nếu cache cũ quá 30 phút -> Gọi hàm tải ngầm -> Script chính chạy tiếp luôn, không chờ.
if [ ! -s "$CACHE_FILE" ] || [ $(($(date +%s) - $(date -r "$CACHE_FILE" +%s))) -gt 1800 ]; then
  getforecast
fi

# Xử lý click chuột
case ${BLOCK_BUTTON:-${BUTTON:-0}} in
1) setsid -f dwm-dropdown forecast >/dev/null 2>&1 ;;
3) getforecast && notify-send "Weather" "Updating in background..." ;;
esac

# =========================================================
# PHẦN HIỂN THỊ (Luôn trả về ngay lập tức)
# =========================================================

weather_data=$(cat "$CACHE_FILE")

# Nếu chưa có dữ liệu (lần đầu khởi động) -> Hiện icon Loading
if [ -z "$weather_data" ]; then
  echo "󰖕"
  exit 0
fi

# Parse JSON (Nếu có dữ liệu)
raw_icon=$(echo "$weather_data" | jq -r '.weather[0].icon // "01d"' 2>/dev/null)
is_night=false
if [[ "$raw_icon" == *n* ]]; then
  is_night=true
fi
code=$(echo "$raw_icon" | tr -d 'nd')

# Map Icon theo chuẩn nhịp sinh học ngày/đêm (Circadian Glyphs)
case "$code" in
01)
  if [ "$is_night" = true ]; then
    ico="󰖔" # Mặt trăng đêm quang đãng
  else
    ico="󰖙" # Mặt trời ban ngày
  fi
  ;;
02)
  if [ "$is_night" = true ]; then
    ico="󰼱" # Mặt trăng sau mây
  else
    ico="󰖕" # Mặt trời sau mây
  fi
  ;;
03) ico="󰖐" ;; # Mây rải rác
04) ico="☁"  ;; # Nhiều mây
09) ico="󰖖" ;; # Mưa rào
10)
  if [ "$is_night" = true ]; then
    ico="󰖗" # Mưa đêm
  else
    ico="🌦" # Mưa rải rác ngày
  fi
  ;;
11) ico="󰙾" ;; # Giông sét
13) ico="󰖘" ;; # Tuyết
50) ico="󰖝" ;; # Sương mù
*)
  if [ "$is_night" = true ]; then
    ico="󰖔"
  else
    ico="󰖕"
  fi
  ;;
esac

echo "$ico"
