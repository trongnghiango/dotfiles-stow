#!/bin/sh
# ==============================================================================
# ifinstalled — Kiểm tra công cụ cần thiết trước khi thực thi
# Đọc hiểu trong 5s: Dùng command -v chuẩn POSIX, gửi thông báo nếu thiếu
# ==============================================================================
for cmd in "$@"; do
	if ! command -v "$cmd" >/dev/null 2>&1; then
		notify-send -u critical "📦 Thiếu công cụ" "Cần cài đặt: $cmd" 2>/dev/null || true
		exit 1
	fi
done
