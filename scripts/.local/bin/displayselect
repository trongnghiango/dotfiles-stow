#!/usr/bin/env sh
# ==============================================================================
# displayselect — Thiết lập cấu hình hiển thị đa màn hình (Multi-Monitor UI)
# Sử dụng ka-menu (Rofi / dmenu), giao tiếp xrandr trực tiếp
# ==============================================================================

# Lấy danh sách cổng màn hình đang kết nối
all_connected=$(xrandr -q | grep " connected")
screens=$(echo "$all_connected" | awk '{print $1}')
screen_count=$(echo "$screens" | wc -l)

postrun() {
  setbg 2>/dev/null || true
  pkill -x dunst 2>/dev/null || true
  setsid -f dunst >/dev/null 2>&1 &
}

onescreen() {
  target="$1"
  off_args=""
  for s in $screens; do
    [ "$s" != "$target" ] && off_args="$off_args --output $s --off"
  done
  xrandr --output "$target" --auto --scale 1.0x1.0 $off_args
}

twoscreen() {
  mirror=$(printf "Không\nCó" | ka-menu -p "Nhân bản (Mirror)?")
  if [ "$mirror" = "Có" ]; then
    primary=$(echo "$screens" | ka-menu -p "Màn hình chuẩn:")
    secondary=$(echo "$screens" | grep -v "^$primary$")
    xrandr --output "$primary" --auto --output "$secondary" --auto --same-as "$primary"
  else
    primary=$(echo "$screens" | ka-menu -p "Màn hình chính:")
    secondary=$(echo "$screens" | grep -v "^$primary$")
    pos=$(printf "Bên phải (Right)\nBên trái (Left)" | ka-menu -p "Vị trí của $secondary:")
    if [ "$pos" = "Bên phải (Right)" ]; then
      xrandr --output "$primary" --auto --scale 1.0x1.0 --output "$secondary" --right-of "$primary" --auto --scale 1.0x1.0
    else
      xrandr --output "$primary" --auto --scale 1.0x1.0 --output "$secondary" --left-of "$primary" --auto --scale 1.0x1.0
    fi
  fi
}

# Nếu chỉ có 1 màn hình: tự động nhận diện
if [ "$screen_count" -le 1 ]; then
  onescreen "$screens"
  postrun
  notify-send "💻 Màn hình" "Đã tối ưu hóa màn hình: $screens" 2>/dev/null || true
  exit 0
fi

# Người dùng chọn bố cục
menu_options="$screens
Bố cục đa màn hình (Multi-monitor)
Cấu hình thủ công (Arandr)"

chosen=$(printf "%s" "$menu_options" | ka-menu -p "Cấu hình màn hình:")

case "$chosen" in
  *"Arandr"*)
    command -v arandr >/dev/null 2>&1 && arandr
    exit 0
    ;;
  *"Multi-monitor"*)
    twoscreen
    ;;
  *)
    [ -n "$chosen" ] && onescreen "$chosen"
    ;;
esac

postrun
