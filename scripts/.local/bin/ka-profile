#!/usr/bin/env bash
# ==============================================================================
# ka-profile — Universal Hardware Profile Engine (Omarchy Architecture)
# Quản lý & tự động nhận diện cấu hình phần cứng (Laptop / Desktop / ThinkPad)
# ==============================================================================
set -euo pipefail

HARDWARE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/hardware"
PROFILES_DIR="$HARDWARE_DIR/profiles"
CURRENT_CONF="$HARDWARE_DIR/current.conf"

BOLD="\033[1m"
GREEN="\033[32m"
CYAN="\033[36m"
YELLOW="\033[33m"
RED="\033[31m"
DIM="\033[2m"
RESET="\033[0m"

ensure_dirs() {
    mkdir -p "$PROFILES_DIR"
}

get_dmi_field() {
    local field="$1"
    local path="/sys/class/dmi/id/$field"
    if [ -f "$path" ] && [ -r "$path" ]; then
        cat "$path" 2>/dev/null || echo ""
    else
        echo ""
    fi
}

detect_hardware() {
    local p_name p_ver chassis host
    p_name=$(get_dmi_field "product_name")
    p_ver=$(get_dmi_field "product_version")
    chassis=$(get_dmi_field "chassis_type")
    host=$(cat /etc/hostname 2>/dev/null || echo "")

    local combined="${p_name} ${p_ver} ${host}"

    if echo "$combined" | grep -qi "x230"; then
        echo "thinkpad-x230"
    elif echo "$combined" | grep -qi "t480"; then
        echo "thinkpad-t480"
    elif [[ "$chassis" =~ ^(8|9|10|11|14|30|31|32)$ ]]; then
        echo "generic-laptop"
    elif [ -d "/sys/class/power_supply/BAT0" ] || [ -d "/sys/class/power_supply/BAT1" ]; then
        echo "generic-laptop"
    else
        echo "generic-desktop"
    fi
}

cmd_detect() {
    ensure_dirs
    local detected
    detected=$(detect_hardware)
    echo -e "${CYAN}Tự động nhận diện phần cứng:${RESET} ${BOLD}$detected${RESET}"
    cmd_set "$detected"
}

cmd_set() {
    ensure_dirs
    local target="${1:-}"
    if [ -z "$target" ]; then
        echo -e "${RED}Lỗi: Vui lòng chỉ định tên profile!${RESET}" >&2
        cmd_list
        exit 1
    fi

    local target_file="$PROFILES_DIR/${target}.conf"
    if [ ! -f "$target_file" ]; then
        echo -e "${RED}Lỗi: Profile '$target' không tồn tại tại $target_file${RESET}" >&2
        cmd_list
        exit 1
    fi

    ln -sfn "$target_file" "$CURRENT_CONF"
    echo -e "${GREEN}✔ Đã áp dụng Hardware Profile:${RESET} ${BOLD}$target${RESET}"
}

cmd_list() {
    ensure_dirs
    local current=""
    if [ -L "$CURRENT_CONF" ]; then
        current=$(basename "$(readlink -f "$CURRENT_CONF")" .conf)
    fi

    echo -e "${BOLD}Các Hardware Profiles có sẵn:${RESET}"
    for f in "$PROFILES_DIR"/*.conf; do
        [ -f "$f" ] || continue
        local name
        name=$(basename "$f" .conf)
        if [ "$name" = "$current" ]; then
            echo -e "  ${GREEN}▶ $name${RESET} ${DIM}(hiện tại)${RESET}"
        else
            echo -e "    $name"
        fi
    done
}

cmd_show() {
    ensure_dirs
    local p_name p_ver chassis host
    p_name=$(get_dmi_field "product_name")
    p_ver=$(get_dmi_field "product_version")
    chassis=$(get_dmi_field "chassis_type")
    host=$(cat /etc/hostname 2>/dev/null || echo "")

    local current="(chưa chọn)"
    if [ -L "$CURRENT_CONF" ]; then
        current=$(basename "$(readlink -f "$CURRENT_CONF")" .conf)
    fi

    echo -e "${BOLD}${CYAN}THÔNG TIN PHẦN CỨNG & PROFILE HIỆN TẠI${RESET}"
    echo -e "  ${BOLD}Hostname:${RESET}        ${host:-unknown}"
    echo -e "  ${BOLD}DMI Product:${RESET}     ${p_name:-unknown} (${p_ver:-unknown})"
    echo -e "  ${BOLD}Chassis Type:${RESET}    ${chassis:-unknown}"
    echo -e "  ${BOLD}Active Profile:${RESET}  ${GREEN}${BOLD}$current${RESET}"
    echo ""

    if [ -f "$CURRENT_CONF" ]; then
        echo -e "${BOLD}Cấu hình chi tiết ($CURRENT_CONF):${RESET}"
        while IFS='=' read -r key val; do
            [[ "$key" =~ ^#.*$ ]] && continue
            [ -z "$key" ] && continue
            echo -e "  ${CYAN}$key${RESET} = $val"
        done < "$CURRENT_CONF"
    else
        echo -e "${YELLOW}Chưa có profile nào được kích hoạt. Chạy 'ka profile detect' để tự động nạp.${RESET}"
    fi
}

case "${1:-show}" in
    detect|auto)
        cmd_detect
        ;;
    set)
        shift
        cmd_set "${1:-}"
        ;;
    list|ls)
        cmd_list
        ;;
    show|status|"")
        cmd_show
        ;;
    *)
        echo -e "${RED}Lệnh không hợp lệ: $1${RESET}"
        echo "Sử dụng: ka-profile [detect | set <profile> | list | show]"
        exit 1
        ;;
esac
