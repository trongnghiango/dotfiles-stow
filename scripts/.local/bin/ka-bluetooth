#!/usr/bin/env bash
# ==============================================================================
# ka-bluetooth — Universal Bluetooth Controller & Device Orchestrator
# Quản lý thiết bị Bluetooth tốc độ cao, quét và hiển thị thiết bị lân cận chuẩn xác
# ==============================================================================
set -euo pipefail

BOLD="\033[1m"
GREEN="\033[32m"
CYAN="\033[36m"
YELLOW="\033[33m"
RED="\033[31m"
DIM="\033[2m"
RESET="\033[0m"

notify() {
  local title="$1"
  local msg="$2"
  local urgency="${3:-normal}"
  local icon="${4:-bluetooth}"

  if command -v dunstify >/dev/null 2>&1; then
    dunstify -a "ka-bluetooth" -u "$urgency" -i "$icon" "$title" "$msg" 2>/dev/null || true
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send -a "ka-bluetooth" -u "$urgency" -i "$icon" "$title" "$msg" 2>/dev/null || true
  fi
}

signal_dwmblocks() {
  local runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  local pid_file="$runtime_dir/dwmblocks.pid"
  if [[ -f "$pid_file" ]]; then
    local pid
    pid=$(cat "$pid_file" 2>/dev/null || true)
    [[ -n "$pid" ]] && kill -RTMIN+7 "$pid" 2>/dev/null || true
  else
    pkill -RTMIN+7 -x dwmblocks 2>/dev/null || true
  fi
}

is_service_active() {
  systemctl is-active --quiet bluetooth 2>/dev/null
}

is_adapter_present() {
  [[ -d "/sys/class/bluetooth" ]] && ls /sys/class/bluetooth/hci* >/dev/null 2>&1
}

is_powered_on() {
  if ! is_adapter_present; then
    return 1
  fi
  local state
  state=$(cat /sys/class/bluetooth/hci0/rfkill*/state 2>/dev/null | head -n1 || echo "0")
  if [[ "$state" == "1" ]]; then
    return 0
  fi
  # Fallback: kiểm tra qua bluetoothctl
  bluetoothctl show 2>/dev/null | grep -q "Powered: yes"
}

ensure_service() {
  if ! is_service_active; then
    echo -e "${YELLOW}[!] Dịch vụ bluetooth chưa chạy. Đang kích hoạt...${RESET}"
    if command -v systemctl >/dev/null 2>&1; then
      systemctl start bluetooth 2>/dev/null || sudo systemctl start bluetooth 2>/dev/null || {
        echo -e "${RED}[ERROR] Không thể khởi động bluetooth.service. Chạy: sudo systemctl start bluetooth${RESET}" >&2
        return 1
      }
    fi
  fi
  return 0
}

ensure_powered() {
  ensure_service || return 1
  if ! is_powered_on; then
    echo -e "${YELLOW}[!] Bluetooth đang tắt nguồn. Đang bật nguồn...${RESET}"
    rfkill unblock bluetooth 2>/dev/null || true
    bluetoothctl power on >/dev/null 2>&1 || true
    sleep 0.5
    signal_dwmblocks
  fi
  return 0
}

# ==============================================================================
# 1. TRẠNG THÁI (STATUS)
# ==============================================================================
cmd_status() {
  echo -e "${BOLD}${CYAN}=== Trạng thái Bluetooth (Omarchy Native) ===${RESET}"

  if ! is_adapter_present; then
    echo -e "Phần cứng : ${RED}Không phát hiện adapter Bluetooth trên máy${RESET}"
    return 1
  fi

  if ! is_service_active; then
    echo -e "Dịch vụ   : ${YELLOW}bluetoothd chưa khởi động (sudo systemctl start bluetooth)${RESET}"
    return 0
  fi

  local p_status
  if is_powered_on; then
    p_status="${GREEN}BẬT (Powered)${RESET}"
  else
    p_status="${RED}TẮT (Soft Blocked)${RESET}"
  fi

  echo -e "Dịch vụ   : ${GREEN}Đang hoạt động (active)${RESET}"
  echo -e "Nguồn     : $p_status"

  # Hiển thị thông tin Controller
  local ctrl_info
  ctrl_info=$(bluetoothctl show 2>/dev/null | grep -E '^s*(Name|Alias|Address):' || true)
  if [[ -n "$ctrl_info" ]]; then
    echo -e "${DIM}$ctrl_info${RESET}"
  fi

  # Danh sách thiết bị
  echo -e "\n${BOLD}Danh sách thiết bị:${RESET}"
  cmd_devices
}

# ==============================================================================
# 2. DANH SÁCH THIẾT BỊ (DEVICES)
# ==============================================================================
cmd_devices() {
  ensure_service || return 1

  local paired_list
  local connected_list
  paired_list=$(bluetoothctl devices Paired 2>/dev/null || true)
  connected_list=$(bluetoothctl devices Connected 2>/dev/null || true)

  local count=0
  local all_devs
  all_devs=$(bluetoothctl devices 2>/dev/null || true)

  if [[ -z "$all_devs" ]]; then
    echo -e "  ${DIM}(Chưa có thiết bị nào trong bộ nhớ. Chạy 'ka bt scan' để tìm kiếm)${RESET}"
    return 0
  fi

  printf "  ${BOLD}%-19s  %-34s  %s${RESET}\n" "ĐỊA CHỈ MAC" "TÊN THIẾT BỊ / NHÃN" "TRẠNG THÁI"
  echo "  ----------------------------------------------------------------------"

  while read -r _ mac initial_name; do
    [[ -z "$mac" ]] && continue
    count=$((count + 1))

    local display_name="$initial_name"
    local mac_dashes
    mac_dashes=$(echo "$mac" | tr ':' '-')

    if [[ "$initial_name" == "$mac_dashes" || -z "$initial_name" ]]; then
      local info_out
      info_out=$(bluetoothctl info "$mac" 2>/dev/null || true)
      local real_name
      real_name=$(echo "$info_out" | grep -E '^\s*Name:' | head -n1 | sed -E 's/^\s*Name:\s*//' || true)
      if [[ -n "$real_name" ]]; then
        display_name="$real_name"
      else
        local mfg
        mfg=$(echo "$info_out" | grep -E 'ManufacturerData\.Key:' | head -n1 | awk '{print $2}' || true)
        case "$mfg" in
          0x004c) display_name="Thiết bị Apple (Beacon BLE)" ;;
          0x0075) display_name="Samsung Electronics" ;;
          0x0006) display_name="Thiết bị Microsoft" ;;
          0x00e0) display_name="Thiết bị Google" ;;
          0x012d) display_name="Thiết bị Sony" ;;
          *)      display_name="Chưa rõ tên (Beacon BLE)" ;;
        esac
      fi
    fi

    local status="${DIM}○ Chưa ghép${RESET}"
    if echo "$connected_list" | grep -q "$mac"; then
      status="${GREEN}● Đã kết nối${RESET}"
    elif echo "$paired_list" | grep -q "$mac"; then
      status="${CYAN}○ Đã ghép nối${RESET}"
    fi
    printf "  %-19s  %-34s  %b\n" "$mac" "$display_name" "$status"
  done <<< "$all_devs"

  echo "  ----------------------------------------------------------------------"
  echo -e "  Tổng cộng: ${BOLD}$count${RESET} thiết bị"
}

# ==============================================================================
# 3. QUÉT THIẾT BỊ XUNG QUANH (SCAN)
# ==============================================================================
cmd_scan() {
  local duration="${1:-6}"
  ensure_powered || return 1

  echo -e "${CYAN}${BOLD}🔍 Đang quét tìm thiết bị Bluetooth xung quanh trong ${duration} giây...${RESET}"
  echo -e "${DIM}  (Vui lòng bật chế độ ghép nối trên tai nghe/chuột/bàn phím của bạn)${RESET}"
  notify "Bluetooth" "Đang quét tìm thiết bị trong ${duration}s..." "normal" "bluetooth"

  # Thực thi quét tìm kiếm qua bluetoothctl có giới hạn thời gian timeout
  bluetoothctl --timeout "$duration" scan on >/dev/null 2>&1 || true

  echo ""
  echo -e "${GREEN}${BOLD}✔ Hoàn tất quét thiết bị.${RESET}"
  echo ""
  cmd_devices

  echo ""
  echo -e "${BOLD}Hướng dẫn kết nối:${RESET}"
  echo -e "  Kết nối bằng tên:  ${CYAN}ka bt connect <Tên thiết bị>${RESET}"
  echo -e "  Kết nối bằng MAC:  ${CYAN}ka bt connect <Địa chỉ MAC>${RESET}"
  echo -e "  Mở thẻ Popover:    ${CYAN}ka bt menu${RESET} (hoặc phím tắt ${BOLD}Super+Shift+B${RESET})"

  signal_dwmblocks
}

# ==============================================================================
# 4. KẾT NỐI THIẾT BỊ (CONNECT)
# ==============================================================================
cmd_connect() {
  local target="${1:-}"
  if [[ -z "$target" ]]; then
    cmd_menu
    return 0
  fi

  ensure_powered || return 1

  # Tìm thiết bị trong danh sách đã biết
  local match
  match=$(bluetoothctl devices 2>/dev/null | grep -i "$target" | head -n1 || true)

  # Nếu chưa có trong danh sách, thử quét nhanh 4s
  if [[ -z "$match" ]]; then
    echo -e "${YELLOW}[!] Chưa thấy thiết bị '$target' trong bộ nhớ. Đang quét tìm kiếm nhanh 4s...${RESET}"
    bluetoothctl --timeout 4 scan on >/dev/null 2>&1 || true
    match=$(bluetoothctl devices 2>/dev/null | grep -i "$target" | head -n1 || true)
  fi

  if [[ -z "$match" ]]; then
    echo -e "${RED}[ERROR] Không tìm thấy thiết bị nào khớp với '$target'.${RESET}" >&2
    echo -e "Chạy '${CYAN}ka bt scan${RESET}' để tìm tất cả thiết bị xung quanh." >&2
    return 1
  fi

  local mac
  local name
  mac=$(echo "$match" | awk '{print $2}')
  name=$(echo "$match" | cut -d' ' -f3-)

  echo -e "Đang kết nối tới: ${BOLD}${CYAN}$name${RESET} (${mac})..."
  notify "Bluetooth" "Đang kết nối tới $name..." "normal" "bluetooth"

  # Nếu chưa ghép nối thì pair và trust trước
  local is_paired
  is_paired=$(bluetoothctl devices Paired 2>/dev/null | grep -q "$mac" && echo "1" || echo "0")
  if [[ "$is_paired" == "0" ]]; then
    echo -e "Đang ghép nối (pairing) với $name..."
    bluetoothctl pair "$mac" >/dev/null 2>&1 || true
    bluetoothctl trust "$mac" >/dev/null 2>&1 || true
  fi

  # Thực hiện kết nối
  if bluetoothctl connect "$mac" 2>&1 | grep -q "Connection successful"; then
    echo -e "${GREEN}${BOLD}✔ Kết nối thành công tới $name!${RESET}"
    notify "Bluetooth" "Đã kết nối thành công: $name" "normal" "bluetooth"
  else
    # Thử lại một lần nữa
    if bluetoothctl connect "$mac" 2>&1 | grep -q "Connection successful"; then
      echo -e "${GREEN}${BOLD}✔ Kết nối thành công tới $name!${RESET}"
      notify "Bluetooth" "Đã kết nối thành công: $name" "normal" "bluetooth"
    else
      echo -e "${RED}[!] Không thể kết nối tới $name. Hãy đảm bảo thiết bị đang bật và ở gần.${RESET}" >&2
      notify "Bluetooth" "Kết nối thất bại tới $name" "normal" "bluetooth-disabled"
    fi
  fi

  signal_dwmblocks
}

# ==============================================================================
# 5. NGẮT KẾT NỐI (DISCONNECT)
# ==============================================================================
cmd_disconnect() {
  local target="${1:-}"
  ensure_service || return 1

  if [[ -n "$target" ]]; then
    local match
    match=$(bluetoothctl devices 2>/dev/null | grep -i "$target" | head -n1 || true)
    if [[ -z "$match" ]]; then
      echo -e "${RED}[ERROR] Không tìm thấy thiết bị '$target'.${RESET}" >&2
      return 1
    fi
    local mac
    mac=$(echo "$match" | awk '{print $2}')
    local name
    name=$(echo "$match" | cut -d' ' -f3-)

    echo -e "Đang ngắt kết nối: ${CYAN}$name${RESET}..."
    bluetoothctl disconnect "$mac" >/dev/null 2>&1 || true
    echo -e "${GREEN}✔ Đã ngắt kết nối $name.${RESET}"
    notify "Bluetooth" "Đã ngắt kết nối $name" "normal" "bluetooth-disabled"
  else
    # Ngắt toàn bộ thiết bị đang kết nối
    local conn_list
    conn_list=$(bluetoothctl devices Connected 2>/dev/null || true)
    if [[ -z "$conn_list" ]]; then
      echo "Không có thiết bị nào đang kết nối."
      return 0
    fi
    while read -r _ mac name; do
      [[ -z "$mac" ]] && continue
      echo -e "Ngắt kết nối: $name ($mac)..."
      bluetoothctl disconnect "$mac" >/dev/null 2>&1 || true
    done <<< "$conn_list"
    echo -e "${GREEN}✔ Đã ngắt kết nối toàn bộ thiết bị Bluetooth.${RESET}"
    notify "Bluetooth" "Đã ngắt kết nối toàn bộ thiết bị" "normal" "bluetooth-disabled"
  fi

  signal_dwmblocks
}

# ==============================================================================
# 6. BẬT / TẮT NGUỒN (TOGGLE)
# ==============================================================================
cmd_toggle() {
  ensure_service || return 1

  if is_powered_on; then
    bluetoothctl power off >/dev/null 2>&1 || true
    rfkill block bluetooth 2>/dev/null || true
    notify "Bluetooth" "Đã tắt nguồn Bluetooth" "low" "bluetooth-disabled"
    echo -e "${YELLOW}Đã tắt nguồn Bluetooth.${RESET}"
  else
    rfkill unblock bluetooth 2>/dev/null || true
    bluetoothctl power on >/dev/null 2>&1 || true
    notify "Bluetooth" "Đã bật nguồn Bluetooth" "normal" "bluetooth"
    echo -e "${GREEN}Đã bật nguồn Bluetooth.${RESET}"
  fi
  signal_dwmblocks
}

# ==============================================================================
# 7. GIAO DIỆN POPOVER GUI (MENU)
# ==============================================================================
cmd_menu() {
  if command -v ka-pop >/dev/null 2>&1; then
    ka-pop bluetooth &
  elif [[ -x "/home/ka/.dotfiles/suckless/.local/src/ka-pop/build/ka-pop" ]]; then
    /home/ka/.dotfiles/suckless/.local/src/ka-pop/build/ka-pop bluetooth &
  else
    cmd_status
  fi
}

# ==============================================================================
# DISPATCHER
# ==============================================================================
case "${1:-menu}" in
  status)
    cmd_status
    ;;
  devices|ls|list)
    cmd_devices
    ;;
  scan)
    shift
    cmd_scan "${1:-6}"
    ;;
  connect)
    shift
    cmd_connect "${1:-}"
    ;;
  disconnect)
    shift
    cmd_disconnect "${1:-}"
    ;;
  toggle)
    cmd_toggle
    ;;
  menu)
    cmd_menu
    ;;
  -h|--help)
    echo "Sử dụng: ka bt [status | scan [giây] | devices | connect <tên|MAC> | disconnect [tên] | toggle | menu]"
    echo ""
    echo "Lệnh phổ biến:"
    echo "  ka bt scan           Quét và liệt kê toàn bộ thiết bị xung quanh"
    echo "  ka bt devices        Xem danh sách thiết bị đã biết / đã ghép"
    echo "  ka bt connect <tên>  Kết nối tới thiết bị (tự tìm kiếm nếu chưa có)"
    echo "  ka bt disconnect     Ngắt kết nối thiết bị"
    echo "  ka bt toggle         Bật / Tắt nguồn Bluetooth"
    echo "  ka bt menu           Mở thẻ điều khiển giao diện Popover (Super+Shift+B)"
    ;;
  *)
    cmd_connect "$1"
    ;;
esac
