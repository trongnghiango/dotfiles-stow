#!/usr/bin/env python3
"""
ka-clip — Unified Native Clipboard Manager (Omarchy / Titus Architecture)
- Thiết kế 2 cột chuẩn tỷ lệ vàng 2 : 3 (Bên trái 400px / 40% : Bên phải 600px / 60%).
- Cột trái: Ô tìm kiếm real-time, danh sách bản sao với số thứ tự, icon badge, giờ copy, tóm tắt.
- Cột phải: Xem trước chi tiết nội dung đầy đủ:
    + Hình ảnh (Image / Screenshot / OCR): Xem ảnh phóng to sắc nét (560px x 340px), đúng tỷ lệ thật, thông số pixel & dung lượng.
    + Văn bản (Text / Code / URL): Hiển thị 100% nội dung nhiều dòng, tự động ngắt dòng (word wrap), không bị cắt cụt.
- Tự động nạp bảng màu từ ~/.config/theme/colors/current.conf (0px border-radius, 2px accent border).
- Khay hệ thống native X11 (Gtk.StatusIcon) nhúng trực tiếp, 0 tệp rác trên đĩa.
- Hỗ trợ Pre-warmed Socket Daemon cho phản hồi tức thì < 2ms (Super + V / click khay hệ thống / ka clip).
"""

import os
import sys
import time
import json
import struct
import signal
import socket
import hashlib
import threading
import subprocess
from pathlib import Path

# ==============================================================================
# 0. THƯ MỤC LƯU TRỮ & SOCKET NHANH (< 2ms FAST PATH)
# ==============================================================================
def get_runtime_dir() -> Path:
    xdg_rt = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
    try:
        p = Path(xdg_rt)
        test_f = p / f".write_test_{os.getuid()}"
        test_f.touch()
        test_f.unlink()
        return p
    except (OSError, PermissionError):
        return Path("/tmp")

RUNTIME_DIR = get_runtime_dir()
SOCKET_PATH = str(RUNTIME_DIR / f"ka-clip-{os.getuid()}.sock")
PID_FILE = RUNTIME_DIR / f"ka-clip-{os.getuid()}.pid"

def get_cache_base() -> Path:
    xdg_cache = os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache"))
    try:
        p = Path(xdg_cache) / "ka-clip"
        p.mkdir(parents=True, exist_ok=True)
        test_f = p / ".write_test"
        test_f.touch()
        test_f.unlink()
        return p
    except (OSError, PermissionError):
        tmp_p = Path("/tmp") / f"ka-clip-{os.getuid()}"
        tmp_p.mkdir(parents=True, exist_ok=True)
        return tmp_p

CACHE_DIR = get_cache_base()
ENTRIES_DIR = CACHE_DIR / "entries"
HISTORY_FILE = CACHE_DIR / "history.json"
MAX_ENTRIES = 100
MAX_TEXT_SIZE = 2 * 1024 * 1024

# Fast-path: Nếu gọi từ CLI / phím tắt mà daemon đang chạy -> gửi lệnh qua socket
is_daemon = len(sys.argv) > 1 and sys.argv[1].lower() in ("daemon", "--daemon", "-d")
if not is_daemon and (len(sys.argv) == 1 or sys.argv[1].lower() in ("menu", "toggle", "--toggle")):
    try:
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(0.08)
        sock.connect(SOCKET_PATH)
        sock.sendall(json.dumps({"action": "toggle"}).encode("utf-8") + b"\n")
        resp = sock.recv(64)
        sock.close()
        sys.exit(0)
    except Exception:
        # Daemon chưa chạy -> chạy standalone giao diện bên dưới
        pass

# ==============================================================================
# 1. QUẢN LÝ DỮ LIỆU LỊCH SỬ CLIPBOARD
# ==============================================================================
def ensure_dirs():
    ENTRIES_DIR.mkdir(parents=True, exist_ok=True)

def load_history():
    if HISTORY_FILE.exists():
        try:
            with open(HISTORY_FILE, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            return []
    return []

def save_history(history):
    ensure_dirs()
    tmp_file = HISTORY_FILE.with_suffix(".tmp")
    with open(tmp_file, "w", encoding="utf-8") as f:
        json.dump(history[:MAX_ENTRIES], f, ensure_ascii=False, indent=2)
    tmp_file.replace(HISTORY_FILE)

def get_png_dimensions(data: bytes):
    if len(data) >= 24 and data[:8] == b'\x89PNG\r\n\x1a\n':
        w, h = struct.unpack('>II', data[16:24])
        return w, h
    return None

def format_size(bytes_len: int) -> str:
    if bytes_len < 1024:
        return f"{bytes_len} B"
    elif bytes_len < 1024 * 1024:
        return f"{bytes_len / 1024:.1f} KB"
    else:
        return f"{bytes_len / (1024 * 1024):.1f} MB"

def capture_clipboard():
    """Bắt và lưu trữ nội dung clipboard hiện tại nếu có thay đổi mới."""
    ensure_dirs()
    try:
        targets_out = subprocess.check_output(
            ["xclip", "-selection", "clipboard", "-t", "TARGETS", "-o"],
            stderr=subprocess.DEVNULL,
            timeout=1
        ).decode("utf-8", errors="ignore")
    except Exception:
        return False

    targets = targets_out.splitlines()
    history = load_history()
    now = time.localtime()
    date_str = time.strftime("%d/%m/%Y", now)
    time_str = time.strftime("%H:%M:%S", now)
    timestamp = int(time.time())

    # XỬ LÝ HÌNH ẢNH (image/png)
    if "image/png" in targets:
        try:
            img_data = subprocess.check_output(
                ["xclip", "-selection", "clipboard", "-t", "image/png", "-o"],
                stderr=subprocess.DEVNULL,
                timeout=1.5
            )
        except Exception:
            return False

        if not img_data or len(img_data) < 32:
            return False

        img_hash = hashlib.sha256(img_data).hexdigest()
        if history and history[0].get("hash") == img_hash:
            return False

        dim = get_png_dimensions(img_data)
        dim_str = f"{dim[0]} × {dim[1]}" if dim else "PNG Image"
        size_str = format_size(len(img_data))
        entry_id = f"{timestamp}_{img_hash[:8]}"
        file_path = ENTRIES_DIR / f"{entry_id}.png"

        with open(file_path, "wb") as f:
            f.write(img_data)

        new_entry = {
            "id": entry_id,
            "type": "image",
            "date": date_str,
            "time": time_str,
            "hash": img_hash,
            "summary_title": f"Ảnh chụp ({dim_str}, {size_str})",
            "file_path": str(file_path),
            "dimensions": dim_str,
            "size_str": size_str,
        }
        history.insert(0, new_entry)
        save_history(history)
        return True

    # XỬ LÝ VĂN BẢN (Text / Code / URL)
    text_targets = [t for t in targets if t in ("UTF8_STRING", "TEXT", "STRING", "text/plain")]
    if text_targets:
        try:
            text_data = subprocess.check_output(
                ["xclip", "-selection", "clipboard", "-o"],
                stderr=subprocess.DEVNULL,
                timeout=1
            ).decode("utf-8", errors="replace")
        except Exception:
            return False

        stripped = text_data.strip()
        if not stripped or len(text_data) > MAX_TEXT_SIZE:
            return False

        text_hash = hashlib.sha256(text_data.encode("utf-8")).hexdigest()
        if history and history[0].get("hash") == text_hash:
            return False

        entry_id = f"{timestamp}_{text_hash[:8]}"
        file_path = ENTRIES_DIR / f"{entry_id}.txt"

        with open(file_path, "w", encoding="utf-8") as f:
            f.write(text_data)

        first_line = stripped.splitlines()[0].strip()
        short_line = first_line[:48] + "…" if len(first_line) > 50 else first_line

        icon_symbol = "󰈙"
        category = "text"
        if stripped.startswith("http://") or stripped.startswith("https://"):
            icon_symbol = "󰌨"
            category = "url"
        elif any(keyword in first_line for keyword in ("import ", "def ", "class ", "function ", "const ", "let ", "var ", "#!/")):
            icon_symbol = "󰘦"
            category = "code"

        lines_count = len(text_data.splitlines())
        chars_count = len(text_data)

        new_entry = {
            "id": entry_id,
            "type": "text",
            "category": category,
            "date": date_str,
            "time": time_str,
            "hash": text_hash,
            "icon_symbol": icon_symbol,
            "summary_title": short_line,
            "text": text_data,
            "file_path": str(file_path),
            "line_count": lines_count,
            "char_count": chars_count,
            "size_str": format_size(len(text_data.encode("utf-8"))),
        }
        history.insert(0, new_entry)
        save_history(history)
        return True

    return False

def apply_clipboard(entry):
    """Nạp bản sao vào clipboard và phát thông báo."""
    file_path = Path(entry["file_path"])
    if not file_path.exists():
        notify("Lỗi Clipboard", "Không tìm thấy tệp bản sao.", icon="dialog-error")
        return

    if entry["type"] == "image":
        try:
            with open(file_path, "rb") as f:
                subprocess.run(
                    ["xclip", "-selection", "clipboard", "-t", "image/png", "-i"],
                    stdin=f,
                    check=True
                )
            notify("Clipboard", f"Đã nạp ảnh ({entry.get('dimensions', 'PNG')})", icon=str(file_path))
        except Exception as e:
            notify("Lỗi Clipboard", f"Không thể sao chép ảnh: {e}", icon="dialog-error")
    else:
        try:
            with open(file_path, "rb") as f:
                content = f.read()
            subprocess.run(["xclip", "-selection", "clipboard", "-i"], input=content, check=True)
            subprocess.run(["xclip", "-selection", "primary", "-i"], input=content)
            notify("Clipboard", f"Đã nạp văn bản: {entry['summary_title'][:32]}…", icon="edit-paste")
        except Exception as e:
            notify("Lỗi Clipboard", f"Không thể sao chép văn bản: {e}", icon="dialog-error")

def clear_history():
    ensure_dirs()
    for p in ENTRIES_DIR.glob("*"):
        try: p.unlink()
        except Exception: pass
    save_history([])
    notify("Clipboard Manager", "Đã xóa sạch toàn bộ lịch sử bản sao.", icon="edit-delete")

def notify(title: str, message: str, icon: str = None):
    icon_arg = ["-i", icon] if icon else []
    if subprocess.run(["which", "dunstify"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
        subprocess.run(["dunstify", "-a", "ka-clip", "-r", "9943", *icon_arg, title, message])
    elif subprocess.run(["which", "notify-send"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
        subprocess.run(["notify-send", "-a", "ka-clip", *icon_arg, title, message])

# ==============================================================================
# 2. BẢNG MÀU VÀ GIAO DIỆN GTK3 MASTER-DETAIL (TỶ LỆ VÀNG 2 : 3)
# ==============================================================================
def load_theme_colors():
    theme_conf = Path(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config"))) / "theme/colors/current.conf"
    colors = {
        "bg": "1e1e2e", "fg": "cdd6f4", "accent": "cba6f7",
        "bg_alt": "313244", "surface": "45475a", "text_dim": "bac2de"
    }
    if theme_conf.exists():
        try:
            with open(theme_conf, "r", encoding="utf-8") as f:
                for line in f:
                    if "=" in line and not line.strip().startswith("#"):
                        k, v = line.strip().split("=", 1)
                        v = v.split("#")[0].strip().strip('"\'')
                        if k == "BG": colors["bg"] = v
                        elif k == "FG": colors["fg"] = v
                        elif k == "ACCENT": colors["accent"] = v
                        elif k == "COLOR0": colors["surface"] = v
                        elif k == "COLOR8": colors["bg_alt"] = v
                        elif k == "COLOR7": colors["text_dim"] = v
        except Exception:
            pass
    return colors

# Import GTK3 sau khi kiểm tra xong các điều kiện ban đầu
import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Gtk, Gdk, GdkPixbuf, Pango, GLib

class ClipboardWindow(Gtk.Window):
    def __init__(self, on_close_cb=None):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.on_close_cb = on_close_cb
        self.set_title("Ka Clipboard Manager")
        self.set_wmclass("ka-clip", "ka-clip")
        self.set_type_hint(Gdk.WindowTypeHint.DIALOG)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_decorated(False)
        self.set_default_size(1000, 560)

        self.colors = load_theme_colors()
        self.apply_css()

        self.history = []
        self.filtered_entries = []

        # Bố cục chính
        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        main_box.set_name("main_box")
        self.add(main_box)

        # Thanh Paned chia tỷ lệ 2 : 3 (Trái: 400px, Phải: 600px)
        self.paned = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL)
        self.paned.set_name("paned")
        main_box.pack_start(self.paned, True, True, 0)

        # CỘT TRÁI (DANH SÁCH - 400px = 40% = 2 PHẦN)
        left_container = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        left_container.set_name("left_container")
        left_container.set_size_request(400, -1)
        self.paned.pack1(left_container, resize=False, shrink=False)

        # Header tìm kiếm
        search_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        search_box.set_name("search_box")
        
        icon_search = Gtk.Label()
        icon_search.set_markup(f"<span font='11' color='#{self.colors['accent']}'></span>")
        search_box.pack_start(icon_search, False, False, 4)

        self.search_entry = Gtk.SearchEntry()
        self.search_entry.set_placeholder_text("Tìm kiếm bản sao (Text / Ảnh / Code)...")
        self.search_entry.set_hexpand(True)
        self.search_entry.connect("search-changed", self.on_search_changed)
        search_box.pack_start(self.search_entry, True, True, 0)
        left_container.pack_start(search_box, False, False, 0)

        # Danh sách ListBox
        scrolled_list = Gtk.ScrolledWindow()
        scrolled_list.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scrolled_list.set_vexpand(True)
        
        self.listbox = Gtk.ListBox()
        self.listbox.set_name("entry_listbox")
        self.listbox.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.listbox.connect("row-selected", self.on_row_selected)
        self.listbox.connect("row-activated", self.on_row_activated)
        scrolled_list.add(self.listbox)
        left_container.pack_start(scrolled_list, True, True, 0)

        # Footer chỉ dẫn phím tắt bên trái
        self.footer_label = Gtk.Label()
        self.footer_label.set_name("footer_label")
        self.footer_label.set_markup(f"<span font='9' color='#{self.colors['text_dim']}'>󰌑 <b>Enter</b>: Dán  ·  󰆴 <b>Del</b>: Xóa  ·  󱊷 <b>Esc</b>: Đóng</span>")
        left_container.pack_start(self.footer_label, False, False, 4)

        # CỘT PHẢI (CHI TIẾT NỘI DUNG - 600px = 60% = 3 PHẦN)
        self.right_container = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.right_container.set_name("right_container")
        self.right_container.set_size_request(580, -1)
        self.paned.pack2(self.right_container, resize=True, shrink=False)

        # Header chi tiết
        self.preview_header = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        self.preview_header.set_name("preview_header")
        
        self.preview_title = Gtk.Label()
        self.preview_title.set_name("preview_title")
        self.preview_title.set_alignment(0.0, 0.5)
        self.preview_header.pack_start(self.preview_title, False, False, 0)

        self.preview_meta = Gtk.Label()
        self.preview_meta.set_name("preview_meta")
        self.preview_meta.set_alignment(0.0, 0.5)
        self.preview_header.pack_start(self.preview_meta, False, False, 0)
        self.right_container.pack_start(self.preview_header, False, False, 0)

        # Khung chứa ảnh phóng to
        self.image_preview_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.image_widget = Gtk.Image()
        self.image_widget.set_alignment(0.5, 0.5)
        self.image_preview_box.pack_start(self.image_widget, True, True, 0)
        
        self.image_meta_label = Gtk.Label()
        self.image_meta_label.set_name("image_meta_label")
        self.image_meta_label.set_alignment(0.5, 0.5)
        self.image_preview_box.pack_start(self.image_meta_label, False, False, 0)
        self.right_container.pack_start(self.image_preview_box, False, False, 0)

        # Khung chứa văn bản đầy đủ không cắt cụt
        self.text_scroll = Gtk.ScrolledWindow()
        self.text_scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        self.text_scroll.set_vexpand(True)
        
        self.text_view = Gtk.TextView()
        self.text_view.set_name("preview_textview")
        self.text_view.set_editable(False)
        self.text_view.set_cursor_visible(False)
        self.text_view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        self.text_view.set_left_margin(12)
        self.text_view.set_right_margin(12)
        self.text_view.set_top_margin(10)
        self.text_view.set_bottom_margin(10)
        self.text_scroll.add(self.text_view)
        self.right_container.pack_start(self.text_scroll, True, True, 0)

        # Kết nối phím tắt
        self.connect("key-press-event", self.on_key_press)

        self.paned.set_position(400)

    def apply_css(self):
        css = f"""
        #main_box {{
            background-color: #{self.colors['bg']};
            border: 2px solid #{self.colors['accent']};
            border-radius: 0px;
        }}
        #left_container {{
            background-color: #{self.colors['bg']};
            padding: 14px;
            border-right: 1px solid #{self.colors['surface']};
        }}
        #right_container {{
            background-color: #{self.colors['bg_alt']};
            padding: 16px;
        }}
        #search_box {{
            background-color: #{self.colors['bg_alt']};
            border: 1px solid #{self.colors['surface']};
            border-radius: 0px;
            padding: 4px 8px;
        }}
        entry {{
            background-color: transparent;
            color: #{self.colors['fg']};
            border: 0px;
            font-family: "JetBrains Mono";
            font-size: 11pt;
            box-shadow: none;
        }}
        entry:focus {{
            box-shadow: none;
        }}
        #entry_listbox {{
            background-color: transparent;
        }}
        row {{
            padding: 8px 10px;
            border-radius: 0px;
            border-bottom: 1px solid #{self.colors['surface']};
        }}
        row:hover {{
            background-color: #{self.colors['bg_alt']};
        }}
        row:selected {{
            background-color: #{self.colors['accent']};
            color: #{self.colors['bg']};
        }}
        row:selected label {{
            color: #{self.colors['bg']};
        }}
        #preview_header {{
            border-bottom: 1px solid #{self.colors['surface']};
            padding-bottom: 8px;
        }}
        #preview_title {{
            font-family: "JetBrains Mono";
            font-weight: bold;
            font-size: 12pt;
            color: #{self.colors['accent']};
        }}
        #preview_meta {{
            font-family: "JetBrains Mono";
            font-size: 9pt;
            color: #{self.colors['text_dim']};
        }}
        #image_meta_label {{
            font-family: "JetBrains Mono";
            font-size: 9.5pt;
            color: #{self.colors['text_dim']};
            padding-top: 6px;
        }}
        #preview_textview {{
            background-color: #{self.colors['bg']};
            color: #{self.colors['fg']};
            font-family: "JetBrains Mono";
            font-size: 10.5pt;
            border: 1px solid #{self.colors['surface']};
            border-radius: 0px;
        }}
        #preview_textview text {{
            background-color: #{self.colors['bg']};
            color: #{self.colors['fg']};
        }}
        """
        provider = Gtk.CssProvider()
        provider.load_from_data(css.encode())
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    def refresh_data(self):
        capture_clipboard()
        self.history = load_history()
        self.filter_and_render()

    def filter_and_render(self):
        query = self.search_entry.get_text().strip().lower()
        
        # Xóa các dòng cũ
        for child in self.listbox.get_children():
            self.listbox.remove(child)

        self.filtered_entries = []
        for idx, entry in enumerate(self.history, 1):
            title = entry.get("summary_title", "")
            raw_text = entry.get("text", "")
            searchable = (title + " " + raw_text + " " + entry.get("type", "")).lower()
            
            if query and query not in searchable:
                continue

            self.filtered_entries.append(entry)
            row = Gtk.ListBoxRow()
            row.entry_data = entry

            row_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            
            # Số thứ tự
            lbl_idx = Gtk.Label()
            lbl_idx.set_markup(f"<span font='9' color='#{self.colors['text_dim']}'>[{idx:02d}]</span>")
            row_box.pack_start(lbl_idx, False, False, 0)

            # Icon phân loại
            lbl_icon = Gtk.Label()
            if entry["type"] == "image":
                lbl_icon.set_markup(f"<span font='11' color='#{self.colors['accent']}'>󰋩</span>")
            else:
                sym = entry.get("icon_symbol", "󰈙")
                lbl_icon.set_markup(f"<span font='11' color='#{self.colors['accent']}'>{sym}</span>")
            row_box.pack_start(lbl_icon, False, False, 0)

            # Tóm tắt tiêu đề
            lbl_title = Gtk.Label()
            lbl_title.set_text(title)
            lbl_title.set_ellipsize(Pango.EllipsizeMode.END)
            lbl_title.set_alignment(0.0, 0.5)
            row_box.pack_start(lbl_title, True, True, 0)

            # Giờ lưu
            lbl_time = Gtk.Label()
            lbl_time.set_markup(f"<span font='8.5' color='#{self.colors['text_dim']}'>{entry.get('time', '')[:5]}</span>")
            row_box.pack_end(lbl_time, False, False, 0)

            row.add(row_box)
            self.listbox.add(row)

        self.listbox.show_all()
        
        # Chọn dòng đầu tiên nếu có
        first_row = self.listbox.get_row_at_index(0)
        if first_row:
            self.listbox.select_row(first_row)
        else:
            self.render_empty_preview()

    def on_search_changed(self, entry):
        self.filter_and_render()

    def on_row_selected(self, listbox, row):
        if not row or not hasattr(row, "entry_data"):
            self.render_empty_preview()
            return
        self.render_preview(row.entry_data)

    def on_row_activated(self, listbox, row):
        if row and hasattr(row, "entry_data"):
            apply_clipboard(row.entry_data)
            self.hide_window()

    def render_empty_preview(self):
        self.preview_title.set_text("󰅖  Không có bản sao nào")
        self.preview_meta.set_text("Lịch sử trống hoặc không khớp từ khóa tìm kiếm")
        self.image_preview_box.hide()
        self.text_scroll.hide()

    def render_preview(self, entry):
        if entry["type"] == "image":
            # Chế độ xem Hình ảnh
            self.preview_title.set_text(f"󰋩  Hình Ảnh ({entry.get('dimensions', 'PNG')})")
            self.preview_meta.set_markup(
                f"<span color='#{self.colors['text_dim']}'>Lưu lúc: <b>{entry.get('time', '')}</b> ({entry.get('date', '')})  ·  Dung lượng: <b>{entry.get('size_str', '')}</b></span>"
            )
            
            # Load và scale ảnh vừa vặn khung 540x320
            img_path = entry.get("file_path", "")
            if Path(img_path).exists():
                try:
                    pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(img_path, 540, 320, True)
                    self.image_widget.set_from_pixbuf(pb)
                except Exception:
                    self.image_widget.clear()
            else:
                self.image_widget.clear()

            self.image_meta_label.set_markup(
                f"<span font='9.5' color='#{self.colors['text_dim']}'>Đường dẫn: <tt>{img_path}</tt>\n<b>Nhấn Enter để sao chép vào bộ nhớ đệm và dán (Ctrl+V)</b></span>"
            )

            self.text_scroll.hide()
            self.image_preview_box.show_all()

        else:
            # Chế độ xem Văn bản
            cat = entry.get("category", "text").upper()
            sym = entry.get("icon_symbol", "󰈙")
            lines = entry.get("line_count", 1)
            chars = entry.get("char_count", 0)
            size = entry.get("size_str", "")

            self.preview_title.set_text(f"{sym}  Văn Bản ({cat})")
            self.preview_meta.set_markup(
                f"<span color='#{self.colors['text_dim']}'>Lưu lúc: <b>{entry.get('time', '')}</b> ({entry.get('date', '')})  ·  <b>{lines}</b> dòng, <b>{chars}</b> ký tự ({size})</span>"
            )

            buf = self.text_view.get_buffer()
            buf.set_text(entry.get("text", ""))

            self.image_preview_box.hide()
            self.text_scroll.show_all()

    def on_key_press(self, widget, event):
        key = event.keyval
        state = event.state

        # Esc -> Đóng
        if key == Gdk.KEY_Escape:
            self.hide_window()
            return True

        # Enter -> Nạp bản sao
        if key in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            selected = self.listbox.get_selected_row()
            if selected and hasattr(selected, "entry_data"):
                apply_clipboard(selected.entry_data)
                self.hide_window()
                return True

        # Delete -> Xóa bản sao đang chọn
        if key == Gdk.KEY_Delete:
            selected = self.listbox.get_selected_row()
            if selected and hasattr(selected, "entry_data"):
                self.delete_entry(selected.entry_data)
                return True

        # Ctrl+l -> Xóa toàn bộ lịch sử
        if (state & Gdk.ModifierType.CONTROL_MASK) and key == Gdk.KEY_l:
            clear_history()
            self.refresh_data()
            return True

        # j/k hoặc Up/Down khi đang focus ở search entry
        if key in (Gdk.KEY_Down, Gdk.KEY_Up):
            selected = self.listbox.get_selected_row()
            if not selected:
                first = self.listbox.get_row_at_index(0)
                if first: self.listbox.select_row(first)
                return True
            curr_idx = selected.get_index()
            new_idx = curr_idx + (1 if key == Gdk.KEY_Down else -1)
            new_row = self.listbox.get_row_at_index(new_idx)
            if new_row:
                self.listbox.select_row(new_row)
                new_row.grab_focus()
            return True

        return False

    def delete_entry(self, entry):
        target_id = entry.get("id")
        self.history = [e for e in self.history if e.get("id") != target_id]
        save_history(self.history)
        try: Path(entry.get("file_path", "")).unlink(missing_ok=True)
        except Exception: pass
        self.filter_and_render()
        notify("Clipboard", "Đã xóa 1 bản sao khỏi lịch sử.", icon="edit-delete")

    def show_window(self):
        self.refresh_data()
        self.show_all()
        self.present()
        self.search_entry.grab_focus()

    def hide_window(self):
        self.hide()
        if self.on_close_cb:
            self.on_close_cb()

# ==============================================================================
# 3. TIẾN TRÌNH DAEMON (CLIPNOTIFY + KHAY HỆ THỐNG NATIVE + SOCKET NHANH)
# ==============================================================================
def get_tray_pixbuf(accent_hex):
    svg_data = f"""<svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
<path fill-rule="evenodd" clip-rule="evenodd" d="M9 3C9 1.89543 9.89543 1 11 1H13C14.1046 1 15 1.89543 15 3V4H19C20.1046 4 21 4.89543 21 6V20C21 21.1046 20.1046 22 19 22H5C3.89543 22 3 21.1046 3 20V6C3 4.89543 3.89543 4 5 4H9V3ZM11 3H13V4H11V3ZM5 6H19V20H5V6Z" fill="#{accent_hex}"/>
<path d="M7 9H17V11H7V9Z" fill="#{accent_hex}"/>
<path d="M7 13H17V15H7V13Z" fill="#{accent_hex}"/>
</svg>"""
    try:
        loader = GdkPixbuf.PixbufLoader.new_with_type("svg")
        loader.write(svg_data.encode("utf-8"))
        loader.close()
        return loader.get_pixbuf()
    except Exception:
        return None

def run_daemon():
    ensure_dirs()
    if PID_FILE.exists():
        try:
            old_pid = int(PID_FILE.read_text().strip())
            if old_pid != os.getpid():
                os.kill(old_pid, signal.SIGTERM)
                time.sleep(0.15)
        except Exception:
            pass

    PID_FILE.write_text(str(os.getpid()))
    capture_clipboard()

    # Khởi tạo cửa sổ GUI nạp sẵn trên RAM
    win = ClipboardWindow()

    # Khởi tạo Khay hệ thống native X11
    colors = load_theme_colors()
    pixbuf = get_tray_pixbuf(colors["accent"])
    status_icon = Gtk.StatusIcon.new_from_pixbuf(pixbuf) if pixbuf else Gtk.StatusIcon.new_from_icon_name("edit-paste")
    status_icon.set_tooltip_text("Ka Clipboard Manager (Click hoặc Super+V để mở)")
    status_icon.set_title("Ka Clipboard")
    status_icon.connect("activate", lambda icon: GLib.idle_add(win.show_window))
    status_icon.set_visible(True)

    # Khởi tạo Unix Domain Socket Server (< 2ms response)
    try:
        if os.path.exists(SOCKET_PATH):
            os.unlink(SOCKET_PATH)
        server_sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        server_sock.bind(SOCKET_PATH)
        server_sock.listen(5)
        server_sock.setblocking(False)

        def on_socket_readable(source, condition):
            try:
                conn, _ = server_sock.accept()
                data = conn.recv(128).decode("utf-8", errors="ignore")
                if "toggle" in data or "show" in data:
                    if win.is_visible():
                        win.hide_window()
                    else:
                        win.show_window()
                conn.sendall(b"OK\n")
                conn.close()
            except Exception:
                pass
            return True

        GLib.io_add_watch(server_sock.fileno(), GLib.IO_IN, on_socket_readable)
    except Exception:
        pass

    # Luồng background chạy clipnotify
    stop_event = threading.Event()
    has_clipnotify = subprocess.run(["which", "clipnotify"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0

    def monitor_loop():
        while not stop_event.is_set():
            if has_clipnotify:
                ret = subprocess.run(["clipnotify"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                if ret.returncode == 0:
                    capture_clipboard()
            else:
                time.sleep(0.8)
                capture_clipboard()

    t = threading.Thread(target=monitor_loop, daemon=True)
    t.start()

    def handle_sig(sig, frame):
        stop_event.set()
        try: PID_FILE.unlink()
        except Exception: pass
        try:
            if os.path.exists(SOCKET_PATH): os.unlink(SOCKET_PATH)
        except Exception: pass
        Gtk.main_quit()
        sys.exit(0)

    signal.signal(signal.SIGINT, handle_sig)
    signal.signal(signal.SIGTERM, handle_sig)

    Gtk.main()

def show_standalone_gui():
    win = ClipboardWindow(on_close_cb=Gtk.main_quit)
    win.show_window()
    Gtk.main()

def print_status():
    history = load_history()
    text_count = sum(1 for e in history if e.get("type") == "text")
    img_count = sum(1 for e in history if e.get("type") == "image")
    is_running = PID_FILE.exists()
    pid = PID_FILE.read_text().strip() if is_running else "Không"
    print(f"\033[1m\033[36mKA CLIPBOARD MANAGER STATUS\033[0m")
    print(f"  Daemon đang chạy : {'\033[32mCó (PID ' + pid + ')\033[0m' if is_running else '\033[33mChưa bật\033[0m'}")
    print(f"  Tổng số bản sao  : {len(history)} (Văn bản: {text_count}, Hình ảnh: {img_count})")
    print(f"  Thư mục lưu trữ  : {CACHE_DIR}")

if __name__ == "__main__":
    cmd = sys.argv[1].lower() if len(sys.argv) > 1 else "menu"
    if cmd in ("daemon", "--daemon", "-d"):
        run_daemon()
    elif cmd in ("clear", "--clear"):
        clear_history()
    elif cmd in ("status", "--status"):
        print_status()
    elif cmd in ("capture", "--capture"):
        capture_clipboard()
    else:
        show_standalone_gui()
