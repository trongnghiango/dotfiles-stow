#!/usr/bin/env python3
"""
ka-daemon: Unified System Daemon for Omarchy-X11 Architecture
- Consolidates dwm-dropdown (8 popovers) and ka-clip (clipboard manager) into a SINGLE Python process.
- Saves ~50MB RAM by eliminating redundant Python runtimes and GLib main loops.
- Lazy-loads UI modules: Windows are instantiated ONLY on demand when the user triggers them.
- In-Memory SQLite on tmpfs ($XDG_RUNTIME_DIR/ka-clip.db) eliminates disk I/O and disk wear.
- Ultra-low latency (< 1ms) via Unix Domain Socket IPC.
- 100% backward-compatible with legacy dwm-dropdown and ka-clip socket clients.
"""

import os
import sys
import time
import json
import socket
import signal
import atexit
import sqlite3
import hashlib
import struct
import threading
import subprocess
from pathlib import Path
import importlib.machinery
import importlib.util

# ==============================================================================
# 0. RUNTIME PATHS & FAST-PATH CLIENT
# ==============================================================================
def get_runtime_dir() -> Path:
    xdg_rt = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
    p = Path(xdg_rt)
    try:
        test_f = p / f".ka_write_test_{os.getuid()}"
        test_f.touch()
        test_f.unlink()
        return p
    except Exception:
        return Path("/tmp")

RUNTIME_DIR = get_runtime_dir()
DAEMON_SOCK = str(RUNTIME_DIR / f"ka-daemon-{os.getuid()}.sock")
DROPDOWN_SOCK = str(RUNTIME_DIR / f"dwm-dropdown-{os.getuid()}.sock")
CLIP_SOCK = str(RUNTIME_DIR / f"ka-clip-{os.getuid()}.sock")
PID_FILE = RUNTIME_DIR / f"ka-daemon-{os.getuid()}.pid"

# Fast-path CLI client (< 1ms response)
def send_socket_cmd(sock_path: str, payload: dict, timeout: float = 0.15) -> str:
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(timeout)
        s.connect(sock_path)
        s.sendall(json.dumps(payload).encode("utf-8") + b"\n")
        resp = s.recv(256).decode("utf-8", errors="ignore").strip()
        s.close()
        return resp
    except Exception as e:
        return ""

# Check if called as client
args = [a.lower() for a in sys.argv[1:]]
is_daemon = any(a in ("--daemon", "-d", "daemon", "server") for a in args)

if not is_daemon and len(sys.argv) > 1:
    cmd = sys.argv[1].lower()
    if cmd == "pop" and len(sys.argv) > 2:
        target = sys.argv[2].lower()
        resp = send_socket_cmd(DAEMON_SOCK, {"type": "pop", "target": target})
        if resp:
            sys.exit(0)
    elif cmd in ("volume", "clock", "battery", "cpu", "memory", "network", "forecast", "notify"):
        resp = send_socket_cmd(DAEMON_SOCK, {"type": "pop", "target": cmd})
        if resp:
            sys.exit(0)
    elif cmd == "clip":
        action = sys.argv[2].lower() if len(sys.argv) > 2 else "toggle"
        resp = send_socket_cmd(DAEMON_SOCK, {"type": "clip", "action": action})
        if resp:
            if action == "status":
                print(resp)
            sys.exit(0)
    elif cmd == "stop":
        resp = send_socket_cmd(DAEMON_SOCK, {"action": "stop"})
        print(f"ka-daemon stop: {resp or 'stopped'}")
        sys.exit(0)
    elif cmd in ("status", "--status"):
        resp = send_socket_cmd(DAEMON_SOCK, {"action": "status"})
        if resp:
            print(resp)
            sys.exit(0)

# ==============================================================================
# 1. INITIALIZE GTK3 & GLIB ENVIRONMENT
# ==============================================================================
import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Gtk, Gdk, GdkPixbuf, GLib, Pango

GLib.set_prgname("ka-daemon")

# Thư mục scripts
_SCRIPT_DIR = Path(__file__).resolve().parent
_SCRIPTS_BIN = _SCRIPT_DIR / "dwmblocks-scripts"
_current_path = os.environ.get("PATH", "")
if str(_SCRIPT_DIR) not in _current_path:
    os.environ["PATH"] = f"{_SCRIPTS_BIN}:{_SCRIPT_DIR}:{_current_path}"

# ==============================================================================
# 2. IN-MEMORY SQLITE CLIPBOARD ENGINE (tmpfs)
# ==============================================================================
DB_PATH = RUNTIME_DIR / f"ka-clip-{os.getuid()}.db"
PERSIST_DIR = Path(os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share"))) / "ka-clip"
PERSIST_DB = PERSIST_DIR / "history.db"
ENTRIES_DIR = RUNTIME_DIR / f"ka-clip-entries-{os.getuid()}"
ENTRIES_DIR.mkdir(parents=True, exist_ok=True)

class ClipStorage:
    def __init__(self, db_path: Path, persist_path: Path):
        self.db_path = db_path
        self.persist_path = persist_path
        self.conn = sqlite3.connect(str(db_path), check_same_thread=False)
        self.conn.row_factory = sqlite3.Row
        self._lock = threading.Lock()
        self._init_db()
        self._restore_from_disk()

    def _init_db(self):
        with self._lock:
            with self.conn:
                self.conn.execute("""
                    CREATE TABLE IF NOT EXISTS entries (
                        id TEXT PRIMARY KEY,
                        type TEXT NOT NULL,
                        category TEXT,
                        date TEXT,
                        time TEXT,
                        hash TEXT UNIQUE,
                        icon_symbol TEXT,
                        summary_title TEXT,
                        text_content TEXT,
                        file_path TEXT,
                        dimensions TEXT,
                        size_str TEXT,
                        line_count INTEGER,
                        char_count INTEGER,
                        created_at INTEGER
                    )
                """)
                self.conn.execute("CREATE INDEX IF NOT EXISTS idx_entries_created ON entries(created_at DESC)")
                self.conn.execute("CREATE INDEX IF NOT EXISTS idx_entries_hash ON entries(hash)")

    def get_history(self, limit: int = 100):
        with self._lock:
            cur = self.conn.cursor()
            cur.execute("SELECT * FROM entries ORDER BY created_at DESC LIMIT ?", (limit,))
            rows = cur.fetchall()
            res = []
            for r in rows:
                d = dict(r)
                d["text"] = d.get("text_content", "")
                res.append(d)
            return res

    def get_latest_hash(self):
        with self._lock:
            cur = self.conn.cursor()
            cur.execute("SELECT hash FROM entries ORDER BY created_at DESC LIMIT 1")
            row = cur.fetchone()
            return row[0] if row else None

    def add_entry(self, entry: dict):
        with self._lock:
            with self.conn:
                self.conn.execute("""
                    INSERT OR REPLACE INTO entries (
                        id, type, category, date, time, hash, icon_symbol, summary_title,
                        text_content, file_path, dimensions, size_str, line_count, char_count, created_at
                    ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                """, (
                    entry["id"], entry["type"], entry.get("category", "text"),
                    entry.get("date", ""), entry.get("time", ""), entry["hash"],
                    entry.get("icon_symbol", "󰈙"), entry.get("summary_title", ""),
                    entry.get("text", ""), entry.get("file_path", ""),
                    entry.get("dimensions", ""), entry.get("size_str", ""),
                    entry.get("line_count", 0), entry.get("char_count", 0),
                    entry.get("created_at", int(time.time()))
                ))
                self.conn.execute("""
                    DELETE FROM entries WHERE id NOT IN (
                        SELECT id FROM entries ORDER BY created_at DESC LIMIT 100
                    )
                """)

    def clear(self):
        with self._lock:
            with self.conn:
                self.conn.execute("DELETE FROM entries")
            for f in ENTRIES_DIR.glob("*"):
                try:
                    f.unlink()
                except Exception:
                    pass

    def _restore_from_disk(self):
        with self._lock:
            cur = self.conn.cursor()
            cur.execute("SELECT COUNT(*) FROM entries")
            count = cur.fetchone()[0]
            if count == 0 and self.persist_path.exists():
                try:
                    disk_conn = sqlite3.connect(str(self.persist_path))
                    disk_conn.row_factory = sqlite3.Row
                    cur_d = disk_conn.cursor()
                    cur_d.execute("SELECT * FROM entries ORDER BY created_at DESC LIMIT 100")
                    for r in cur_d.fetchall():
                        d = dict(r)
                        d["text"] = d.get("text_content", "")
                        self.conn.execute("""
                            INSERT OR IGNORE INTO entries VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                        """, tuple(r))
                    self.conn.commit()
                    disk_conn.close()
                except Exception:
                    pass

    def sync_to_disk(self):
        try:
            self.persist_path.parent.mkdir(parents=True, exist_ok=True)
            disk_conn = sqlite3.connect(str(self.persist_path))
            with disk_conn:
                disk_conn.execute("""
                    CREATE TABLE IF NOT EXISTS entries (
                        id TEXT PRIMARY KEY, type TEXT NOT NULL, category TEXT, date TEXT, time TEXT,
                        hash TEXT UNIQUE, icon_symbol TEXT, summary_title TEXT, text_content TEXT,
                        file_path TEXT, dimensions TEXT, size_str TEXT, line_count INTEGER, char_count INTEGER, created_at INTEGER
                    )
                """)
                disk_conn.execute("DELETE FROM entries")
                cur = self.conn.cursor()
                cur.execute("SELECT * FROM entries ORDER BY created_at DESC LIMIT 100")
                for r in cur.fetchall():
                    disk_conn.execute("INSERT INTO entries VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)", tuple(r))
            disk_conn.close()
        except Exception:
            pass

clip_storage = ClipStorage(DB_PATH, PERSIST_DB)

# ==============================================================================
# 3. CLIPBOARD CAPTURE & APPLY
# ==============================================================================
def get_png_dimensions(data: bytes):
    if len(data) >= 24 and data[:8] == b'\x89PNG\r\n\x1a\n':
        w, h = struct.unpack('>II', data[16:24])
        return w, h
    return None

def format_size(bytes_len: int) -> str:
    if bytes_len < 1024:
        return f"{bytes_len} B"
    elif bytes_len < 1024 * 1024:
        return f"{bytes_len / 1024:.1f} KB"
    else:
        return f"{bytes_len / (1024 * 1024):.1f} MB"

def capture_clipboard() -> bool:
    try:
        targets_out = subprocess.check_output(
            ["xclip", "-selection", "clipboard", "-t", "TARGETS", "-o"],
            stderr=subprocess.DEVNULL, timeout=0.8
        ).decode("utf-8", errors="ignore")
    except Exception:
        return False

    targets = targets_out.splitlines()
    latest_hash = clip_storage.get_latest_hash()
    now = time.localtime()
    date_str = time.strftime("%d/%m/%Y", now)
    time_str = time.strftime("%H:%M:%S", now)
    timestamp = int(time.time())

    # Image
    if "image/png" in targets:
        try:
            img_data = subprocess.check_output(
                ["xclip", "-selection", "clipboard", "-t", "image/png", "-o"],
                stderr=subprocess.DEVNULL, timeout=1.0
            )
        except Exception:
            return False

        if not img_data or len(img_data) < 32:
            return False

        img_hash = hashlib.sha256(img_data).hexdigest()
        if latest_hash == img_hash:
            return False

        dim = get_png_dimensions(img_data)
        dim_str = f"{dim[0]} × {dim[1]}" if dim else "PNG Image"
        size_str = format_size(len(img_data))
        entry_id = f"{timestamp}_{img_hash[:8]}"
        file_path = ENTRIES_DIR / f"{entry_id}.png"

        with open(file_path, "wb") as f:
            f.write(img_data)

        new_entry = {
            "id": entry_id,
            "type": "image",
            "date": date_str,
            "time": time_str,
            "hash": img_hash,
            "summary_title": f"Ảnh chụp ({dim_str}, {size_str})",
            "file_path": str(file_path),
            "dimensions": dim_str,
            "size_str": size_str,
            "created_at": timestamp
        }
        clip_storage.add_entry(new_entry)
        return True

    # Text
    text_targets = [t for t in targets if t in ("UTF8_STRING", "TEXT", "STRING", "text/plain")]
    if text_targets:
        try:
            text_data = subprocess.check_output(
                ["xclip", "-selection", "clipboard", "-o"],
                stderr=subprocess.DEVNULL, timeout=0.8
            ).decode("utf-8", errors="replace")
        except Exception:
            return False

        stripped = text_data.strip()
        if not stripped or len(text_data) > 2 * 1024 * 1024:
            return False

        text_hash = hashlib.sha256(text_data.encode("utf-8")).hexdigest()
        if latest_hash == text_hash:
            return False

        first_line = stripped.splitlines()[0].strip()
        short_line = first_line[:48] + "…" if len(first_line) > 50 else first_line
        icon_symbol = "󰈙"
        category = "text"
        if stripped.startswith("http://") or stripped.startswith("https://"):
            icon_symbol = "󰌨"
            category = "url"
        elif any(k in first_line for k in ("import ", "def ", "class ", "function ", "const ", "let ", "var ", "#!/")):
            icon_symbol = "󰘦"
            category = "code"

        entry_id = f"{timestamp}_{text_hash[:8]}"
        file_path = ENTRIES_DIR / f"{entry_id}.txt"
        with open(file_path, "w", encoding="utf-8") as f:
            f.write(text_data)

        new_entry = {
            "id": entry_id,
            "type": "text",
            "category": category,
            "date": date_str,
            "time": time_str,
            "hash": text_hash,
            "icon_symbol": icon_symbol,
            "summary_title": short_line,
            "text": text_data,
            "file_path": str(file_path),
            "line_count": len(text_data.splitlines()),
            "char_count": len(text_data),
            "size_str": format_size(len(text_data.encode("utf-8"))),
            "created_at": timestamp
        }
        clip_storage.add_entry(new_entry)
        return True

    return False

# ==============================================================================
# 4. LAZY MODULE LOADER (POPOVERS & CLIPBOARD UI)
# ==============================================================================
_popover_mod = None
_clip_mod = None

def get_popover_module():
    global _popover_mod
    if _popover_mod is None:
        p = _SCRIPTS_BIN / "dwm-dropdown"
        if not p.exists():
            p = Path(os.path.expanduser("~/.local/bin/dwmblocks-scripts/dwm-dropdown"))
        saved_argv = sys.argv
        sys.argv = ["dwm-dropdown", "--daemon"]
        loader = importlib.machinery.SourceFileLoader("dwm_dropdown", str(p))
        _popover_mod = loader.load_module()
        sys.argv = saved_argv
    return _popover_mod

def get_clip_module():
    global _clip_mod
    if _clip_mod is None:
        p = _SCRIPT_DIR / "ka-clip"
        if not p.exists():
            p = Path(os.path.expanduser("~/.local/bin/ka-clip"))
        saved_argv = sys.argv
        sys.argv = ["ka-clip", "--daemon"]
        loader = importlib.machinery.SourceFileLoader("ka_clip", str(p))
        _clip_mod = loader.load_module()
        sys.argv = saved_argv
    return _clip_mod

# Active UI states
active_state = {
    "pop_win": None,
    "pop_target": None,
    "clip_win": None
}

def close_popover():
    if active_state["pop_win"]:
        try:
            active_state["pop_win"].destroy()
        except Exception:
            pass
        active_state["pop_win"] = None
        active_state["pop_target"] = None

def close_clipboard():
    if active_state["clip_win"]:
        try:
            active_state["clip_win"].destroy()
        except Exception:
            pass
        active_state["clip_win"] = None

def toggle_popover(target: str) -> str:
    # If same target is currently open -> toggle off
    if active_state["pop_win"] and active_state["pop_target"] == target:
        close_popover()
        return "OK_TOGGLED"

    close_popover()
    close_clipboard()

    mod = get_popover_module()
    win = mod.create_dropdown(target)
    if win:
        active_state["pop_win"] = win
        active_state["pop_target"] = target
        win.connect("destroy", lambda w: close_popover())
        win.show_all()
        win.present()
        return "OK_SHOWN"
    return "ERR_UNKNOWN"

def toggle_clipboard() -> str:
    if active_state["clip_win"]:
        close_clipboard()
        return "OK_TOGGLED"

    close_popover()

    mod = get_clip_module()
    win = mod.ClipboardWindow(on_close_cb=lambda: close_clipboard())
    # Override history data from RAM SQLite
    win.history = clip_storage.get_history()
    active_state["clip_win"] = win
    win.show_window()
    return "OK_SHOWN"

# ==============================================================================
# 5. UNIFIED SOCKET SERVER & IPC
# ==============================================================================
def setup_sockets():
    for p in (DAEMON_SOCK, DROPDOWN_SOCK, CLIP_SOCK):
        try:
            if os.path.exists(p) or os.path.islink(p):
                os.unlink(p)
        except Exception:
            pass

    server_sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server_sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    server_sock.bind(DAEMON_SOCK)
    server_sock.listen(8)
    server_sock.setblocking(False)

    # Symlink legacy sockets to unified socket for 100% backward compatibility
    try:
        os.symlink(DAEMON_SOCK, DROPDOWN_SOCK)
        os.symlink(DAEMON_SOCK, CLIP_SOCK)
    except Exception:
        pass

    return server_sock

def handle_socket_request(raw_data: str) -> str:
    try:
        req = json.loads(raw_data)
    except Exception:
        raw = raw_data.strip().lower()
        if "toggle" in raw or "show" in raw:
            return toggle_clipboard()
        return "ERR_BAD_JSON"

    req_type = req.get("type", "").lower()
    action = req.get("action", "").lower()
    target = req.get("target", "").lower()

    if action == "stop":
        GLib.idle_add(Gtk.main_quit)
        return "OK_STOPPING"

    if action == "status":
        mem_info = clip_storage.get_history()
        return json.dumps({
            "status": "running",
            "pid": os.getpid(),
            "clipboard_entries": len(mem_info),
            "active_popover": active_state["pop_target"],
            "active_clip": active_state["clip_win"] is not None
        })

    if req_type == "clip" or (action in ("toggle", "menu", "show") and not target):
        if action == "clear":
            clip_storage.clear()
            return "OK_CLEARED"
        return toggle_clipboard()

    if req_type == "pop" or target:
        target_name = target or "volume"
        return toggle_popover(target_name)

    return "ERR_UNKNOWN_REQ"

# ==============================================================================
# 6. CLIPBOARD BACKGROUND MONITOR
# ==============================================================================
def start_clip_monitor(stop_event: threading.Event):
    has_clipnotify = subprocess.run(["which", "clipnotify"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0

    def monitor_loop():
        capture_clipboard()
        while not stop_event.is_set():
            if has_clipnotify:
                ret = subprocess.run(["clipnotify"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                if ret.returncode == 0:
                    if capture_clipboard() and active_state["clip_win"]:
                        GLib.idle_add(active_state["clip_win"].refresh_data)
            else:
                time.sleep(0.8)
                if capture_clipboard() and active_state["clip_win"]:
                    GLib.idle_add(active_state["clip_win"].refresh_data)

    t = threading.Thread(target=monitor_loop, daemon=True)
    t.start()
    return t

# ==============================================================================
# 7. MAIN ENTRYPOINT
# ==============================================================================
def main():
    # Enforce strictly 1 daemon instance
    my_pid = os.getpid()
    if PID_FILE.exists():
        try:
            old_pid = int(PID_FILE.read_text().strip())
            if old_pid != my_pid:
                try:
                    os.kill(old_pid, signal.SIGTERM)
                    time.sleep(0.1)
                except ProcessLookupError:
                    pass
        except Exception:
            pass

    PID_FILE.write_text(str(my_pid))
    server_sock = setup_sockets()

    def on_socket_readable(source, condition):
        try:
            conn, _ = server_sock.accept()
            conn.settimeout(0.2)
            data = conn.recv(1024).decode("utf-8").strip()
            if data:
                resp = handle_socket_request(data)
                conn.sendall(f"{resp}\n".encode("utf-8"))
            conn.close()
        except Exception:
            try:
                conn.close()
            except Exception:
                pass
        return True

    GLib.io_add_watch(server_sock.fileno(), GLib.IOCondition.IO_IN, on_socket_readable)

    stop_event = threading.Event()
    start_clip_monitor(stop_event)

    def cleanup():
        stop_event.set()
        close_popover()
        close_clipboard()
        clip_storage.sync_to_disk()
        for p in (DAEMON_SOCK, DROPDOWN_SOCK, CLIP_SOCK, PID_FILE):
            try:
                if isinstance(p, Path):
                    p.unlink(missing_ok=True)
                elif os.path.exists(p) or os.path.islink(p):
                    os.unlink(p)
            except Exception:
                pass

    atexit.register(cleanup)

    def handle_signal(sig, frame):
        cleanup()
        Gtk.main_quit()
        sys.exit(0)

    signal.signal(signal.SIGINT, handle_signal)
    signal.signal(signal.SIGTERM, handle_signal)

    # Initial capture
    capture_clipboard()

    Gtk.main()

if __name__ == "__main__":
    main()
