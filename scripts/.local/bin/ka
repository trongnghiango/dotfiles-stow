#!/usr/bin/env bash
# ==============================================================================
# ka — Unified System Manager & CLI Orchestrator (Omarchy-X11 Architecture)
# ==============================================================================
# ka:summary=Single entrypoint CLI for system control, theming, popovers & diagnostics
# ka:args=[theme|default|clip|share|pop|dns|dev|ocr|record|night|notify|setup|stow|profile|doctor|version]
# ka:examples=ka theme nord | ka share menu | ka share file doc.pdf | ka pop volume | ka dns cloudflare | ka ocr | ka doctor
# ==============================================================================

set -eo pipefail

_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PATH="$_SCRIPT_DIR:$_SCRIPT_DIR/dmenu-scripts:$PATH"

VERSION="1.0.0"
DWM_VER="6.8"

# Colors & Formatting
BOLD="\033[1m"
DIM="\033[2m"
CYAN="\033[36m"
GREEN="\033[32m"
YELLOW="\033[33m"
RED="\033[31m"
RESET="\033[0m"

print_banner() {
  echo -e "${BOLD}${CYAN}ka${RESET} — ${DIM}Unified System CLI (Omarchy-X11 Architecture, DWM ${DWM_VER})${RESET}"
}

usage() {
  print_banner
  echo ""
  echo -e "${BOLD}CÁCH SỬ DỤNG:${RESET}"
  echo -e "  ${CYAN}ka${RESET} <lệnh> [tham số...]"
  echo ""
  echo -e "${BOLD}DANH SÁCH LỆNH CỐT LÕI:${RESET}"
  echo -e "  ${GREEN}theme${RESET}   [nord|gruvbox-dark|catppuccin-mocha]   Đổi theme giao diện toàn hệ thống tức thì"
  echo -e "  ${GREEN}default${RESET} [show|set <cat> <app>]                 Quản lý & chọn ứng dụng mặc định một chạm (Rofi / CLI)"
  echo -e "  ${GREEN}clip${RESET}    [menu|daemon|clear|status]            Quản lý lịch sử clipboard 2 cột (Text & Ảnh) qua Rofi"
  echo -e "  ${GREEN}share${RESET}   [clipboard|file|folder|receive|web]   Chia sẻ file, folder & clipboard (LocalSend, Web QR, Taildrop)"
  echo -e "  ${GREEN}pop${RESET}     <module>                              Bật/Tắt thẻ popup Omarchy (volume, clock, battery, cpu, mem, net, weather)"
  echo -e "  ${GREEN}dns${RESET}    [dhcp|cloudflare|google|custom <ip>]  Chuyển đổi máy chủ phân giải DNS nhanh"
  echo -e "  ${GREEN}wifi${RESET}   [menu|connect|scan|status|toggle|qr]   Quản lý & kết nối Wi-Fi toàn diện (thay thế nmtui)"
  echo -e "  ${GREEN}weather${RESET}                                        Cập nhật vi khí hậu & radar mưa tức thời (Nowcasting 1km²)"
  echo -e "  ${GREEN}dev${RESET}    [setup|status|update]                 Quản lý toàn bộ dev runtimes (Node, Python, Go, Rust, Bun, PNPM) qua Mise"
  echo -e "  ${GREEN}ocr${RESET}    [--lang eng|vie] [--stdout]           Bóc tách chữ trên màn hình bằng OCR vào Clipboard"
  echo -e "  ${GREEN}record${RESET} [toggle|status]                      Bật/Tắt quay video màn hình"
  echo -e "  ${GREEN}night${RESET}  [on|off|toggle|status]                Bật/Tắt chế độ làm việc ban đêm (Lọc ánh sáng xanh 4000K + dịu mắt)"
  echo -e "  ${GREEN}notify${RESET} [center|dnd|clear|status|test]        Quản lý thông báo, DND và mở Notification Center Right Sidebar"
  echo -e "  ${GREEN}setup${RESET}  [all|suckless|stow|pkgs]              Tự động hóa triển khai gói và dotfiles"
  echo -e "  ${GREEN}stow${RESET}   <package>                             Triển khai an toàn gói cấu hình qua stow-safe"
  echo -e "  ${GREEN}profile${RESET} [detect|set <name>|list|show]         Quản lý & tự động nhận diện cấu hình phần cứng (Laptop/Desktop)"
  echo -e "  ${GREEN}doctor${RESET}                                       Chẩn đoán sức khỏe, công cụ và tính toàn vẹn hệ thống"
  echo -e "  ${GREEN}version${RESET}                                      Hiển thị thông tin phiên bản"
  echo ""
}

# --- SUBCOMMANDS ---

cmd_theme() {
  local target="${1:-}"
  if [[ -z "$target" ]]; then
    theme-set
  else
    theme-set "$target"
  fi
}

cmd_default() {
  ka-default "$@"
}

cmd_clip() {
  local action="${1:-menu}"
  case "$action" in
    menu|toggle|"")
      ka-pop clip &
      ;;
    daemon)
      ka-clipd &
      ;;
    clear)
      rm -f "${XDG_CACHE_HOME:-$HOME/.cache}/ka-clip/history.json"
      echo "Clipboard history cleared."
      ;;
    status)
      if pgrep -x ka-clipd >/dev/null 2>&1; then
        echo "ka-clipd is running (PID: $(pgrep -x ka-clipd))"
      else
        echo "ka-clipd is not running."
      fi
      ;;
    *)
      ka-pop clip &
      ;;
  esac
}

cmd_share() {
  ka-share "$@"
}

cmd_pop() {
  local module="${1:-volume}"
  ka-pop "$module" &
}

cmd_dns() {
  set-dns "$@"
}

cmd_ocr() {
  ka-ocr "$@"
}

cmd_record() {
  record "$@"
}

cmd_night() {
  ka-night "$@"
}

cmd_notify() {
  local sub="${1:-center}"
  shift || true
  case "$sub" in
    center|toggle|open)
      ka-pop notify &
      ;;
    dnd|mute|pause)
      dunstctl set-paused toggle 2>/dev/null || true
      pkill -RTMIN+8 dwmblocks 2>/dev/null || true
      local state
      state=$(dunstctl is-paused 2>/dev/null || echo "unknown")
      echo "Do Not Disturb: $state"
      ;;
    clear)
      dunstctl history-clear 2>/dev/null || true
      pkill -RTMIN+8 dwmblocks 2>/dev/null || true
      echo "Notification history cleared."
      ;;
    status)
      sb-notify
      ;;
    test)
      echo "Sending test notifications across channels..."
      notify-send -u low -i info "P3: Ephemeral" "Âm lượng đã đặt thành 50%"
      sleep 0.3
      notify-send -u normal -i git "P2: Dev Task" "Build Succeeded: 14/14 tests passed in 1.2s"
      sleep 0.3
      notify-send -u critical -i battery-caution "P0: Critical Alert" "Mức pin dưới 15%! Vui lòng cắm sạc ngay."
      pkill -RTMIN+8 dwmblocks 2>/dev/null || true
      echo "✔ Đã gửi 3 thông báo mẫu (Low, Normal, Critical)."
      ;;
    *)
      echo "Usage: ka notify [center|dnd|clear|status|test]"
      ;;
  esac
}

cmd_dev() {
  local sub="${1:-status}"
  shift || true
  case "$sub" in
    setup|install)
      echo -e "${BOLD}${CYAN}Thiết lập toàn bộ Dev Runtimes qua Mise (~/.config/mise/config.toml)...${RESET}"
      if ! command -v mise >/dev/null 2>&1; then
        echo -e "${YELLOW}Chưa phát hiện mise. Vui lòng cài đặt mise bằng một trong hai cách:${RESET}"
        echo -e "  Cách 1 (Package Manager): ${GREEN}sudo pacman -S mise${RESET} hoặc qua kho APT / PPA"
        echo -e "  Cách 2 (User space):      ${GREEN}curl https://mise.run | sh${RESET}"
        return 1
      fi
      echo -e "${GREEN}Mise đã sẵn sàng. Đang tiến hành tải và cấu hình các runtimes (node, python, rust, go, pnpm, bun)...${RESET}"
      mise install "$@"
      echo -e "${GREEN}✔ Hoàn tất cài đặt toàn bộ dev runtimes qua Mise!${RESET}"
      ;;
    status|ls|list)
      if command -v mise >/dev/null 2>&1; then
        echo -e "${BOLD}Các Dev Runtimes đang được quản lý bởi Mise (~/.config/mise/config.toml):${RESET}"
        mise ls "$@"
      else
        echo -e "${RED}Chưa cài đặt Mise. Chạy 'curl https://mise.run | sh' sau đó chạy 'ka dev setup' để bắt đầu.${RESET}"
      fi
      ;;
    update|upgrade)
      if command -v mise >/dev/null 2>&1; then
        echo -e "${BOLD}${CYAN}Nâng cấp toàn bộ Dev Runtimes lên phiên bản mới nhất...${RESET}"
        mise upgrade "$@"
      else
        echo -e "${RED}Chưa cài đặt Mise.${RESET}"
      fi
      ;;
    *)
      if command -v mise >/dev/null 2>&1; then
        mise "$sub" "$@"
      else
        echo -e "${BOLD}CÁC LỆNH QUẢN LÝ DEV RUNTIME (MISE):${RESET}"
        echo "  ka dev setup    - Tải và cài đặt toàn bộ SDKs (Node LTS, Python, Rust, Go, PNPM, Bun)"
        echo "  ka dev status   - Xem danh sách và phiên bản các runtimes đang hoạt động"
        echo "  ka dev update   - Cập nhật tất cả các runtimes lên bản mới nhất"
      fi
      ;;
  esac
}

cmd_setup() {
  ka-setup "$@"
}

cmd_stow() {
  stow-safe "$@"
}

detect_libc() {
  if ldd --version 2>&1 | grep -qi "musl"; then
    echo "musl"
  elif ldd --version 2>&1 | grep -qi "gnu"; then
    local ver
    ver=$(getconf GNU_LIBC_VERSION 2>/dev/null | awk '{print $2}')
    [ -z "$ver" ] && ver=$(ldd --version 2>&1 | awk 'NR==1 {print $NF}')
    echo "glibc ${ver:-}"
  elif [ -f /lib/ld-musl-x86_64.so.1 ] || [ -f /lib/ld-musl-aarch64.so.1 ]; then
    echo "musl"
  else
    echo "unknown"
  fi
}

cmd_doctor() {
  print_banner
  echo -e "${BOLD}BẮT ĐẦU CHẨN ĐOÁN HỆ THỐNG (SYSTEM INTEGRITY CHECK)...${RESET}\n"

  local all_pass=true

  check_item() {
    local label="$1"
    local check_cmd="$2"
    if eval "$check_cmd" >/dev/null 2>&1; then
      echo -e "  [${GREEN}PASS${RESET}] $label"
    else
      echo -e "  [${RED}FAIL${RESET}] $label"
      all_pass=false
    fi
  }

  local libc_type
  libc_type="$(detect_libc)"
  echo -e "${BOLD}1. C Runtime Environment (Libc):${RESET}"
  echo -e "  [${GREEN}PASS${RESET}] C Library: ${CYAN}${libc_type}${RESET}"

  echo -e "\n${BOLD}2. Window Manager & Suckless Binaries:${RESET}"
  check_item "DWM binary (/usr/local/bin/dwm)" "test -x /usr/local/bin/dwm"
  check_item "DWM active in PATH ($(which dwm 2>/dev/null))" "test \"$(which dwm 2>/dev/null)\" = \"/usr/local/bin/dwm\""
  check_item "ST terminal (/usr/local/bin/st)" "test -x /usr/local/bin/st"
  check_item "Dmenu (/usr/local/bin/dmenu)" "test -x /usr/local/bin/dmenu"
  check_item "Dwmblocks (/usr/local/bin/dwmblocks)" "test -x /usr/local/bin/dwmblocks"

  echo -e "\n${BOLD}3. X11 Core & Visual Tools:${RESET}"
  check_item "Xorg Server" "command -v Xorg"
  check_item "Picom Compositor" "command -v picom"
  check_item "Maim Screenshot" "command -v maim"
  check_item "Slop Region Selector" "command -v slop"
  check_item "Xclip Clipboard" "command -v xclip"
  check_item "Tesseract OCR" "command -v tesseract"
  check_item "XDG MIME Tool (xdg-mime)" "command -v xdg-mime"

  echo -e "\n${BOLD}4. Audio & Network Stack:${RESET}"
  check_item "PipeWire Audio Server" "command -v pipewire"
  check_item "WirePlumber Session Manager" "command -v wireplumber"
  check_item "NetworkManager (nmcli)" "command -v nmcli"

  echo -e "\n${BOLD}5. Theming & Hardware Profile:${RESET}"
  check_item "Current Theme Config (~/.config/theme/colors/current.conf)" "test -f \$HOME/.config/theme/colors/current.conf"
  check_item "Hardware Profile (~/.config/hardware/current.conf)" "test -f \$HOME/.config/hardware/current.conf"
  check_item "Native C Popovers (ka-pop)" "command -v ka-pop || test -x \"/usr/local/bin/ka-pop\""
  check_item "Native C Clipboard Daemon (ka-clipd)" "command -v ka-clipd || test -x \"/usr/local/bin/ka-clipd\""
  check_item "Default Handlers Selector (ka-default)" "command -v ka-default || test -x \"$_SCRIPT_DIR/ka-default\""

  echo -e "\n${BOLD}6. Developer Runtimes:${RESET}"
  if command -v mise >/dev/null 2>&1; then
    local mise_ver
    mise_ver=$(mise --version 2>/dev/null | awk '{print $1}')
    echo -e "  [${GREEN}PASS${RESET}] Mise Runtime Manager (${mise_ver})"
  else
    echo -e "  [${RED}FAIL${RESET}] Mise Runtime Manager (${YELLOW}Chưa cài đặt. Chạy 'curl https://mise.run | sh' hoặc cài qua package manager${RESET})"
    all_pass=false
  fi
  check_item "Neovim (nvim)" "command -v nvim"
  check_item "Tmux Multiplexer" "command -v tmux"
  check_item "Zsh Shell" "command -v zsh"

  echo -e "\n${BOLD}7. File & Folder Sharing Stack (LocalSend / Web QR):${RESET}"
  check_item "ka-share CLI" "command -v ka-share || test -x \"$_SCRIPT_DIR/ka-share\""
  check_item "Python3 Web Share Engine" "command -v python3"
  check_item "LocalSend Binary / Flatpak" "command -v localsend || (command -v flatpak >/dev/null 2>&1 && flatpak info org.localsend.localsend_app >/dev/null 2>&1)"
  check_item "QR Code Generator (qrencode)" "command -v qrencode"

  echo ""
  if [[ "$all_pass" == true ]]; then
    echo -e "${BOLD}${GREEN}✔ HỆ THỐNG HOÀN TOÀN KHỎE MẠNH VÀ SẴN SÀNG!${RESET}\n"
  else
    echo -e "${BOLD}${YELLOW}⚠ Phát hiện một số công cụ chưa hoàn thiện. Chạy 'ka setup all' để hoàn tất cấu hình.${RESET}\n"
  fi
}

cmd_profile() {
  ka-profile "$@"
}

cmd_version() {
  print_banner
  local detected_os="Linux"
  [ -f /etc/os-release ] && detected_os="$(. /etc/os-release && echo "$PRETTY_NAME")"
  echo "CLI Version: ${VERSION}"
  echo "DWM Core:    ${DWM_VER}"
  echo "Host OS:     ${detected_os} (X11 Native Architecture)"
}

# --- MAIN DISPATCHER ---

SUBCMD="${1:-}"
shift || true

case "$SUBCMD" in
  theme)
    cmd_theme "$@"
    ;;
  default|handler|handlers)
    cmd_default "$@"
    ;;
  clip|clipboard)
    cmd_clip "$@"
    ;;
  share|transfer)
    cmd_share "$@"
    ;;
  pop|dropdown)
    cmd_pop "$@"
    ;;
  dns)
    cmd_dns "$@"
    ;;
  wifi|wlan)
    ka-wifi "$@"
    ;;
  weather|forecast)
    ka-weather "$@"
    ;;
  ocr)
    cmd_ocr "$@"
    ;;
  record)
    cmd_record "$@"
    ;;
  night|nightshift|redshift)
    cmd_night "$@"
    ;;
  notify|notification|nc)
    cmd_notify "$@"
    ;;
  setup)
    cmd_setup "$@"
    ;;
  dev|mise)
    cmd_dev "$@"
    ;;
  stow)
    cmd_stow "$@"
    ;;
  daemon)
    cmd_daemon "$@"
    ;;
  profile|hardware|host)
    cmd_profile "$@"
    ;;
  doctor)
    cmd_doctor
    ;;
  -v|--version|version)
    cmd_version
    ;;
  -h|--help|help|"")
    usage
    ;;
  *)
    echo -e "${RED}Lỗi: Không nhận diện được lệnh '${SUBCMD}'${RESET}" >&2
    usage >&2
    exit 1
    ;;
esac
