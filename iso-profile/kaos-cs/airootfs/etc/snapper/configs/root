# KaOS-CS snapper config for root (/)
# Created by snapper-setup during install

# Subvolume to snapshot
SUBVOLUME="/"

# Filesystem type
FSTYPE="btrfs"

# Users and groups allowed to access snapshots
ALLOW_USERS=""
ALLOW_GROUPS="wheel"

# Sync after creating snapshot
SYNC_ACL="no"

# Background comparison (for timeline)
BACKGROUND_COMPARISON="yes"

# Number cleanup (numbered snapshots)
NUMBER_CLEANUP="yes"
NUMBER_LIMIT="50"
NUMBER_LIMIT_IMPORTANT="10"
NUMBER_MIN_AGE="1800"

# Timeline cleanup (hourly/daily/weekly/monthly/yearly)
TIMELINE_CREATE="yes"
TIMELINE_CLEANUP="yes"
TIMELINE_LIMIT_HOURLY="10"
TIMELINE_LIMIT_DAILY="10"
TIMELINE_LIMIT_WEEKLY="4"
TIMELINE_LIMIT_MONTHLY="3"
TIMELINE_LIMIT_YEARLY="2"

# Empty pre/post cleanup
EMPTY_PRE_POST_CLEANUP="yes"
EMPTY_PRE_POST_MIN_AGE="1800"

# Qgroup support (for accurate space usage)
QGROUP="0"

# Space limit (0 = unlimited)
SPACE_LIMIT="0"