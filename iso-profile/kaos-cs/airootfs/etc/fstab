# KaOS-CS /etc/fstab
# Btrfs subvolume layout for Snapper + GRUB-Btrfs
# Subvolumes: @ (root), @home, @snapshots, @log, @pkg
# 
# Generated by archiso profile - actual UUIDs will be set during install
# The install script will replace UUID placeholders

# Root subvolume @
UUID=ROOT_UUID  /           btrfs   rw,noatime,compress=zstd:3,space_cache=v2,subvol=@       0 0

# Home subvolume @home
UUID=ROOT_UUID  /home       btrfs   rw,noatime,compress=zstd:3,space_cache=v2,subvol=@home   0 0

# Snapshots subvolume @snapshots (for snapper)
UUID=ROOT_UUID  /.snapshots btrfs   rw,noatime,compress=zstd:3,space_cache=v2,subvol=@snapshots 0 0

# Log subvolume @log
UUID=ROOT_UUID  /var/log    btrfs   rw,noatime,compress=zstd:3,space_cache=v2,subvol=@log    0 0

# Package cache subvolume @pkg
UUID=ROOT_UUID  /var/cache/pacman/pkg btrfs rw,noatime,compress=zstd:3,space_cache=v2,subvol=@pkg 0 0

# EFI System Partition
UUID=ESP_UUID   /boot       vfat    rw,relatime,fmask=0022,dmask=0022,codepage=437,iocharset=ascii,shortname=mixed,utf8,errors=remount-ro 0 2

# Swap (zram handled by zram-generator, this is fallback)
# UUID=SWAP_UUID  none        swap    defaults 0 0

# tmpfs for /tmp
tmpfs           /tmp        tmpfs   rw,nosuid,nodev,size=2G,mode=1777 0 0

# tmpfs for build directories
tmpfs           /var/tmp    tmpfs   rw,nosuid,nodev,size=1G,mode=1777 0 0