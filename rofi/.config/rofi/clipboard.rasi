/**
 * Rofi Clipboard Theme — Two-Pane Master/Detail Split View
 * Golden Ratio 2 : 3 Layout (Left 380px : Right 570px)
 * Omarchy / DHH Design Standard (0px border-radius, 2px accent border)
 * Left: Chronological items with concise summaries & icons (2 parts)
 * Right: Full content preview with real image & text details (3 parts)
 **/

@import "config.rasi"
@import "colors.rasi"

window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       1000px;
    height:                      540px;
    x-offset:                    0px;
    y-offset:                    0px;

    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      2px solid;
    border-radius:               0px;
    border-color:                @border;
    background-color:            @background;
    cursor:                      "default";
}

mainbox {
    enabled:                     true;
    spacing:                     12px;
    margin:                      0px;
    padding:                     14px;
    border:                      0px solid;
    border-radius:               0px;
    background-color:            transparent;
    children:                    [ "inputbar", "body" ];
}

inputbar {
    enabled:                     true;
    spacing:                     8px;
    margin:                      0px;
    padding:                     8px 12px;
    border:                      0px solid;
    border-radius:               0px;
    background-color:            @background-alt;
    text-color:                  @foreground;
    children:                    [ "prompt", "entry" ];
}

prompt {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  @selected;
    font:                        "JetBrains Mono Nerd Font 11";
}

entry {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      text;
    placeholder:                 "Tìm kiếm lịch sử bản sao (Text / Ảnh / Code)...";
    placeholder-color:           @foreground-dim;
    font:                        "JetBrains Mono 11";
}

body {
    enabled:                     true;
    orientation:                 horizontal;
    spacing:                     14px;
    margin:                      0px;
    padding:                     0px;
    background-color:            transparent;
    children:                    [ "listview", "preview-box" ];
}

/* TỶ LỆ 2 : 3 (BÊN TRÁI 2 PHẦN = 380px) */
listview {
    enabled:                     true;
    width:                       380px;
    columns:                     1;
    lines:                       9;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    
    spacing:                     4px;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      "default";
}

element {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     8px 10px;
    border:                      0px solid;
    border-radius:               0px;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      pointer;
    children:                    [ "element-icon", "element-text" ];
}

element normal.normal {
    background-color:            transparent;
    text-color:                  @foreground;
}

element selected.normal {
    background-color:            @selected;
    text-color:                  @background;
}

element-icon {
    background-color:            transparent;
    text-color:                  inherit;
    size:                        22px;
    cursor:                      inherit;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    highlight:                   inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}

/* TỶ LỆ 2 : 3 (BÊN PHẢI 3 PHẦN = 574px) */
preview-box {
    enabled:                     true;
    orientation:                 vertical;
    width:                       574px;
    spacing:                     12px;
    margin:                      0px;
    padding:                     14px;
    border:                      1px solid;
    border-radius:               0px;
    border-color:                @border;
    background-color:            @background-alt;
    children:                    [ "preview-title", "icon-current-entry", "textbox-current-entry" ];
}

preview-title {
    enabled:                     true;
    expand:                      false;
    content:                     "󰅍  CHI TIẾT BẢN SAO (PREVIEW)";
    font:                        "JetBrains Mono Bold 10";
    text-color:                  @selected;
    horizontal-align:            0.0;
}

icon-current-entry {
    enabled:                     true;
    expand:                      false;
    size:                        200px;
    squared:                     false;
    horizontal-align:            0.5;
    vertical-align:              0.5;
    background-color:            transparent;
}

textbox-current-entry {
    enabled:                     true;
    expand:                      true;
    font:                        "JetBrains Mono 10";
    background-color:            transparent;
    text-color:                  @foreground;
    horizontal-align:            0.0;
    vertical-align:              0.0;
    placeholder:                 "Chọn một bản sao để xem chi tiết...";
    placeholder-color:           @foreground-dim;
}
