/* Auto-generated by theme-set — KHÔNG sửa tay */
/* Nguồn sự thật: ~/.config/theme/colors/current.conf */

* {
    /* Palette definition */
    background:     #2e3440f2;
    background-alt: #3b4252ee;
    foreground:     #d8dee9;
    foreground-dim: #e5e9f0;
    selected:       #88c0d0;
    active:         #a3be8c;
    urgent:         #bf616a;
    border:         #88c0d0;

    /* Semantic shortcuts */
    bg:             @background;
    bg-alt:         @background-alt;
    fg:             @foreground;
    accent:         @selected;

    background-color: transparent;
    text-color:       @foreground;
}

window {
    border-color:     @border;
    background-color: @background;
}

element selected.normal {
    background-color: @selected;
    text-color:       #2e3440;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
}

element-icon {
    background-color: transparent;
}
