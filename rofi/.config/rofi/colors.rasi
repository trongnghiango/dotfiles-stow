/* Auto-generated by theme-set — KHÔNG sửa tay */
/* Nguồn sự thật: ~/.config/theme/colors/current.conf */

* {
    /* Base colors from theme palette */
    bg:       #282828;
    bg-alt:   #282828;
    fg:       #ebdbb2;
    fg-dim:   #a89984;
    accent:   #fe8019;
    red:      #cc241d;
    green:    #98971a;

    /* Rofi semantic colors with alpha */
    background-color: @bg;
    text-color:       @fg;
}

window {
    border-color: @accent;
}

element selected {
    background-color: @accent;
    text-color:       #282828;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
}

element-icon {
    background-color: transparent;
}
