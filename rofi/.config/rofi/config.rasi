/* Rofi general configuration */
configuration {
    modi:                       "drun,run,filebrowser,window";
    font:                       "JetBrains Mono 11";
    show-icons:                 true;
    icon-theme:                 "Papirus";
    display-drun:               "  APPS";
    display-run:                "  RUN";
    display-filebrowser:        "  FILES";
    display-window:             "  WINDOWS";
    drun-display-format:        "{name}";
    hover-select:               true;
    me-select-entry:            "";
    me-accept-entry:            "MousePrimary";
    window-format:              "{w} · {c} · {t}";
    click-to-exit:              true;
    
    /* Ergonomic Navigation: Tab/Shift-Tab & Vim keys (j/k) navigate items; NEVER jump modes unexpectedly */
    kb-mode-next:               "Control+Tab";
    kb-mode-previous:           "Control+ISO_Left_Tab";
    kb-row-down:                "Down,Control+n,Control+j,Tab";
    kb-row-up:                  "Up,Control+p,Control+k,ISO_Left_Tab";
    kb-element-next:            "";
    kb-element-prev:            "";
    kb-row-tab:                 "";
    kb-remove-to-eol:           "";
    kb-accept-entry:            "Return,KP_Enter,Control+m";
    kb-cancel:                  "Escape,Control+bracketleft";
}
