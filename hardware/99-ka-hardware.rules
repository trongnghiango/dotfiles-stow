# ==============================================================================
# 99-ka-hardware.rules — Kernel Udev Hardware Tuning for ThinkPad & Laptops
# Tự động hóa ở mức Kernel/Init: CPU Governor & Ngưỡng sạc pin ThinkPad
# ==============================================================================

# 1. CPU Governor: Đặt sang powersave cho CPU Intel mobile khi cắm nguồn hoặc chạy pin
ACTION=="add", SUBSYSTEM=="cpufreq", KERNEL=="scaling_governor", ATTR{scaling_governor}="powersave"

# 2. Ngưỡng sạc pin ThinkPad (Bắt đầu sạc ở 50%, dừng ở 60% để bảo vệ pin)
SUBSYSTEM=="power_supply", KERNEL=="BAT[0-9]", ATTR{charge_control_start_threshold}="50", ATTR{charge_control_end_threshold}="60"
