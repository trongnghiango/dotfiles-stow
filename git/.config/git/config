# ==============================================================================
# GLOBAL GIT CONFIGURATION — POWER-USER DEV STACK
# ==============================================================================
# File: ~/.config/git/config
# Managed by GNU Stow (Package: git)
# ==============================================================================

[user]
	name = KAKA
	email = trongnghia.ngo@hotmail.com

[init]
	defaultBranch = master

[alias]
	# Status & Navigation
	st = status -sb
	co = checkout
	br = branch -vv
	ci = commit
	cm = commit -m
	ca = commit --amend

	# Rich Logging & History
	lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	lga = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --all
	last = log -1 HEAD --stat

	# Diffs
	df = diff
	dc = diff --cached

	# Workflow helpers
	undo = reset --soft HEAD~1
	unstage = reset HEAD --
	prune-local = "!git branch -vv | grep ': gone]' | awk '{print $1}' | xargs -r git branch -d"

[pull]
	rebase = true

[push]
	autoSetupRemote = true
	default = simple

[fetch]
	prune = true
	pruneTags = true

[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true

[commit]
	verbose = true

[column]
	ui = auto

[branch]
	sort = -committerdate

[tag]
	sort = -version:refname

[rerere]
	enabled = true
	autoupdate = true

[core]
	autocrlf = input
	excludesFile = ~/.config/git/ignore
	pager = delta 2>/dev/null || less -RFX

[interactive]
	diffFilter = delta --color-only 2>/dev/null || cat

[delta]
	navigate = true
	light = false
	side-by-side = false
	line-numbers = true
	syntax-theme = Dracula
