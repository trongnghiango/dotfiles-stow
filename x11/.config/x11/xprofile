#!/bin/sh
# ==============================================================================
# 1. BIẾN MÔI TRƯỜNG & ĐƯỜNG DẪN PATH
# ==============================================================================
# Xuất đường dẫn script cá nhân và binary của người dùng
# PATH centralized to ~/.config/shell/profile
# ==============================================================================
# 2. ĐỒNG BỘ USER ENVIRONMENT (Single Source of Truth)
# ==============================================================================
# Nếu khởi động qua Display Manager (GDM/LightDM/SDDM), nạp biến từ shell profile
[ -z "$GTK_IM_MODULE" ] && [ -f "$HOME/.config/shell/profile" ] && . "$HOME/.config/shell/profile"

# ==============================================================================
# 3. CẤU HÌNH GTK FILE CHOOSER (Upload/Download sắp xếp file mới nhất lên đầu)
# ==============================================================================
if command -v gsettings >/dev/null 2>&1; then
  (
    for schema in org.gtk.Settings.FileChooser org.gtk.gtk4.Settings.FileChooser; do
      gsettings set "$schema" sort-column 'modified' 2>/dev/null
      gsettings set "$schema" sort-order 'descending' 2>/dev/null
      gsettings set "$schema" sort-directories-first true 2>/dev/null
    done
  ) &
fi

# ==============================================================================
# 4. KHAI BÁO MÔI TRƯỜNG DESKTOP (Cho Chromium / Electron / Desktop Portal)
# ==============================================================================
export XDG_CURRENT_DESKTOP="dwm"
export XDG_SESSION_DESKTOP="dwm"
