#!/usr/bin/env sh

# Ghi log khởi động X11 để debug (chỉ bật khi DEBUG=1 để tránh nghẽn I/O trên ổ cứng cũ)
if [ -n "$DEBUG" ]; then
  exec >"$HOME/.xinitrc.log" 2>&1
  set -x
fi

# ==============================================================================
# 1. KHỞI TẠO MÔI TRƯỜNG D-BUS
# ==============================================================================
# Ưu tiên sử dụng D-Bus session bus của systemd user session nếu có sẵn
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && [ -S "/run/user/$(id -u)/bus" ]; then
  export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus"
fi

if [ -z "$DBUS_SESSION_BUS_ADDRESS" ]; then
  if command -v dbus-launch >/dev/null 2>&1; then
    eval $(dbus-launch --sh-syntax --exit-with-session)
  fi
fi

if command -v dbus-update-activation-environment >/dev/null 2>&1; then
  # Tự động đồng bộ biến sang Systemd nếu có systemd, ngược lại chỉ đồng bộ D-Bus
  if command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd --all 2>/dev/null
  else
    dbus-update-activation-environment --all 2>/dev/null
  fi
fi

# Khởi động GTK Portal cho các ứng dụng GUI độc lập (Flatpak, Obsidian...)
for portal_path in "/usr/lib/xdg-desktop-portal-gtk" "/usr/libexec/xdg-desktop-portal-gtk"; do
  if [ -f "$portal_path" ]; then
    command -v xdg-desktop-portal >/dev/null 2>&1 && xdg-desktop-portal &
    "$portal_path" &
    break
  fi
done

# ==============================================================================
# 2. NẠP CẤU HÌNH BIẾN MÔI TRƯỜNG CÁ NHÂN, HARDWARE PROFILE & XRESOURCES
# ==============================================================================
[ -f "$HOME/.config/shell/profile" ] && . "$HOME/.config/shell/profile"

# Nạp Hardware Profile (Laptop / Desktop / ThinkPad)
HW_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/hardware/current.conf"
if [ -f "$HW_CONF" ]; then
  . "$HW_CONF"
  [ -n "$MESA_LOADER_DRIVER_OVERRIDE" ] && export MESA_LOADER_DRIVER_OVERRIDE
  [ -n "$LIBGL_DRI3_ENABLE" ] && export LIBGL_DRI3_ENABLE
fi

# Cấu hình Touchpad nếu profile là Laptop
if [ "${TOUCHPAD_ENABLED:-0}" = "1" ] && command -v xinput >/dev/null 2>&1; then
  for id in $(xinput list --id-only 2>/dev/null | grep -E '^[0-9]+$'); do
    xinput set-prop "$id" "libinput Tapping Enabled" 1 2>/dev/null || true
  done
fi

XPROFILE_PATH="${XDG_CONFIG_HOME:-$HOME/.config}/x11/xprofile"
if [ -f "$XPROFILE_PATH" ]; then
  . "$XPROFILE_PATH"
elif [ -f "$HOME/.xprofile" ]; then
  . "$HOME/.xprofile"
fi

XRESOURCES_PATH="${XDG_CONFIG_HOME:-$HOME/.config}/x11/xresources"
if [ -f "$XRESOURCES_PATH" ]; then
  command -v xrdb >/dev/null 2>&1 && xrdb -merge "$XRESOURCES_PATH"
fi

# ==============================================================================
# 3. CHẠY POLKIT & GNOME-KEYRING (ĐA DISTRO)
# ==============================================================================
for polkit_path in \
  "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1" \
  "/usr/libexec/polkit-gnome-authentication-agent-1" \
  "/usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1" \
  "/usr/lib/polkit-1-gnome/polkit-gnome-authentication-agent-1" \
  "/usr/libexec/polkit-mate-authentication-agent-1" \
  "/usr/lib/mate-polkit/polkit-mate-authentication-agent-1"; do
  if [ -x "$polkit_path" ]; then
    pgrep -f "$(basename "$polkit_path")" >/dev/null || "$polkit_path" &
    break
  fi
done
if ! pgrep -f "polkit.*authentication-agent-1" >/dev/null; then
  command -v lxpolkit >/dev/null 2>&1 && ! pgrep -x lxpolkit >/dev/null && lxpolkit &
fi

if command -v gnome-keyring-daemon >/dev/null 2>&1; then
  eval $(gnome-keyring-daemon --start --components=pkcs11,secrets,ssh)
  export SSH_AUTH_SOCK
fi

# ==============================================================================
# 4. NẠP CẤU HÌNH THEO TỪNG HỆ ĐIỀU HÀNH (ARCH / VOID / NIXOS)
# ==============================================================================
if [ -f /etc/os-release ]; then
  # Trích xuất ID và ID_LIKE hệ điều hành (ví dụ: arch, debian, void, nixos)
  OS=$(. /etc/os-release && echo "$ID")
  OS_LIKE=$(. /etc/os-release && echo "$ID_LIKE")

  OS_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/x11/xinitrc.$OS"
  if [ -f "$OS_CONFIG" ]; then
    . "$OS_CONFIG"
  elif [ -n "$OS_LIKE" ]; then
    for like in $OS_LIKE; do
      if [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/x11/xinitrc.$like" ]; then
        . "${XDG_CONFIG_HOME:-$HOME/.config}/x11/xinitrc.$like"
        break
      fi
    done
  fi
fi

# ==============================================================================
# 5. CẤU HÌNH HIỂN THỊ & HÌNH NỀN CHUNG
# ==============================================================================
# Dò tìm màn hình chính kết nối qua DRM sysfs (0 subshell, 0 fork)
monitor=""
for card in /sys/class/drm/card*-*; do
  if [ -f "$card/status" ] && grep -q "^connected" "$card/status" 2>/dev/null; then
    monitor=$(basename "$card" | sed 's/^card[0-9]*-//')
    break
  fi
done

if [ -n "$monitor" ] && command -v xrandr >/dev/null 2>&1; then
  xrandr --output "$monitor" --auto
elif command -v xrandr >/dev/null 2>&1; then
  xrandr --auto
fi

command -v setbg >/dev/null 2>&1 && setbg "$HOME/Pictures/Wallpapers/" &

# ==============================================================================
# 6. KHỞI CHẠY CÁC ỨNG DỤNG NỀN & TRAYER CHUNG
# ==============================================================================
autostart="dunst udiskie xfce4-power-manager fcitx5 mpd picom unclutter remapd"
for program in $autostart; do
  if command -v "$program" >/dev/null 2>&1; then
    pgrep -u "$USER" -x "$program" >/dev/null || "$program" &
  fi
done

# Khởi động Daemon nền (Ưu tiên Native C, triệt tiêu 60MB RAM Python daemon)
if command -v ka-clipd >/dev/null 2>&1; then
  # Daemon Clipboard C Native siêu nhẹ (< 1.2MB RAM, 0% CPU idle qua XFixes)
  ka-clipd &
elif command -v ka-pop >/dev/null 2>&1; then
  # Popovers chạy Native C On-Demand (0MB idle RAM, <15ms launch), không cần ka-daemon
  command -v ka-clip >/dev/null 2>&1 && ka-clip daemon &
elif command -v ka-daemon >/dev/null 2>&1; then
  ka-daemon &
else
  # Fallback cho các bản cài đặt cũ
  command -v dwm-dropdown >/dev/null 2>&1 && dwm-dropdown --daemon &
  command -v ka-clip >/dev/null 2>&1 && ka-clip daemon &
fi



# ==============================================================================
# 7. KHỞI ĐỘNG THANH TRẠNG THÁI (DWMBLOCKS)
# ==============================================================================
command -v start-dwmblocks >/dev/null 2>&1 && start-dwmblocks &
(sleep 3 && pkill -RTMIN+11 dwmblocks) &

# ==============================================================================
# 8. KHỞI ĐỘNG WINDOW MANAGER
# ==============================================================================
# Tối ưu hóa Process Scheduling: Nâng độ ưu tiên cho Xorg/DWM (nice -5)
# Đảm bảo độ trễ chuột/phím và phản hồi UI luôn đạt chuẩn Real-Time ngay cả khi CPU 100%
renice -n -5 -p $$ 2>/dev/null || true

exec ssh-agent dwm

