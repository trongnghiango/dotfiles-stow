!! ==============================================================================
!! Xresources — Cấu hình tĩnh (Font, Alpha, ST-specific)
!! Màu sắc được quản lý riêng bởi theme-set:
!!   ~/.config/x11/xresources.d/colors  ← Auto-generated, KHÔNG sửa tay
!! ==============================================================================

!! Transparency (0.0 - 1.0)
*.alpha: 0.9

!! Font chính — JetBrains Mono SemiBold
*.font:    JetBrains Mono:pixelsize=14:style=SemiBold:antialias=true:autohint=true
st.font:   JetBrains Mono:pixelsize=14:style=SemiBold:antialias=true:autohint=true

!! Font fallback — Symbols Nerd Font (icon glyphs cho dwmblocks/lf)
st.fontalt0: Symbols Nerd Font Mono:pixelsize=14:style=Regular:antialias=true

