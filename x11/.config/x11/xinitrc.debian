#!/usr/bin/env sh
# ==============================================================================
# xinitrc.debian — Engine Adapter cho Debian Linux (Bookworm/Trixie/Sid)
# ==============================================================================

# 1. Khởi chạy âm thanh PipeWire (Debian 12+) qua Systemd user session (chạy nền, non-blocking)
if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
  systemctl --user start pipewire wireplumber pipewire-pulse 2>/dev/null &
else
  # Fallback nếu Debian chạy SysVinit / OpenRC
  if command -v pipewire >/dev/null 2>&1 && ! pgrep -x pipewire >/dev/null; then
    (
      pipewire >/dev/null 2>&1 &
      pw_sock="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/pipewire-0"
      for _ in 1 2 3 4 5 6; do
        [ -S "$pw_sock" ] && break
        sleep 0.025
      done
      command -v wireplumber >/dev/null 2>&1 && wireplumber >/dev/null 2>&1 &
      command -v pipewire-pulse >/dev/null 2>&1 && pipewire-pulse >/dev/null 2>&1 &
    ) &
  fi
fi

# 2. Ngăn chặn Debian tự động thay đổi layout bàn phím ngoài ý muốn
export DEBIAN_PREVENT_KEYBOARD_CHANGES=1
