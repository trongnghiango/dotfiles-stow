#!/usr/bin/env sh
# ==============================================================================
# xinitrc.debian — Hook khởi động môi trường X11 cho Debian Linux
# ==============================================================================

# 1. Khởi chạy âm thanh PipeWire qua Systemd user session (Debian 12+)
if command -v systemctl >/dev/null 2>&1 && systemctl --user is-system-running >/dev/null 2>&1; then
  systemctl --user start pipewire wireplumber pipewire-pulse 2>/dev/null
else
  if ! pgrep -x pipewire >/dev/null; then
    pipewire >/dev/null 2>&1 &
    sleep 0.1
    wireplumber >/dev/null 2>&1 &
    sleep 0.1
    pipewire-pulse >/dev/null 2>&1 &
  fi
fi

# 2. Khởi chạy Polkit Authentication Agent cho Debian
for polkit_agent in \
  "/usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1" \
  "/usr/libexec/polkit-gnome-authentication-agent-1" \
  "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"; do
  if [ -x "$polkit_agent" ]; then
    pgrep -f "$(basename "$polkit_agent")" >/dev/null || "$polkit_agent" &
    break
  fi
done

# 3. Đảm bảo symlink Debian CLI (batcat -> bat, fdfind -> fd) tồn tại trong ~/.local/bin
mkdir -p "$HOME/.local/bin"
[ -x /usr/bin/batcat ] && [ ! -e "$HOME/.local/bin/bat" ] && ln -sf /usr/bin/batcat "$HOME/.local/bin/bat"
[ -x /usr/bin/fdfind ] && [ ! -e "$HOME/.local/bin/fd" ] && ln -sf /usr/bin/fdfind "$HOME/.local/bin/fd"
