# ==============================================================================
# install_debian.sh — file cấu hình (KEY=VALUE)
#
# Dùng:
#   cp install.conf.example install.conf
#   vi install.conf
#   sudo ./install_debian.sh --config install.conf --yes
#   # hoặc đặt install.conf cạnh script: sudo ./install_debian.sh --yes
#
# Kiểm tra trước khi ghi đĩa (không cần root):
#   ./install_debian.sh --print-config
#
# Tham số dòng lệnh LUÔN thắng file này.
# ==============================================================================

# --- Ổ đĩa đích (BẮT BUỘC) ---
DISK=/dev/sda

# --- Swap ---
#   0        : KHÔNG tạo phân vùng swap (layout chỉ còn ESP + root ext4)
#   4G/2048M : tạo phân vùng swap tương ứng
# Mặc định của script là 4G.
SWAP_SIZE=0

# --- Tài khoản / máy ---
USER_NAME=ka
USER_PASS=1
HOSTNAME=debian
TIMEZONE=Asia/Ho_Chi_Minh

# --- Debian ---
SUITE=trixie
MIRROR=http://deb.debian.org/debian

# --- Dotfiles ---
DOTFILES_REPO=https://github.com/trongnghiango/dotfiles-stow.git
DOTFILES_BRANCH=main

# --- Truy cập sau reboot (tuỳ chọn, bỏ dấu # để dùng) ---
# WIFI_SSID=Akapro-5G
# WIFI_PSK_FILE=/run/wifi.psk
# SSH_KEY_FILE=/home/ka/.ssh/id_ed25519.pub
SSH_PASSWORD_AUTH=true

# --- An toàn ---
# ALLOW_OFFLINE=false
# Tự đặt lại giờ hệ thống khi lệch > 5 phút so với Internet (APT cần giờ đúng
# để verify chữ ký; pin CMOS yếu thường làm RTC chậm nhiều giờ).
FIX_CLOCK=true
AUTO_CONFIRM=true
