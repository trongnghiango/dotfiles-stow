[Default Applications]
# Text & Code
text/plain=nvim.desktop;text.desktop;
text/x-shellscript=nvim.desktop;text.desktop;
text/markdown=nvim.desktop;text.desktop;
application/json=nvim.desktop;text.desktop;
application/xml=nvim.desktop;text.desktop;

# Images — imv
image/png=imv.desktop;img.desktop;
image/jpeg=imv.desktop;img.desktop;
image/gif=imv.desktop;img.desktop;
image/webp=imv.desktop;img.desktop;
image/svg+xml=imv.desktop;img.desktop;

# Video & Audio — mpv
video/x-matroska=mpv.desktop;video.desktop;
video/mp4=mpv.desktop;video.desktop;
video/webm=mpv.desktop;video.desktop;
video/quicktime=mpv.desktop;video.desktop;
audio/mpeg=mpv.desktop;audio.desktop;
audio/flac=mpv.desktop;audio.desktop;
audio/ogg=mpv.desktop;audio.desktop;

# Documents
application/pdf=org.pwmt.zathura.desktop;pdf.desktop;
application/postscript=org.pwmt.zathura.desktop;pdf.desktop;

# Web browsers — Brave as default
x-scheme-handler/http=brave-browser.desktop;
x-scheme-handler/https=brave-browser.desktop;
text/html=brave-browser.desktop;
application/x-extension-htm=brave-browser.desktop;
application/x-extension-html=brave-browser.desktop;
application/x-extension-shtml=brave-browser.desktop;
application/xhtml+xml=brave-browser.desktop;

# Handlers & Tools
x-scheme-handler/magnet=torrent.desktop;
application/x-bittorrent=torrent.desktop;
x-scheme-handler/mailto=mail.desktop;
x-scheme-handler/claude-cli=claude-code-url-handler.desktop;
x-scheme-handler/obsidian=obsidian.desktop;
x-scheme-handler/antigravity=antigravity.desktop;
inode/directory=file.desktop;
