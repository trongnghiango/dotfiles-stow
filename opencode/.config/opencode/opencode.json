{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "9Router Gateway",
      "options": {
        "baseURL": "http://localhost:20128/v1",
        "apiKey": "{env:ROUTER9_API_KEY}"
      },
      "models": {
        "ka.base": {
          "name": "Base (Main Combo)",
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "ka.simple": {
          "name": "Simple (Simple Combo)",
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "ka.reason": {
          "name": "Thinking (Thinking Combo)",
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        }
      }
    }
  }
}
