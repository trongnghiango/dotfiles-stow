#!/bin/sh
# shellcheck disable=SC2155
# ==============================================================================
# PROFILE — Server-minimal (login shell environment)
# Chỉ giữ biến môi trường thiết yếu, không phụ thuộc X11/desktop.
# ==============================================================================

# PATH: user binaries trước
if [ -d "$HOME/.local/bin" ]; then
  export PATH="$HOME/.local/bin:$PATH"
fi

# Mise shims (nếu có)
if [ -d "$HOME/.local/share/mise/shims" ]; then
  export PATH="$HOME/.local/share/mise/shims:$PATH"
fi

# Editor mặc định
export EDITOR="nvim"
export VISUAL="nvim"
export NVIM_NOTTYFAST=1

# XDG base directories
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"
export ZDOTDIR="$XDG_CONFIG_HOME/zsh"
export INPUTRC="$XDG_CONFIG_HOME/shell/inputrc"
export TMUX_TMPDIR="$XDG_RUNTIME_DIR"

# Pager / less
export LESS="R"
export LESS_TERMCAP_mb="$(printf '%b' '\033[1;31m')"
export LESS_TERMCAP_md="$(printf '%b' '\033[1;36m')"
export LESS_TERMCAP_me="$(printf '%b' '\033[0m')"
export LESS_TERMCAP_so="$(printf '%b' '\033[01;44;33m')"
export LESS_TERMCAP_se="$(printf '%b' '\033[0m')"
export LESS_TERMCAP_us="$(printf '%b' '\033[1;32m')"
export LESS_TERMCAP_ue="$(printf '%b' '\033[0m')"
export LESSOPEN="| bat --style=plain --color=always %s 2>/dev/null"

# Secrets local (không commit)
[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/shell/profile.local" ] && . "${XDG_CONFIG_HOME:-$HOME/.config}/shell/profile.local"
