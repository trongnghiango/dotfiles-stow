#!/bin/sh
# ==============================================================================
# ALIASRC — Server-minimal
# ==============================================================================

# Neovim cho vim
[ -x "$(command -v nvim)" ] && alias vim="nvim" vimdiff="nvim -d"

# sudo cho lệnh hệ thống
for command in mount umount updatedb su shutdown poweroff reboot; do
  alias "$command"="sudo $command"
done
unset command

# Mở script trong ~/.local/bin bằng editor + fzf
se() {
  choice="$(find "$HOME/.local/bin" -mindepth 1 -printf '%P\n' | fzf)"
  [ -f "$HOME/.local/bin/$choice" ] && "$EDITOR" "$HOME/.local/bin/$choice"
}

# An toàn khi thao tác file
alias \
  cp="cp -iv" \
  mv="mv -iv" \
  rm="rm -vI" \
  bc="bc -ql" \
  rsync="rsync -vrPlu" \
  mkd="mkdir -pv"

# Màu
if command -v eza >/dev/null; then
  alias ls="eza --icons --group-directories-first"
  alias ll="eza -al --icons --group-directories-first"
  alias la="eza -a --icons --group-directories-first"
  alias lt="eza -aT --icons --group-directories-first"
else
  alias ls="ls -hN --color=auto --group-directories-first"
fi

alias \
  grep="grep --color=auto" \
  diff="diff --color=auto" \
  ccat="bat --style=plain --color=always" \
  ip="ip -color=auto"

# Viết tắt
alias \
  g="git" \
  sdn="shutdown -h now" \
  e='$EDITOR' \
  v='$EDITOR'
