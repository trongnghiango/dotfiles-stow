#!/bin/sh
# ==============================================================================
# ALIASRC - Clean Shell Aliases for Arch Linux & Omarchy
# ==============================================================================

# Editor aliases
[ -x "$(command -v nvim)" ] && alias vim="nvim" vimdiff="nvim -d"
alias e='$EDITOR'
alias v='$EDITOR'

# Package manager (Arch Linux & Omarchy)
alias p="pacman"
alias pacman="sudo pacman"
alias y="yay"
alias update="yay -Syu"

# Sudo shortcuts for common system tasks
for command in mount umount updatedb su shutdown poweroff reboot; do
  alias $command="sudo $command"
done
unset command

# Quick edit local scripts with fzf
se() {
  choice="$(find "$HOME/.local/bin" -mindepth 1 -printf '%P\n' 2>/dev/null | fzf)"
  [ -n "$choice" ] && [ -f "$HOME/.local/bin/$choice" ] && $EDITOR "$HOME/.local/bin/$choice"
}

# Safer & Verbose File Operations
alias \
  cp="cp -iv" \
  mv="mv -iv" \
  rm="rm -vI" \
  bc="bc -ql" \
  rsync="rsync -vrPlu" \
  mkd="mkdir -pv"

# Modern CLI tools
if command -v eza >/dev/null 2>&1; then
  alias ls="eza --icons --group-directories-first"
  alias ll="eza -al --icons --group-directories-first"
  alias la="eza -a --icons --group-directories-first"
  alias lt="eza -aT --icons --group-directories-first"
else
  alias ls="ls -hN --color=auto --group-directories-first"
  alias ll="ls -halN --color=auto --group-directories-first"
fi

alias \
  grep="grep --color=auto" \
  diff="diff --color=auto" \
  ccat="bat --style=plain --color=always" \
  ip="ip -color=auto"

# Media & Download
alias \
  yt="yt-dlp --embed-metadata -i" \
  yta="yt -x -f bestaudio/best" \
  ytt="yt --skip-download --write-thumbnail" \
  ffmpeg="ffmpeg -hide_banner"

# Common Abbreviations
alias \
  g="git" \
  ka="killall" \
  sdn="shutdown -h now" \
  z="zathura" \
  lf="lfub"

# Refresh shell bookmarks & shortcuts
alias ref='shortcuts >/dev/null 2>&1; [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/shell/shortcutrc" ] && . "${XDG_CONFIG_HOME:-$HOME/.config}/shell/shortcutrc"; [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/shell/shortcutenvrc" ] && . "${XDG_CONFIG_HOME:-$HOME/.config}/shell/shortcutenvrc"'
