# =========================================================
# LF CONFIG — Server-minimal (no GUI viewers)
# =========================================================
set ifs "\n"
set scrolloff 10
set icons
set period 1
set hiddenfiles ".*:*.aux:*.log:*.tmp"
set autoquit true
set info size:time

# =========================================================
# PREVIEW
# =========================================================
set previewer ~/.config/lf/scope
set cleaner ~/.config/lf/cleaner
set preview true

# =========================================================
# COMMANDS
# =========================================================

# ---------- OPEN ----------
cmd open ${{
    case "$(file --mime-type -b "$1")" in
        text/*|application/json|inode/x-empty|application/x-subrip)
            "$EDITOR" "$1" ;;
        application/x-7z-compressed|application/zip|application/x-tar|application/gzip|application/x-xz|application/x-rar)
            printf "Archive: press zx to extract\n"; read _ ;;
        *)
            printf "Cannot open: %s\n" "$(file --mime-type -b "$1")"; read _ ;;
    esac
}}

# ---------- MKDIR ----------
cmd mkdir $mkdir -p "$@"

# ---------- DELETE ----------
cmd delete ${{
    clear
    printf "Delete:\n%s\n\nConfirm? [y/N]: " "$fx"
    read ans
    [ "$ans" = "y" ] && rm -rf -- $fx
}}

# ---------- BULK RENAME ----------
cmd bulkrename ${{
    tmp_old=$(mktemp)
    tmp_new=$(mktemp)
    printf "%s\n" $fx > "$tmp_old"
    cp "$tmp_old" "$tmp_new"
    "$EDITOR" "$tmp_new"
    paste "$tmp_old" "$tmp_new" | while IFS=$'\t' read -r a b; do
        [ "$a" != "$b" ] && [ ! -e "$b" ] && mv -- "$a" "$b"
    done
    rm -f "$tmp_old" "$tmp_new"
}}

# ---------- EXTRACT ----------
cmd extract ${{
    clear
    [ -z "$fx" ] && echo "No selection" && read && exit 1
    printf "Extract:\n%s\n\nConfirm? [y/N]: " "$fx"
    read ans
    [ "$ans" != "y" ] && exit 0

    for f in $fx; do
        target="$f"
        if echo "$f" | grep -qE "\.[0-9]{3}$"; then
            base="${f%.*}"
            [ -f "${base}.001" ] && target="${base}.001"
        fi
        out="${f%.7z*}"
        out="${out%.*}"
        case "$target" in
            *.7z|*.7z.001) 7z x "$target" -o"$out" ;;
            *.zip) unzip "$target" -d "$out" ;;
            *.tar) tar xf "$target" ;;
            *.tar.gz|*.tgz) tar xzf "$target" ;;
            *.tar.xz) tar xJf "$target" ;;
            *.rar)
                if command -v unrar >/dev/null 2>&1; then
                    unrar x "$target" "$out/"
                elif command -v unrar-free >/dev/null 2>&1; then
                    abs="$(readlink -f "$target")"
                    mkdir -p "$out" && (cd "$out" && unrar-free -x "$abs")
                else
                    echo "No RAR extractor (install unrar or unrar-free)"
                fi
                ;;
            *) echo "Unsupported: $target" ;;
        esac
    done
    read
}}

# ---------- FZF SEARCH (RIPGREP) ----------
cmd fzf_search ${{
    if ! command -v rg >/dev/null 2>&1 || ! command -v fzf >/dev/null 2>&1; then
        lf -remote "send $id echo 'rg or fzf not installed!'"
        exit 1
    fi
    res=$(rg --column --line-number --no-heading --color=always --smart-case "" 2>/dev/null | \
          fzf --ansi --delimiter=: --nth=4.. --prompt="Search content > " --height=50% --reverse | \
          cut -d: -f1)
    [ -n "$res" ] && lf -remote "send $id select \"$res\""
}}

cmd fzf_jump ${{
    res=$(find . -maxdepth 3 -not -path '*/.*' | fzf --prompt="Jump to > ")
    if [ -n "$res" ]; then
        if [ -d "$res" ]; then
            lf -remote "send $id cd \"$res\""
        else
            lf -remote "send $id select \"$res\""
        fi
    fi
}}
map f fzf_jump
map / fzf_search

# ---------- TRASH ----------
cmd trash ${{
    trash-put -- $fx
    lf -remote "send $id echo 'Moved to system trash'"
}}
map D trash

# =========================================================
# KEYMAPS
# =========================================================
map <enter> shell
map zx extract
map rr :rename
map rb bulkrename
map g top
map H cd ~
map <c-e> down
map <c-y> up
map <c-r> reload
map . :set hidden!

# =========================================================
# SORTING
# =========================================================
map on :set sortby natural; set reverse false
map os :set sortby size; set reverse true
map ot :set sortby time; set reverse true
map oe :set sortby ext
map r :set reverse!

# =========================================================
# SHORTCUTS
# =========================================================
source ~/.config/lf/shortcutrc
