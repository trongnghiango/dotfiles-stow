# ==============================================================================
# LF CONFIGURATION — Omarchy Wayland Optimized
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE & DISPLAY OPTIONS
# ------------------------------------------------------------------------------
set shell /bin/sh
set shellopts '-eu'
set ifs "\n"
set scrolloff 8
set ratios 1:2:3
set tabstop 4
set cursorpreviewfmt "\033[7m"
set period 1
set icons true
set info size:time
set dircounts true
set timefmt "2006-01-02 15:04"
set autoquit true
set drawbox false
set hidden true
set hiddenfiles ".*:*.aux:*.log:*.bbl:*.bcf:*.blg:*.run.xml"
set preview true
set previewer ~/.config/lf/scope
set cleaner ~/.config/lf/cleaner
set mouse true

# ------------------------------------------------------------------------------
# 2. CUSTOM COMMANDS
# ------------------------------------------------------------------------------

# Open file with default Omarchy handler
cmd open ${{
    test -L "$f" && f=$(readlink -f "$f")
    mime=$(file --mime-type -Lb "$f")
    case "$mime" in
        text/*|application/json|inode/x-empty|application/x-subrip|application/xml|application/javascript)
            $EDITOR "$f" ;;
        image/*)
            setsid -f imv "$f" >/dev/null 2>&1 ;;
        video/*|audio/*)
            setsid -f mpv "$f" >/dev/null 2>&1 ;;
        application/pdf|application/epub+zip|application/postscript)
            if command -v zathura >/dev/null 2>&1; then
                setsid -f zathura "$f" >/dev/null 2>&1
            else
                setsid -f xdg-open "$f" >/dev/null 2>&1
            fi ;;
        *)
            setsid -f xdg-open "$f" >/dev/null 2>&1 ;;
    esac
}}

# Directory & File creation
cmd mkdir $mkdir -p "$@"
cmd touch $touch "$@"

# Bulk rename with Neovim
cmd bulkrename ${{
    tmp_old=$(mktemp)
    tmp_new=$(mktemp)
    trap 'rm -f "$tmp_old" "$tmp_new"' EXIT

    [ -n "$fx" ] && printf "%s\n" $fx > "$tmp_old" || printf "%s\n" $f > "$tmp_old"
    cp "$tmp_old" "$tmp_new"

    $EDITOR "$tmp_new"

    paste "$tmp_old" "$tmp_new" | while IFS=$'\t' read -r a b; do
        [ "$a" != "$b" ] && [ -e "$a" ] && [ ! -e "$b" ] && mv -n -- "$a" "$b"
    done
    lf -remote "send $id load"
}}

# Safe trash using trash-cli with fallback
cmd trash ${{
    if command -v trash-put >/dev/null 2>&1; then
        trash-put -- $fx
        lf -remote "send $id echo 'Moved to trash: $fx'"
    else
        clear
        printf "trash-cli not found! Permanently delete? [y/N]: "
        read ans
        [ "$ans" = "y" ] && rm -rf -- $fx
    fi
}}

# Permanent delete with confirmation
cmd delete ${{
    clear
    printf "\033[1;31mPERMANENT DELETE:\033[0m\n%s\n\nAre you sure? [y/N]: " "$fx"
    read ans
    [ "$ans" = "y" ] && rm -rf -- $fx
}}

# Fuzzy jump into directory / file
cmd fzf_jump ${{
    res=$(find . -maxdepth 3 -not -path '*/.*' 2>/dev/null | fzf --prompt="Jump > " --height=40% --reverse)
    if [ -n "$res" ]; then
        if [ -d "$res" ]; then
            lf -remote "send $id cd \"$res\""
        else
            lf -remote "send $id select \"$res\""
        fi
    fi
}}

# Fuzzy full-text search with ripgrep
cmd fzf_search ${{
    if ! command -v rg >/dev/null 2>&1 || ! command -v fzf >/dev/null 2>&1; then
        lf -remote "send $id echo 'rg or fzf not installed!'"
        exit 1
    fi
    res=$(rg --column --line-number --no-heading --color=always --smart-case "" 2>/dev/null | \
          fzf --ansi --delimiter=: --nth=4.. --prompt="Search content > " --height=50% --reverse | \
          cut -d: -f1)
    [ -n "$res" ] && lf -remote "send $id select \"$res\""
}}

# Wayland Clipboard helpers
cmd copy_path ${{
    printf "%s" "$fx" | wl-copy
    lf -remote "send $id echo 'Copied full path to clipboard'"
}}

cmd copy_name ${{
    printf "%s" "$fx" | sed 's!.*/!!' | wl-copy
    lf -remote "send $id echo 'Copied file name to clipboard'"
}}

cmd copy_dir ${{
    dirname "$f" | wl-copy
    lf -remote "send $id echo 'Copied directory path to clipboard'"
}}

cmd copy_content ${{
    if [ -f "$f" ]; then
        wl-copy < "$f"
        lf -remote "send $id echo 'Copied file contents to clipboard'"
    fi
}}

# Multi-threaded compression
cmd compress ${{
    clear
    [ -z "$fx" ] && echo "No files selected!" && read && exit 1

    current_dir=$(basename "$PWD")
    date_str=$(date +%Y-%m-%d)
    default_name="${current_dir}_${date_str}.7z"

    printf "\033[1;34m=== ARCHIVE & COMPRESSION ===\033[0m\n"
    printf "Files: \033[1;33m%s\033[0m\n" "$fx"
    printf "Archive name [Default: %s]: " "$default_name"
    read name
    [ -z "$name" ] && name="$default_name"

    case "$name" in
        *.7z|*.tar.gz|*.tar.xz|*.zip) ;;
        *) name="$name.7z" ;;
    esac

    printf "Password (Enter for None): "
    read -s pass
    echo ""

    printf "Compression Level (1=Fast, 5=Normal, 9=Ultra) [Default: 5]: "
    read level
    [ -z "$level" ] && level="5"

    printf "\033[1;33m⏳ Compressing data (multi-threading)...\033[0m\n"

    args="a \"$name\" $fx -mx$level -mmt=on -ms=on"
    if [ -n "$pass" ]; then
        args="$args -p\"$pass\" -mhe=on"
    fi

    if eval "7z $args" >/dev/null; then
        printf "\033[1;32m✔ Archive created: %s\033[0m\n" "$name"
        lf -remote "send $id select \"$name\""
    else
        printf "\033[1;31m❌ Compression failed!\033[0m\n"
        read
    fi
}}

# Smart archive extraction
cmd extract ${{
    clear
    [ -z "$fx" ] && echo "No selection!" && read && exit 1

    for f in $fx; do
        target="$f"
        if echo "$f" | grep -qE "\.[0-9]{3}$"; then
            base="${f%.*}"
            [ -f "${base}.001" ] && target="${base}.001"
        fi

        out="${f%.7z*}"
        out="${out%.tar*}"
        out="${out%.zip*}"
        out="${out%.rar*}"

        case "$target" in
            *.7z|*.7z.001) 7z x "$target" -o"$out" -y ;;
            *.zip) unzip -q "$target" -d "$out" ;;
            *.tar) tar -xf "$target" ;;
            *.tar.gz|*.tgz) tar -xzf "$target" ;;
            *.tar.xz|*.txz) tar -xJf "$target" ;;
            *.tar.zst) tar --zstd -xf "$target" ;;
            *.rar) unrar x -y "$target" "$out/" ;;
            *) echo "Unsupported archive: $target" ;;
        esac
    done
    lf -remote "send $id load"
}}

# Interactive FZF Archive extraction
cmd extract_fzf ${{
    clear
    [ -z "$f" ] && exit 1

    target="$f"
    case "$f" in
        *.0[0-9][0-9])
            base="${f%.*}"
            [ -f "${base}.001" ] && target="${base}.001"
            ;;
    esac

    tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/lf_ext.XXXXXX")
    trap 'rm -rf "$tmp_dir"' EXIT

    if ! 7z l -slt "$target" > "$tmp_dir/raw_slt" 2>/dev/null; then
        printf "\033[1;31m❌ Cannot read archive format.\033[0m\n"
        read temp
        exit 1
    fi

    awk '
    BEGIN { RS=""; FS="\n" }
    {
        path=""; attr="";
        for(i=1; i<=NF; i++) {
            if ($i ~ /^Path = /)       path = substr($i, 8)
            if ($i ~ /^Attributes = /) attr = substr($i, 14)
        }
        if (path == "" || attr == "") next
        if (attr ~ /D/) type="DIR"
        else            type="FILE"
        print type "\t" path
    }' "$tmp_dir/raw_slt" > "$tmp_dir/parsed_list"

    sort "$tmp_dir/parsed_list" | awk -F'\t' '
    {
        if ($1 == "DIR") printf "\033[1;34m📁 %s\033[0m\t%s/\n", $2, $2
        else             printf "📄 %s\t%s\n", $2, $2
    }' > "$tmp_dir/view_list"

    sel=$(cat "$tmp_dir/view_list" | fzf \
        --ansi \
        --delimiter="\t" --with-nth=1 \
        --prompt="Extract items > " \
        --preview "echo {2}" \
        --preview-window=up:1 \
        --height=80% --reverse -m)

    [ -z "$sel" ] && exit 0

    mkdir -p extract
    echo "$sel" | awk -F'\t' '{print $2}' | while IFS= read -r p; do
        case "$p" in
            */) 7z x "$target" "${p}*" -oextract -y >/dev/null 2>&1 ;;
            *)  7z x "$target" "$p" -oextract -y >/dev/null 2>&1 ;;
        esac
    done

    printf "\033[1;32m✔ Extraction complete into ./extract/\033[0m\n"
    lf -remote "send $id select extract"
}}

# ------------------------------------------------------------------------------
# 3. KEYBINDINGS
# ------------------------------------------------------------------------------

# Opening
map <enter> open
map e open

# Navigation
map g top
map G bottom
map H cd ~
map <c-e> down
map <c-y> up
map <c-r> reload

# File Operations
map a push :touch<space>
map A push :mkdir<space>
map r :rename
map rb bulkrename
map x cut
map y copy
map p paste
map d trash
map D delete

# Search & Jump
map f fzf_jump
map / fzf_search

# Wayland Clipboard
map yp copy_path
map yn copy_name
map yd copy_dir
map yc copy_content

# Archive Operations
map zz compress
map zx extract
map zf extract_fzf

# Sorting
map sn :set sortby natural; set reverse false
map ss :set sortby size; set reverse true
map st :set sortby time; set reverse true
map se :set sortby ext; set reverse false
map sr :set reverse!

# Display toggles
map . :set hidden!

# Bookmarks (Standard XDG)
map gh cd ~
map gc cd ~/.config
map gd cd ~/Documents
map gD cd ~/Downloads
map gm cd ~/Music
map gp cd ~/Pictures
map gv cd ~/Videos
map gr cd ~/Repos
map gt cd /tmp
