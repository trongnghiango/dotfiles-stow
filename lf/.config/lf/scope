#!/bin/sh
# LF preview — Server-minimal: directory tree + text only
set -C -f
IFS="$(printf '%b_' '\n')"
IFS="${IFS%_}"

if [ -d "$1" ]; then
    if command -v eza >/dev/null 2>&1; then
        eza --tree --level=2 --icons --color=always --group-directories-first "$1" | head -n "$(($4 - 1))"
    else
        ls -la --color=always "$1" | head -n "$(($4 - 1))"
    fi
    exit 0
fi

case "$(file --dereference --brief --mime-type -- "$1")" in
    text/* | */xml | application/json)
        bat -p --theme ansi --terminal-width "$(($4 - 2))" -f "$1" ;;
    *)
        echo "No preview" ;;
esac
exit 1
