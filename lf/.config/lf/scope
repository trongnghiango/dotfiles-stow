#!/bin/sh
# ==============================================================================
# LF SCOPE PREVIEWER — High Performance Wayland (Omarchy)
# ==============================================================================

set -C -f

file="$1"
width="${2:-80}"
height="${3:-25}"
x="${4:-0}"
y="${5:-0}"

# Calculate safe preview dimensions to prevent line-wrapping artifacts
[ "$width" -le 0 ] 2>/dev/null && width=80
[ "$height" -le 0 ] 2>/dev/null && height=25
calc_width=$((width > 2 ? width - 1 : width))
calc_height=$((height > 1 ? height - 1 : height))

[ ! -f "$file" ] && [ ! -d "$file" ] && exit 1

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/lf/thumbnails"
[ ! -d "$CACHE_DIR" ] && mkdir -p "$CACHE_DIR"

# ------------------------------------------------------------------------------
# 1. DIRECTORIES
# ------------------------------------------------------------------------------
if [ -d "$file" ]; then
    if command -v eza >/dev/null 2>&1; then
        eza --tree --level=2 --icons --color=always --group-directories-first "$file" | head -n "$calc_height"
    elif command -v tree >/dev/null 2>&1; then
        tree -C -L 2 --noreport "$file" | head -n "$calc_height"
    else
        ls -la --color=always "$file" | head -n "$calc_height"
    fi
    exit 0
fi

# ------------------------------------------------------------------------------
# 2. MIME-TYPE DISPATCH
# ------------------------------------------------------------------------------
mimetype=$(file --dereference --brief --mime-type -- "$file" 2>/dev/null)

case "$mimetype" in
    # --------------------------------------------------------------------------
    # Images (Kitty / Sixel True Pixel Graphics or High-Res Unicode Symbols)
    # --------------------------------------------------------------------------
    image/*)
        if [ "$TERM" = "xterm-kitty" ] || [ -n "${KITTY_WINDOW_ID:-}" ] || [ "${TERM_PROGRAM:-}" = "ghostty" ] || [ -n "${GHOSTTY_RESOURCES_DIR:-}" ]; then
            chafa --format kitty -s "${calc_width}x${calc_height}" --animate false "$file"
            exit 0
        elif [ "$TERM" = "foot" ] || [ "$TERM" = "foot-extra" ]; then
            chafa --format sixels -s "${calc_width}x${calc_height}" --animate false "$file"
            exit 0
        elif command -v chafa >/dev/null 2>&1; then
            chafa --format symbols --symbols sextant+quad+half+block --color-space din99d -s "${calc_width}x${calc_height}" --animate false "$file"
            exit 0
        elif command -v mediainfo >/dev/null 2>&1; then
            mediainfo "$file"
            exit 0
        else
            file -b "$file"
            exit 0
        fi
        ;;

    # --------------------------------------------------------------------------
    # Video
    # --------------------------------------------------------------------------
    video/*)
        hash=$(stat --printf '%n\0%i\0%s\0%Y' -- "$(readlink -f "$file")" 2>/dev/null | sha256sum | cut -d' ' -f1)
        thumb="$CACHE_DIR/${hash}.jpg"
        if [ ! -f "$thumb" ] && command -v ffmpegthumbnailer >/dev/null 2>&1; then
            ffmpegthumbnailer -i "$file" -o "$thumb" -s 0 -q 5 >/dev/null 2>&1
        fi

        if [ -f "$thumb" ]; then
            if [ "$TERM" = "xterm-kitty" ] || [ -n "${KITTY_WINDOW_ID:-}" ] || [ "${TERM_PROGRAM:-}" = "ghostty" ] || [ -n "${GHOSTTY_RESOURCES_DIR:-}" ]; then
                chafa --format kitty -s "${calc_width}x${calc_height}" --animate false "$thumb"
                exit 0
            elif [ "$TERM" = "foot" ] || [ "$TERM" = "foot-extra" ]; then
                chafa --format sixels -s "${calc_width}x${calc_height}" --animate false "$thumb"
                exit 0
            elif command -v chafa >/dev/null 2>&1; then
                chafa --format symbols --symbols sextant+quad+half+block --color-space din99d -s "${calc_width}x${calc_height}" --animate false "$thumb"
                exit 0
            fi
        elif command -v mediainfo >/dev/null 2>&1; then
            mediainfo "$file"
            exit 0
        fi
        ;;

    # --------------------------------------------------------------------------
    # PDF Documents & Books
    # --------------------------------------------------------------------------
    application/pdf|*/pdf)
        hash=$(stat --printf '%n\0%i\0%s\0%Y' -- "$(readlink -f "$file")" 2>/dev/null | sha256sum | cut -d' ' -f1)
        thumb="$CACHE_DIR/${hash}.jpg"
        if [ ! -f "$thumb" ] && command -v pdftoppm >/dev/null 2>&1; then
            pdftoppm -jpeg -f 1 -singlefile "$file" "$CACHE_DIR/$hash" >/dev/null 2>&1
        fi

        if [ -f "$thumb" ] && [ -s "$thumb" ]; then
            if [ "$TERM" = "xterm-kitty" ] || [ -n "${KITTY_WINDOW_ID:-}" ] || [ "${TERM_PROGRAM:-}" = "ghostty" ] || [ -n "${GHOSTTY_RESOURCES_DIR:-}" ]; then
                chafa --format kitty -s "${calc_width}x${calc_height}" --animate false "$thumb"
                exit 0
            elif [ "$TERM" = "foot" ] || [ "$TERM" = "foot-extra" ]; then
                chafa --format sixels -s "${calc_width}x${calc_height}" --animate false "$thumb"
                exit 0
            elif command -v chafa >/dev/null 2>&1; then
                chafa --format symbols --symbols sextant+quad+half+block --color-space din99d -s "${calc_width}x${calc_height}" --animate false "$thumb"
                exit 0
            fi
        elif command -v pdftotext >/dev/null 2>&1; then
            pdftotext "$file" - 2>/dev/null | head -n "$calc_height"
            exit 0
        fi
        ;;

    # --------------------------------------------------------------------------
    # EPUB & E-Books (Cover extraction)
    # --------------------------------------------------------------------------
    application/epub+zip|*/epub|application/x-mobipocket-ebook)
        hash=$(stat --printf '%n\0%i\0%s\0%Y' -- "$(readlink -f "$file")" 2>/dev/null | sha256sum | cut -d' ' -f1)
        thumb="$CACHE_DIR/${hash}.jpg"
        if [ ! -f "$thumb" ] && command -v unzip >/dev/null 2>&1; then
            # Extract cover image from EPUB
            cover_file=$(unzip -l "$file" 2>/dev/null | grep -iE '(cover.*\.(jpe?g|png|webp))|((image|img).*\.(jpe?g|png|webp))' | head -n 1 | awk '{print $NF}')
            if [ -n "$cover_file" ]; then
                unzip -p "$file" "$cover_file" > "$thumb" 2>/dev/null
            fi
        fi

        if [ -f "$thumb" ] && [ -s "$thumb" ]; then
            if [ "$TERM" = "xterm-kitty" ] || [ -n "${KITTY_WINDOW_ID:-}" ] || [ "${TERM_PROGRAM:-}" = "ghostty" ] || [ -n "${GHOSTTY_RESOURCES_DIR:-}" ]; then
                chafa --format kitty -s "${calc_width}x${calc_height}" --animate false "$thumb"
                exit 0
            elif [ "$TERM" = "foot" ] || [ "$TERM" = "foot-extra" ]; then
                chafa --format sixels -s "${calc_width}x${calc_height}" --animate false "$thumb"
                exit 0
            elif command -v chafa >/dev/null 2>&1; then
                chafa --format symbols --symbols sextant+quad+half+block --color-space din99d -s "${calc_width}x${calc_height}" --animate false "$thumb"
                exit 0
            fi
        elif command -v mediainfo >/dev/null 2>&1; then
            mediainfo "$file"
            exit 0
        fi
        ;;

    # --------------------------------------------------------------------------
    # Audio
    # --------------------------------------------------------------------------
    audio/*)
        if command -v mediainfo >/dev/null 2>&1; then
            mediainfo "$file"
            exit 0
        elif command -v ffprobe >/dev/null 2>&1; then
            ffprobe -hide_banner "$file" 2>&1 | head -n "$height"
            exit 0
        fi
        ;;

    # --------------------------------------------------------------------------
    # Archives & Compressed files
    # --------------------------------------------------------------------------
    application/x-7z-compressed|application/zip|application/x-tar|application/x-rar|application/gzip|application/x-xz|application/zstd)
        target="$file"
        if echo "$file" | grep -qE "\.[0-9]{3}$"; then
            base="${file%.*}"
            [ -f "${base}.001" ] && target="${base}.001"
        fi

        if command -v 7z >/dev/null 2>&1; then
            7z l "$target" 2>/dev/null | head -n "$height"
            exit 0
        elif command -v tar >/dev/null 2>&1; then
            tar -tvf "$target" 2>/dev/null | head -n "$height"
            exit 0
        elif command -v unzip >/dev/null 2>&1; then
            unzip -l "$target" 2>/dev/null | head -n "$height"
            exit 0
        fi
        ;;

    # --------------------------------------------------------------------------
    # JSON / Structured Data
    # --------------------------------------------------------------------------
    application/json)
        if command -v jq >/dev/null 2>&1; then
            jq -C . "$file" 2>/dev/null | head -n "$height"
            exit 0
        fi
        ;;

    # --------------------------------------------------------------------------
    # Text / Code / Markdown
    # --------------------------------------------------------------------------
    text/*|*/xml|application/javascript|application/x-subrip|inode/x-empty)
        if command -v bat >/dev/null 2>&1; then
            bat -p --color=always --theme=ansi --terminal-width="$(($width - 2))" --line-range=":$height" "$file"
            exit 0
        else
            head -n "$height" "$file"
            exit 0
        fi
        ;;
esac

# ------------------------------------------------------------------------------
# 3. FALLBACK
# ------------------------------------------------------------------------------
if command -v bat >/dev/null 2>&1; then
    bat -p --color=always --theme=ansi --terminal-width="$(($width - 2))" --line-range=":$height" "$file" 2>/dev/null && exit 0
fi

head -n "$height" "$file" 2>/dev/null || file -b "$file"
exit 0
